  for(let i=0;i<nr;i++){o+=4;const lc=dv.getUint32(o,true);o+=4;const loops=[];for(let j=0;j<lc;j++){const n=dv.getUint32(o,true);o+=4;const ix=[];for(let k=0;k<n;k++){ix.push(dv.getUint32(o,true));o+=4}loops.push(ix)}R.push(loops)}
  const r2=v=>+v.toFixed(2),C=(p0,c1,c2,p1)=>`C${r2(c1[0])} ${r2(c1[1])} ${r2(c2[0])} ${r2(c2[1])} ${r2(p1[0])} ${r2(p1[1])}`;
  const seg=(sg,rev)=>{const A=V[rev?sg.b:sg.a],B=V[rev?sg.a:sg.b],ta=rev?sg.te:sg.ts,tb=rev?sg.ts:sg.te;return{A,B,s:C(A,[A[0]+ta[0],A[1]+ta[1]],[B[0]+tb[0],B[1]+tb[1]],B),end:rev?sg.a:sg.b}};
  // the fill follows the network's fill regions; the stroke follows its segments, as open lines (a region would add a closing edge the stroke must not have)
  let dReg='',dSeg='';
  R.forEach(loops=>loops.forEach(ix=>{
    let cur=-1,first=true;
    ix.forEach((si,k)=>{const sg=S[si];if(!sg)return;
      let rev;if(first){const nx=S[ix[(k+1)%ix.length]];rev=ix.length>1&&nx?!(sg.b===nx.a||sg.b===nx.b):false}else rev=sg.a!==cur&&sg.b===cur;
      const q=seg(sg,rev);if(first){dReg+=`M${r2(q.A[0])} ${r2(q.A[1])}`;first=false}dReg+=q.s;cur=q.end});
    dReg+='Z'}));
