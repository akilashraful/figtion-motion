    const arc=o.type==='ELLIPSE'&&n.arcData&&(n.arcData.innerRadius>0||Math.abs(Math.abs((n.arcData.endingAngle||0)-(n.arcData.startingAngle||0))-2*Math.PI)>1e-3);
    const isVec=/^(VECTOR|BOOLEAN_OPERATION|POLYGON|LINE|STAR)$/.test(o.type)||arc||(!e.kids.length&&(fd||sdd)&&o.type!=='RECTANGLE'&&o.type!=='ELLIPSE');
