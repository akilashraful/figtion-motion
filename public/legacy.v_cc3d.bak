}
function importImageFile(file){
  const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const m=Math.min(1,600/Math.max(im.width,im.height)),l=addLayer('image',{src:r.result,w:Math.round(im.width*m),h:Math.round(im.height*m),name:'Pasted image'});imgs[l.id]=im;drawAll();toast('Pasted image')};im.src=r.result};r.readAsDataURL(file);
}
function writeSystemClip(){
  try{
    if(!navigator.clipboard||!window.ClipboardItem)return;
    const json=JSON.stringify({format:'figtion-clip',version:2,clip,frames:clipFrames,bounds:clipBounds});
    const items={'text/plain':new Blob([json],{type:'text/plain'})};
    try{items['web '+JITTER_MIME]=new Blob([json],{type:JITTER_MIME})}catch(e){}
    navigator.clipboard.write([new ClipboardItem(items)]).catch(()=>navigator.clipboard.writeText(json).catch(()=>{}));
  }catch(e){}
}
// ---------- Figma's own clipboard (⌘C in Figma): a "fig-kiwi" archive inside the HTML ----------
