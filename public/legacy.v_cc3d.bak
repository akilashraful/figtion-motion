    for(let j=0;j<fc;j++)fields.push({name:b.string(),type:b.varint(),array:!!b.byte(),value:b.varuint()});
    defs.push({name,kind,fields})}
  const T=['bool','byte','int','uint','float','string','int64','uint64'];
  defs.forEach(d=>d.fields.forEach(f=>{f.t=f.type<0?T[~f.type]:defs[f.type]}));
