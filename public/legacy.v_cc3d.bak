    if(t.kind===1){const o={};t.fields.forEach(f=>o[f.name]=field(f));return o}
    const o={};for(;;){const id=b.varuint();if(!id)return o;const f=t.fields.find(x=>x.value===id);if(!f)throw new Error('kiwi field');o[f.name]=field(f)}
