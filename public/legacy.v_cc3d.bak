        if(body){o.svg=`<svg xmlns="http://www.w3.org/2000/svg" width="${Math.max(w,1)}" height="${Math.max(h,1)}" viewBox="0 0 ${Math.max(w,1)} ${Math.max(h,1)}">${defs?`<defs>${defs}</defs>`:''}${wrap(body)}</svg>`;o.svgNodeSpace=true;return o}
