// Figma's ⌘C holds no picture data, only each picture's hash. With a personal access token (kept in this browser only) the file's pictures can be fetched by hash.
const figToken=()=>{try{return localStorage.getItem('fg_token')||''}catch(e){return''}};
async function resolveFigmaImages(nodes,meta){
  const tok=figToken(),key=meta&&meta.fileKey,need=[];
  (function walk(ns){(ns||[]).forEach(n=>{if(n.imageHash&&!n.imageUrl)need.push(n);if(n.children)walk(n.children)})})(nodes);
  if(!need.length||!tok||!key)return;
  try{
    const r=await fetch('https://api.figma.com/v1/files/'+key+'/images',{headers:{'X-Figma-Token':tok}});
    if(r.status===401||r.status===403){toast('Figma refused that access token — Actions → Connect Figma pictures');return}
    const map=((await r.json()).meta||{}).images||{};need.forEach(n=>{if(map[n.imageHash])n.imageUrl=map[n.imageHash]});
  }catch(e){}
}
// diagnostics: what the last ⌘V from Figma really contained, saved as a small JSON file (nothing is sent anywhere)
function saveFigmaPasteReport(){
  const msg=window.__lastFigmaMsg;if(!msg){toast('Paste something from Figma first');return}
  const gk=g=>g&&g.sessionID+':'+g.localID,cut=(v,d=0)=>{
    if(v==null||typeof v!=='object')return v;
    if(v instanceof Uint8Array||(Array.isArray(v.bytes)&&v.bytes.length>64))return'[bytes '+(v.length||v.bytes.length)+']';
    if(Array.isArray(v))return v.length>12?[...v.slice(0,12).map(x=>cut(x,d+1)),'… '+v.length+' items']:v.map(x=>cut(x,d+1));
    if(d>5)return'{…}';const o={};Object.keys(v).forEach(k=>{o[k]=cut(v[k],d+1)});return o};
  const keep=['guid','type','name','visible','opacity','size','transform','parentIndex','mask','maskType','fillPaints','strokePaints','strokeWeight','strokeAlign','strokeCap','strokeJoin','dashPattern','borderStrokeWeightsIndependent','borderTopWeight','borderBottomWeight','borderLeftWeight','borderRightWeight','effects','blendMode','cornerRadius','rectangleTopLeftCornerRadius','frameMaskDisabled','fillGeometry','strokeGeometry','vectorData','symbolData','arcData','fontSize','fontName','textData','textDecoration','count','starInnerScale'];
  const nodes=(msg.nodeChanges||[]).slice(0,1500).map(n=>{const o={};keep.forEach(k=>{if(n[k]!==undefined)o[k]=cut(n[k])});if(n.guid)o.id=gk(n.guid);return o});
  const rep={app:'Figtion',when:new Date().toISOString(),meta:cut(msg._meta||{}),nodeCount:(msg.nodeChanges||[]).length,blobs:(msg.blobs||[]).length,nodes};
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(rep,null,1)],{type:'application/json'}));a.download='figtion-paste-report.json';a.click();
  toast('Saved figtion-paste-report.json');
}
function connectFigmaPictures(){
  const cur=figToken(),v=prompt('Figma personal access token (Figma → Settings → Security). It stays in this browser and is only sent to api.figma.com, so pictures can be fetched when you paste.\n\nLeave empty to remove it.',cur?'':'');
  if(v==null)return;try{if(v.trim())localStorage.setItem('fg_token',v.trim());else localStorage.removeItem('fg_token')}catch(e){}
  toast(v.trim()?'Figma token saved — paste again to bring pictures':'Figma token removed');
}
// pictures that Figma links by address: shown as soon as they load (their server sends no CORS header)
function loadFigmaImages(layers){
  const todo=layers.filter(l=>l._imgUrl);if(!todo.length)return;
  let tainted=false;
  Promise.all(todo.map(l=>new Promise(done=>{
    const url=l._imgUrl;delete l._imgUrl;
    const show=(src,tn)=>{const im=new Image();im.onload=()=>{l.type='image';l.src=src;imgs[l.id]=im;srcStore[l.id]=src;l.strokeW=l.strokeW||0;if(tn)tainted=true;done()};im.onerror=()=>done();im.src=src};
    fetch(url,{mode:'cors'}).then(r=>r.blob()).then(b=>{const fr=new FileReader();fr.onload=()=>show(fr.result,false);fr.readAsDataURL(b)}).catch(()=>show(url,true));
  }))).then(()=>{drawAll();commitSoon();if(tainted)toast('Images are linked from Figma — they show here, but exporting a video may be blocked by the browser')});
}
function pasteImport(r){
  if(!r)return false;
  if(r.frames){
    const made=[];let last=fi;
    r.items.forEach((fr,i)=>{
      const f={id:Date.now()+i,name:fr.name,duration:4,bg:fr.bg,w:Math.max(16,Math.min(8000,Math.round(fr.bounds.w))),h:Math.max(16,Math.min(8000,Math.round(fr.bounds.h))),layers:[]};
      const keep=scene,sw=W,sh=H;scene=f;W=f.w;H=f.h;placeLayers(fr.layers,fr.bounds,{fitWhole:true});f.layers=fr.layers;scene=keep;W=sw;H=sh;
      project.frames.splice(fi+1+i,0,f);last=fi+1+i;made.push(f);
    });
    switchFrame(last);toast(`Pasted ${made.length} frame${made.length>1?'s':''} from Figma`+(r.missingImages?` — ${r.missingImages} picture${r.missingImages>1?'s':''} can\'t travel through ⌘V — use the Figtion plugin, or Actions → Connect Figma pictures`:''));made.forEach(f=>{ensureWebFonts(f.layers);loadFigmaImages(f.layers)});
  }else{
    const roots=placeLayers(r.layers,r.bounds,{noScale:true});scene.layers.push(...r.layers);ensureWebFonts(r.layers);loadFigmaImages(r.layers);
    selSet=new Set(roots);sel=roots[roots.length-1];selKey=null;refresh();toast(`Pasted ${r.layers.filter(l=>l.type!=='group').length} layer${r.layers.length>1?'s':''} from ${r.from||'Figma'}`+(r.missingImages?` — ${r.missingImages} picture${r.missingImages>1?'s':''} can\'t travel through ⌘V — use the Figtion plugin, or Actions → Connect Figma pictures`:''));
  }
  return true;
}
// what the clipboard holds -> layers
const JITTER_MIME='application/vnd.jitter+json';
function importText(text){
  const t=String(text||'').trim();if(!t)return false;
  if(t[0]==='<'&&/<svg[\s>]/i.test(t)){const r=svgToItems(t);if(r){r.from='SVG';return pasteImport(r)}return false}
  if(t[0]==='{'||t[0]==='['){
    let o;try{o=JSON.parse(t)}catch(e){return false}
    if(o&&o.format==='figtion-clip'&&(Array.isArray(o.clip)||Array.isArray(o.frames))){clip=o.clip||[];clipFrames=o.frames||[];clipBounds=o.bounds||null;pasteN=0;pasteNodes(false);return true}
    if(o&&(o.format==='figtion-figma'||o.document||o.type&&/^[A-Z_]+$/.test(o.type)||Array.isArray(o)&&o[0]&&o[0].type)){
      const node=o.document||o,r=figToItems(o.format==='figtion-figma'?o:o.document?[o.document]:node);return r?pasteImport(r):false}
    if(o&&o.meta&&o.nodes){toast('That is Jitter’s private clip format — use the Figtion Figma plugin to copy from Figma');return true}
  }
