// ---------- engine: value of a property at time t, and a pure render(time) ----------
function valueAt(l,p,time){
  const ks=l.tracks[p];
  if(!ks||!ks.length)return l[p];
  if(time<=ks[0].t)return ks[0].v;
  const last=ks[ks.length-1];
  if(time>=last.t)return last.v;
  for(let i=0;i<ks.length-1;i++){
    const a=ks[i],b=ks[i+1];
    if(time>=a.t&&time<=b.t)return a.v+(b.v-a.v)*ease(b.ease||'easeInOut',b.ei,(time-a.t)/(b.t-a.t));
  }
}
function state(l,time){const s={};PROPS.forEach(p=>s[p]=valueAt(l,p,time));return s}

const DIRS={up:[0,-1],down:[0,1],left:[-1,0],right:[1,0]};
const PA=(k,label,kind,def,o={})=>({k,label,kind,def,...o});
// ---------- easing: named curves with an intensity (0-100) ----------
const lerp=(a,b,t)=>a+(b-a)*t,clamp01=v=>v<0?0:v>1?1:v;
function bezier(x1,y1,x2,y2){
  return t=>{
    if(t<=0)return 0;if(t>=1)return 1;
    let lo=0,hi=1,u=t;
    for(let i=0;i<24;i++){const x=3*(1-u)*(1-u)*u*x1+3*(1-u)*u*u*x2+u*u*u;if(Math.abs(x-t)<1e-5)break;if(x<t)lo=u;else hi=u;u=(lo+hi)/2}
    return 3*(1-u)*(1-u)*u*y1+3*(1-u)*u*u*y2+u*u*u;
  };
}
const bzCache={},bzOf=n=>bzCache[n]||(bzCache[n]=bezier(...n.slice(3).split(',').map(Number)));
const PE={
  smooth:(t,i)=>{const p=1+2.5*i;return t<.5?.5*Math.pow(2*t,p):1-.5*Math.pow(2*(1-t),p)},
  natural:(t,i)=>bezier(lerp(.333,.25,i),lerp(.333,.1,i),lerp(.667,.25,i),lerp(.667,1,i))(t),
  slowDown:(t,i)=>1-Math.pow(1-t,1+3*i),
  accelerate:(t,i)=>Math.pow(t,1+3*i),
  elastic:(t,i)=>1-Math.pow(2,-10*t)*Math.cos(t*10*(2*Math.PI/(3.4-2*i))),
  bounceP:(t,i)=>{
    const e=.3+.5*i,T0=1/(1+2*(e+e*e+e*e*e));
    if(t<T0){const u=t/T0;return u*u}
    let s=T0;
    for(let k=1;k<=3;k++){const dur=2*Math.pow(e,k)*T0;if(t<s+dur){const x=(t-s)/dur;return 1-Math.pow(e,2*k)*4*x*(1-x)}s+=dur}
    return 1;
  },
  overshoot:(t,i)=>{const c=1.70158*2*i+.0001;return 1+(c+1)*Math.pow(t-1,3)+c*Math.pow(t-1,2)},
  impulse:(t,i)=>{const k=6+14*i;return(1-Math.pow(2,-k*t))/(1-Math.pow(2,-k))},
  swing:(t,i)=>{const c=1.70158*1.525*2*i+.0001;return t<.5?(Math.pow(2*t,2)*((c+1)*2*t-c))/2:(Math.pow(2*t-2,2)*((c+1)*(t*2-2)+c)+2)/2}
};

// ---- Jitter's standard easings: control-point paths whose handles are blended by the intensity (0-100)
// every point is [x, y, upper handle, lower handle]; a handle is a number (horizontal, flat) or {x,y}, both scaled by the neighbouring segment's width
const PATHS={
  smooth:{0:[[0,0,.3],[1,1,,1]],50:[[0,0,.5],[1,1,,1]],100:[[0,0,.9],[1,1,,1]]},
  natural:{0:[[0,0,.5],[1,1,,.5]],50:[[0,0,.8],[1,1,,.8]],100:[[0,0,1],[1,1,,1]]},
  slowDown:{0:[[0,0,0],[1,1,,.7]],50:[[0,0,0],[1,1,,1]],100:[[0,0,{x:0,y:.9}],[1,1,,1]]},
  accelerate:{0:[[0,0,.7],[1,1,,0]],50:[[0,0,1],[1,1,,0]],100:[[0,0,1],[1,1,,{x:0,y:.9}]]},
  overshoot:{0:[[0,0,0],[.46,1.05,.2,.8],[1,1,,.7]],50:[[0,0,0],[.25,1.2,.2,.8],[1,1,,.75]],100:[[0,0,0],[.15,2,.1,.8],[1,1,,.8]]},
  impulse:{0:[[0,0,.3],[.17,-.05,.25,.25],[1,1,,.7]],50:[[0,0,.35],[.3,-.2,.25,.25],[1,1,,.8]],100:[[0,0,.5],[.47,-1,.25,.25],[1,1,,1]]}
};
const pathEaseCache={};
function pathEase(name,i){
  const cfg=PATHS[name],I=Math.max(0,Math.min(100,i*100)),ck=name+'|'+I.toFixed(3);
  let fn=pathEaseCache[ck];
  if(!fn){
    const keys=Object.keys(cfg).map(Number).sort((a,b)=>a-b);
    const near=keys.reduce((b,k)=>Math.abs(k-I)<Math.abs(b-I)?k:b);
    let pair=[near,near];const ix=keys.indexOf(near);
    if(near<I)pair=[near,keys[ix+1]];else if(near>I)pair=[keys[ix-1],near];else pair=ix===0?[near,keys[ix+1]]:[keys[ix-1],near];
    const k=(I-pair[0])/(pair[1]-pair[0]),A=cfg[pair[0]],B=cfg[pair[1]];
    const hv=h=>h==null?{x:0,y:0}:typeof h==='number'?{x:h,y:0}:h,mix=(a,b)=>a+(b-a)*k;
    const pts=A.map((a,n)=>{const b=B[n],up=[hv(a[2]),hv(b[2])],lo=[hv(a[3]),hv(b[3])];
      return{x:mix(a[0],b[0]),y:mix(a[1],b[1]),up:{x:mix(up[0].x,up[1].x),y:mix(up[0].y,up[1].y)},lo:{x:mix(lo[0].x,lo[1].x),y:mix(lo[0].y,lo[1].y)}}});
    const segs=[];
    for(let n=1;n<pts.length;n++){
      const P0=pts[n-1],P1=pts[n],dx=P1.x-P0.x,dy=P1.y-P0.y;
      segs.push(dx&&dy?bezier(P0.up.x*dx/dx,P0.up.y*dx/dy,1+P1.lo.x*(-dx)/dx,1+P1.lo.y*(-dx)/dy):null);
    }
    fn=x=>{
      for(let n=1;n<pts.length;n++){
        const P0=pts[n-1],P1=pts[n];
        if(x===P0.x)return P0.y;
        if(x<P1.x||n===pts.length-1&&x<=P1.x){const sg=segs[n-1];if(!sg)return P0.y;return P0.y+(P1.y-P0.y)*sg((x-P0.x)/(P1.x-P0.x))}
      }
      return pts[pts.length-1].y;
    };
    pathEaseCache[ck]=fn;
  }
  return fn;
}
Object.keys(PATHS).forEach(n=>{PE[n]=(t,i)=>pathEase(n,i)(t)});
function ease(name,i,u){
  if(u<=0)return 0;if(u>=1)return 1;
  if(typeof name==='string'&&name.charCodeAt(0)===98&&name.startsWith('bz:'))return bzOf(name)(u);   // custom cubic-bezier: 'bz:x1,y1,x2,y2'
  const f=PE[name];if(f)return f(u,(i==null?50:i)/100);
  return(EASE[name]||EASE.easeInOut)(u);
}

// ---------- text layout ----------
const mctx=document.createElement('canvas').getContext('2d');
function setFont(c,l,fs,st){
  c.font=`${l.italic?'italic ':''}${l.weight} ${Math.max(1,fs)}px ${l.font}`;
  if('letterSpacing' in c)c.letterSpacing=((st&&st.ls!=null?st.ls:l.ls)*fs/100)+'px';
  if('fontKerning' in c)c.fontKerning=l.kern?'normal':'none';
  if('textRendering' in c)c.textRendering=l.liga?'auto':'optimizeSpeed';
}
const lhCache={};
function naturalLH(l){   // the font's own line height, as a % of the size
  const key=(l.italic?'i':'')+l.weight+'|'+l.font;if(lhCache[key]!=null)return lhCache[key];
  let v=120;try{const m=mctx.measureText('Hg');mctx.font=`${l.italic?'italic ':''}${l.weight} 100px ${l.font}`;const q=mctx.measureText('Hg');if(q.fontBoundingBoxAscent!=null)v=Math.round(q.fontBoundingBoxAscent+q.fontBoundingBoxDescent)}catch(e){}
  return lhCache[key]=Math.max(80,v);
}
// number fields that take a little arithmetic: 20*2, +10, /2, 50%, 120-8 …
function evalNum(str,cur,allowNeg){
  let s=String(str).trim().toLowerCase().replace(/,/g,'.').replace(/×/g,'*').replace(/÷/g,'/').replace(/−/g,'-').replace(/\s+/g,'');
  if(!s)return null;
  s=s.replace(/(\d+(?:\.\d+)?|\.\d+)%/g,(m,n)=>'('+cur+'*'+n+'/100)');
  if(!/^[0-9+\-*/().]+$/.test(s))return null;
  if(/^[+*/]/.test(s)||(!allowNeg&&/^-/.test(s)))s='('+cur+')'+s;   // a leading operator works on the current value
  try{const v=Function('"use strict";return ('+s+')')();return typeof v==='number'&&isFinite(v)?v:null}catch(e){return null}
}
const caseText=(l,x)=>l.tcase==='upper'?x.toUpperCase():l.tcase==='lower'?x.toLowerCase():l.tcase==='title'?x.toLowerCase().replace(/(^|[\s\-_/])(\S)/g,(m,a,b)=>a+b.toUpperCase()):x;
const counterStr=(l,n)=>{const c=l.counter||{};return(c.prefix||'')+(Number(n)||0).toFixed(Math.max(0,c.dec||0))+(c.suffix||'')};
function textLayout(l,fs,w,txt,st){
  fs=Math.max(1,fs);setFont(mctx,l,fs,st);
  const wrap=l.autoResize!=='width',lines=[];
  caseText(l,String(txt!=null?txt:l.text)).split('\n').forEach(par=>{
    if(!wrap){lines.push(par);return}
    let cur='';
    par.split(' ').forEach(wd=>{const test=cur?cur+' '+wd:wd;if(cur&&mctx.measureText(test).width>w){lines.push(cur);cur=wd}else cur=test});
    lines.push(cur);
  });
  const lh=l.lhPx!=null&&!l.lhAuto?Math.max(0,l.lhPx):fs*(l.lhAuto?naturalLH(l):(st&&st.lh!=null?st.lh:l.lh))/100;   // pixels (l.lhPx) or a percentage of the size
  if(l.truncate&&wrap){   // Figma's "Truncate text": cut at the box height (fixed size) or at Max lines, ending the last line with …
    let cap=Infinity;
    if(l.autoResize==='fixed')cap=Math.max(1,Math.floor(l.bh/lh+1e-6));
    if(l.maxLines>0)cap=Math.min(cap,Math.round(l.maxLines));
    if(lines.length>cap){lines.length=cap;let last=lines[cap-1];while(last.length&&mctx.measureText(last+'\u2026').width>w)last=last.slice(0,-1).trimEnd();lines[cap-1]=last+'\u2026'}
  }
  const th=lines.length*lh;
  const width=wrap?Math.max(1,w):Math.max(1,...lines.map(x=>mctx.measureText(x).width));
  return{lines,lh,th,width,height:l.autoResize==='fixed'?l.bh:th};
}
const textFor=(l,s)=>l.counter?counterStr(l,s.num):(s.tsw>=0.5&&l.swaps&&l.swaps.length?l.swaps[Math.min(l.swaps.length,Math.round(s.tsw))-1]:null);
function boxSize(l,s){
  if(l.type!=='text')return{w:s.w,h:s.h};
  const lay=textLayout(l,s.h,s.w,textFor(l,s),s);return{w:lay.width,h:lay.height,lay};
}
function fitText(l){if(l.type==='text'&&l.autoResize==='width')l.w=Math.round(textLayout(l,l.h,l.w).width)}
const rgba=(hex,a)=>{const n=parseInt(hex.slice(1),16);return `rgba(${n>>16&255},${n>>8&255},${n&255},${a})`};

// ---------- timed segments (shader transitions, per-letter text animations) ----------
function segVis(g,time){
  const e=ease(g.ease,g.ei,clamp01((time-g.start)/g.dur));
  return g.mode==='in'?e:1-e;
}
function pickSeg(list,time){
  if(!list||!list.length)return null;
  for(const g of list)if(time>=g.start&&time<=g.start+g.dur)return g;
  const past=list.filter(g=>g.start+g.dur<time).sort((a,b)=>(b.start+b.dur)-(a.start+a.dur))[0];
  return past||[...list].sort((a,b)=>a.start-b.start)[0];
}

// ---------- shader-style effects (software, on an offscreen copy of the layer) ----------
const POOL=[0,1,2].map(()=>{const c=document.createElement('canvas');c.getContext('2d',{willReadFrequently:true});return c});
const SCR=document.createElement('canvas');SCR.getContext('2d',{willReadFrequently:true});
function cvFor(i,w,h){const c=POOL[i];if(c.width!==w||c.height!==h){c.width=w;c.height=h}else c.getContext('2d').clearRect(0,0,w,h);return c}
function freeCv(src,w,h){for(let i=0;i<3;i++)if(POOL[i]!==src)return cvFor(i,w,h)}
function scratch(w,h){if(SCR.width!==w||SCR.height!==h){SCR.width=w;SCR.height=h}else SCR.getContext('2d').clearRect(0,0,w,h);return SCR}
const hash=(x,y,s)=>{const h=Math.sin(x*127.1+y*311.7+s*74.7)*43758.5453;return h-Math.floor(h)};
function vnoise(x,y,s){const xi=Math.floor(x),yi=Math.floor(y),xf=x-xi,yf=y-yi,u=xf*xf*(3-2*xf),v=yf*yf*(3-2*yf);
  return lerp(lerp(hash(xi,yi,s),hash(xi+1,yi,s),u),lerp(hash(xi,yi+1,s),hash(xi+1,yi+1,s),u),v)}
const fbm=(x,y,s)=>(vnoise(x,y,s)*.5+vnoise(x*2,y*2,s)*.25+vnoise(x*4,y*4,s)*.125)/.875;
const hex3=h=>{const n=parseInt(String(h).slice(1),16)||0;return[n>>16&255,n>>8&255,n&255]};
const lumaOf=(r,g,b)=>(0.299*r+0.587*g+0.114*b)/255;
function mapPx(I,fn){
  const{w,h}=I,d=I.src.getContext('2d').getImageData(0,0,w,h),D=d.data;
  for(let p=0,i=0;p<D.length;p+=4,i++)fn(D,p,i%w,(i/w)|0);
  const out=freeCv(I.src,w,h);out.getContext('2d').putImageData(d,0,0);return out;
}
// move every pixel to a new source position (bilinear, alpha-weighted)
function warp(I,fn){
  const{w,h}=I,S=I.src.getContext('2d').getImageData(0,0,w,h).data;
  const out=freeCv(I.src,w,h),o=out.getContext('2d'),od=o.createImageData(w,h),D=od.data,pt=[0,0];
  for(let y=0;y<h;y++)for(let x=0;x<w;x++){
    fn(x,y,pt);const sx=pt[0],sy=pt[1],x0=Math.floor(sx),y0=Math.floor(sy);
    if(x0<-1||y0<-1||x0>=w||y0>=h)continue;
    const fx=sx-x0,fy=sy-y0;let R=0,G=0,B=0,A=0;
    for(let j=0;j<2;j++)for(let i=0;i<2;i++){
      const xx=x0+i,yy=y0+j;if(xx<0||yy<0||xx>=w||yy>=h)continue;
      const p=(yy*w+xx)*4,a=S[p+3]/255*(i?fx:1-fx)*(j?fy:1-fy);R+=S[p]*a;G+=S[p+1]*a;B+=S[p+2]*a;A+=a;
    }
    if(A>0){const q=(y*w+x)*4;D[q]=R/A;D[q+1]=G/A;D[q+2]=B/A;D[q+3]=A*255}
  }
  o.putImageData(od,0,0);return out;
}
function fadeTo(I,src,a){
  if(a>=1)return src;
  const out=freeCv(src,I.w,I.h),o=out.getContext('2d');o.globalAlpha=Math.max(0,a);o.drawImage(src,0,0);o.globalAlpha=1;return out;
}
const BAYER=[0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5];
const vec4=d=>DIRS[d]||DIRS.right;
// cores shared by a static effect and its transition twin
function barrelCore(I,k){
  const cx=I.w/2,cy=I.h/2;
  return warp(I,(x,y,pt)=>{const nx=(x-cx)/cx,ny=(y-cy)/cy,f=1+k*(nx*nx+ny*ny);pt[0]=cx+(x-cx)*f;pt[1]=cy+(y-cy)*f});
}
function fluidCore(I,amt){
  const t=I.time,r=I.rs;
  return warp(I,(x,y,pt)=>{pt[0]=x+Math.sin(y/(55*r)+t*2.2)*amt*r+Math.sin((x+y)/(90*r)-t*1.3)*amt*r*.5;pt[1]=y+Math.cos(x/(70*r)+t*1.7)*amt*r});
}
function copiesCore(I,n,place,alphaOf){
  const out=freeCv(I.src,I.w,I.h),o=out.getContext('2d');
  for(let i=n;i>=1;i--){o.save();o.globalAlpha=alphaOf(i);place(o,i);o.drawImage(I.src,0,0);o.restore()}
  o.globalAlpha=1;o.drawImage(I.src,0,0);return out;
}
const trailCore=(I,dist,reps,spread,fade,dir)=>{
  const v=vec4(dir);
  return copiesCore(I,reps,(o,i)=>{const f=Math.pow(i/reps,1+spread*2);o.translate(-v[0]*dist*I.rs*f,-v[1]*dist*I.rs*f)},i=>fade?(1-i/(reps+1))*0.7:0.45);
};
const echoCore=(I,n,step,fade,inward)=>copiesCore(I,n,(o,i)=>{const sc=1+(inward?-1:1)*i*step/100;o.translate(I.w/2,I.h/2);o.scale(sc,sc);o.translate(-I.w/2,-I.h/2)},i=>fade?(1-i/(n+1))*0.6:0.4);
const SELO=(o)=>o; // placeholder for readability
const sstep=(a,b,x)=>{const t=clamp01((x-a)/((b-a)||1e-6));return t*t*(3-2*t)};
// keep the warped result inside the layer's original silhouette
function containTo(I,warped){
  const out=freeCv(warped,I.w,I.h),o=out.getContext('2d');o.drawImage(warped,0,0);o.globalCompositeOperation='destination-in';o.drawImage(I.src,0,0);o.globalCompositeOperation='source-over';return out;
}
const GRIDP=[PA('repeatX','Repeat X','num',5,{min:1,max:32,step:1}),PA('repeatY','Repeat Y','num',5,{min:1,max:32,step:1}),PA('gapX','Gap X','num',60,{min:0,max:400}),PA('gapY','Gap Y','num',60,{min:0,max:400}),PA('baseSpeed','Base Speed','num',.25,{min:-4,max:4,step:.05}),PA('speedVariation','Speed Variation','num',.5,{min:0,max:2,step:.05}),PA('lineOffset','Line Offset','num',.5,{min:0,max:1,step:.01}),PA('scaleFactor','Scale Factor','num',1,{min:.1,max:1,step:.01})];
// the layer is tiled into a grid and each row (or column) scrolls at its own speed
function gridScroll(I,axis){
  const P=I.p,nx=Math.round(P.repeatX),ny=Math.round(P.repeatY),gx=P.gapX*I.rs*.2,gy=P.gapY*I.rs*.2,out=freeCv(I.src,I.w,I.h),o=out.getContext('2d');
  const cw=Math.max(2,(I.w-gx*(nx-1))/nx),ch=Math.max(2,(I.h-gy*(ny-1))/ny),sw=cw*P.scaleFactor,sh=ch*P.scaleFactor;
  const lines=axis==='x'?ny:nx,period=axis==='x'?(cw+gx)*nx:(ch+gy)*ny;
  for(let k=0;k<lines;k++){
    const sp=P.baseSpeed*(1+(hash(k,3,1)-.5)*2*P.speedVariation),off=((I.time*sp*period/ (axis==='x'?nx:ny))+k*P.lineOffset*(axis==='x'?cw:ch))%period;
    const reps=axis==='x'?nx:ny;
    for(let m=-1;m<=reps;m++){
      const pos=m*(axis==='x'?cw+gx:ch+gy)+off;
      const x=axis==='x'?pos:k*(cw+gx),y=axis==='x'?k*(ch+gy):pos;
      o.drawImage(I.src,x+(cw-sw)/2,y+(ch-sh)/2,sw,sh);
    }
  }
  return out;
}
// a flat card turned in 3D: width/height shrink with the cosine of the angle, and the back can be hidden or shown
function flip3d(I,rx,ry,rz,persp,showF,showB,pvx,pvy){
  const out=freeCv(I.src,I.w,I.h),o=out.getContext('2d'),A=ry*Math.PI/180,B=rx*Math.PI/180,cy=Math.cos(A),cx=Math.cos(B),front=cy*cx>=0;
  if(front?showF===false:showB===false)return out;
  const sy=Math.abs(cx),sx=Math.abs(cy);if(sx<.015||sy<.015)return out;
  const px=I.w/2+pvx*I.w/2,py=I.h/2+pvy*I.h/2,k=1+persp*.35*Math.sin(A)*(pvx||1)*0;
  o.translate(px,py);o.rotate(rz*Math.PI/180);
  o.transform(1,persp*.25*Math.sin(A)*.5*(cx>=0?1:-1),0,1,0,0);
  o.scale((front?1:-1)*sx*k,sy);o.translate(-I.w/2,-I.h/2);o.drawImage(I.src,0,0);
  o.setTransform(1,0,0,1,0,0);o.globalCompositeOperation='source-atop';o.fillStyle=`rgba(0,0,0,${(1-Math.min(sx,sy))*.45})`;o.fillRect(0,0,I.w,I.h);o.globalCompositeOperation='source-over';
  return out;
}
const FXLIB={
  // ---- layer effects (kept on the layer; parameters follow Jitter's effect library)
  pixelate:{label:'Pixelate',kind:'static',params:[PA('pixelSize','Pixel Size','num',18,{min:1,max:200}),PA('pixelSizeStep','Pixel Size Step','num',1,{min:1,max:50,step:1}),PA('noiseEnabled','Noise Enabled','bool',false),PA('noiseScale','Noise Scale','num',1,{min:.1,max:6,step:.1}),PA('noiseThreshold','Noise Threshold','num',.5,{min:0,max:1,step:.01})],
    apply(I){const st=Math.max(1,I.p.pixelSizeStep),sz=Math.max(1,Math.max(1,Math.round(I.p.pixelSize/st)*st)*I.rs),sw=Math.max(1,Math.round(I.w/sz)),sh=Math.max(1,Math.round(I.h/sz));
      const sc=scratch(sw,sh),s=sc.getContext('2d');s.imageSmoothingEnabled=true;s.drawImage(I.src,0,0,sw,sh);
      const out=freeCv(I.src,I.w,I.h),o=out.getContext('2d');o.imageSmoothingEnabled=false;o.drawImage(sc,0,0,sw,sh,0,0,I.w,I.h);
      if(!I.p.noiseEnabled)return out;
      const ns=I.p.noiseScale*.3,th=I.p.noiseThreshold;return mapPx({...I,src:out},(D,p,x,y)=>{if(fbm((x/sz|0)*ns,(y/sz|0)*ns,3)<th)D[p+3]=0})}},
  rgbshift:{label:'RGB Shift',kind:'static',params:[PA('amount','Amount','num',.25,{min:0,max:3,step:.01}),PA('direction','Direction','num',0,{min:-360,max:360}),PA('overflow','Overflow','bool',true)],
    pad:(p,b)=>p.amount*.05*Math.min(b.w,b.h),
    apply(I){const{w,h}=I,S=I.src.getContext('2d').getImageData(0,0,w,h).data,out=freeCv(I.src,w,h),o=out.getContext('2d'),od=o.createImageData(w,h),D=od.data;
      const a=I.p.direction*Math.PI/180,d=I.p.amount*.05*Math.min(I.bx.w,I.bx.h)*I.rs,dx=Math.round(Math.cos(a)*d),dy=Math.round(Math.sin(a)*d),ov=I.p.overflow!==false;
      const cl=(v,m)=>v<0?0:v>=m?m-1:v;
      for(let y=0;y<h;y++)for(let x=0;x<w;x++){
        const pr=(cl(y-dy,h)*w+cl(x-dx,w))*4,pb=(cl(y+dy,h)*w+cl(x+dx,w))*4,pg=(y*w+x)*4;
        D[pg]=S[pr];D[pg+1]=S[pg+1];D[pg+2]=S[pb+2];D[pg+3]=ov?Math.max(S[pr+3],S[pg+3],S[pb+3]):S[pg+3];
      }o.putImageData(od,0,0);return out}},
  duotone:{label:'Duotone',kind:'static',params:[PA('midpoint','Midpoint','num',.5,{min:0,max:1,step:.01}),PA('contrast','Contrast','num',.9,{min:0,max:4,step:.01}),PA('colorA','Shadow Color','color','#1400ff'),PA('colorB','Highlight Color','color','#ffe4e4')],
    apply(I){const a=hex3(I.p.colorA),b=hex3(I.p.colorB),t=Math.max(.0001,Math.min(.9999,I.p.midpoint)),ct=I.p.contrast;
      return mapPx(I,(D,p)=>{if(!D[p+3])return;const L=lumaOf(...[0,1,2].map(i=>Math.max(0,Math.min(255,((D[p+i]/255-.5)*ct+.5)*255)))),sh=L>=t?t+sstep(t,1,L)*(1-t):sstep(0,t,L)*t;
        D[p]=lerp(a[0],b[0],sh);D[p+1]=lerp(a[1],b[1],sh);D[p+2]=lerp(a[2],b[2],sh)})}},
  tritone:{label:'Tritone',kind:'static',params:[PA('threshold1','Threshold 1','num',.33,{min:0,max:1,step:.01}),PA('threshold2','Threshold 2','num',.66,{min:0,max:1,step:.01}),PA('softness','Softness','num',.35,{min:0,max:1,step:.01}),PA('contrast','Contrast','num',1,{min:0,max:4,step:.01}),PA('colorA','Shadow Color','color','#1a1033'),PA('colorB','Midtone Color','color','#e94f64'),PA('colorC','Highlight Color','color','#ffe9b0')],
    apply(I){const a=hex3(I.p.colorA),b=hex3(I.p.colorB),c=hex3(I.p.colorC),t1=Math.min(I.p.threshold1,I.p.threshold2),t2=Math.max(I.p.threshold1,I.p.threshold2),hw=Math.max(.0001,I.p.softness)/2,ct=I.p.contrast;
      return mapPx(I,(D,p)=>{if(!D[p+3])return;const L=lumaOf(...[0,1,2].map(i=>Math.max(0,Math.min(255,((D[p+i]/255-.5)*ct+.5)*255)))),wB=sstep(t1-hw,t1+hw,L),wC=sstep(t2-hw,t2+hw,L);
        for(let i=0;i<3;i++){const m=lerp(a[i],b[i],wB);D[p+i]=lerp(m,c[i],wC)}})}},
  threshold:{label:'Threshold Color',kind:'static',params:[PA('contrast','Contrast','num',1.25,{min:0,max:4,step:.01}),PA('fillColor','Default Color','color','#6f6645'),PA('threshold','Color Threshold','num',.5,{min:0,max:1,step:.01}),PA('softness','Softness','num',0,{min:0,max:1,step:.01}),PA('invertLuma','Invert Luma','bool',false)],
    apply(I){const f=hex3(I.p.fillColor),e0=I.p.threshold-I.p.softness/2,e1=I.p.threshold+I.p.softness/2;
      return mapPx(I,(D,p)=>{if(!D[p+3])return;let l=(D[p]*.2126+D[p+1]*.7152+D[p+2]*.0722)/255;l=Math.max(0,Math.min(1,(l-.5)*I.p.contrast+.5));let m=sstep(e0,e1,l);if(I.p.invertLuma)m=1-m;D[p]=f[0];D[p+1]=f[1];D[p+2]=f[2];D[p+3]*=m})}},
  colorgrade:{label:'Color Grade',kind:'static',params:[PA('exposure','Exposure','num',1,{min:0,max:4,step:.01}),PA('brightness','Brightness','num',1,{min:0,max:3,step:.01}),PA('contrast','Contrast','num',1,{min:0,max:3,step:.01}),PA('saturation','Saturation','num',1,{min:0,max:3,step:.01})],
    apply(I){const p=I.p;return mapPx(I,(D,q)=>{if(!D[q+3])return;const c=[0,1,2].map(i=>((D[q+i]/255*p.exposure*p.brightness)-.5)*p.contrast+.5),L=c[0]*.2126+c[1]*.7152+c[2]*.0722;
      for(let i=0;i<3;i++)D[q+i]=Math.max(0,Math.min(1,L+(c[i]-L)*p.saturation))*255})}},
  colorremove:{label:'Color Remover',kind:'static',params:[PA('targetColor','Target Color','color','#00ff00'),PA('range','Range','num',.18,{min:0,max:1,step:.01}),PA('softness','Softness','num',.18,{min:.001,max:1,step:.01})],
    apply(I){const k=hex3(I.p.targetColor),r=I.p.range,s=Math.max(.001,I.p.softness);return mapPx(I,(D,p)=>{const d=Math.sqrt(((D[p]-k[0])**2+(D[p+1]-k[1])**2+(D[p+2]-k[2])**2)/3)/255;D[p+3]*=sstep(r,r+s,d)})}},
  dither:{label:'Dithering',kind:'static',params:[PA('dark','Dark Color','color','#000000'),PA('light','Light Color','color','#ffffff'),PA('cell','Subdivisions','num',200,{min:4,max:400}),PA('contrast','Contrast','num',1.2,{min:.2,max:3,step:.01})],
    apply(I){const a=hex3(I.p.dark),b=hex3(I.p.light),cs=Math.max(1,I.h/Math.max(1,I.p.cell));
      return mapPx(I,(D,p,x,y)=>{if(!D[p+3])return;const th=(BAYER[((y/cs|0)%4)*4+((x/cs|0)%4)]+.5)/16,L=lumaOf(D[p],D[p+1],D[p+2]),adj=Math.max(0,Math.min(1,(L-.5)*I.p.contrast+.5)),c=adj>=th?b:a;D[p]=c[0];D[p+1]=c[1];D[p+2]=c[2]})}},
  dotgrid:{label:'Dot Grid',kind:'static',params:[PA('grid_repeat','Grid Repetition','num',40,{min:2,max:120}),PA('dot_scale','Dot Scale','num',4,{min:.05,max:10,step:.05}),PA('contrast','Contrast','num',1.4,{min:0,max:5,step:.05}),PA('shadow_color','Shadow Color','color','#ff0000'),PA('highlight_color','Highlight Color','color','#ff0000'),PA('invertDetection','Invert Detection','bool',false)],
    apply(I){const gw=Math.max(1,Math.round(I.p.grid_repeat)),gh=Math.max(1,Math.round(gw*I.h/I.w)),sc=scratch(gw,gh),s=sc.getContext('2d');s.imageSmoothingEnabled=true;s.drawImage(I.src,0,0,gw,gh);const D=s.getImageData(0,0,gw,gh).data;
      const out=freeCv(I.src,I.w,I.h),o=out.getContext('2d'),cw=I.w/gw,ch=I.h/gh,sh=hex3(I.p.shadow_color),hi=hex3(I.p.highlight_color);
      for(let j=0;j<gh;j++)for(let i=0;i<gw;i++){const p=(j*gw+i)*4,a=D[p+3]/255;if(a<.04)continue;
        let L=lumaOf(D[p]/a,D[p+1]/a,D[p+2]/a);if(I.p.invertDetection)L=1-L;L=Math.max(0,Math.min(1,(L-.5)*I.p.contrast+.5));
        const r=Math.min(cw,ch)/2*Math.min(1.6,I.p.dot_scale/4*L)*Math.sqrt(a);if(r<.3)continue;
        o.fillStyle=`rgb(${lerp(sh[0],hi[0],L)|0},${lerp(sh[1],hi[1],L)|0},${lerp(sh[2],hi[2],L)|0})`;o.beginPath();o.arc((i+.5)*cw,(j+.5)*ch,r,0,7);o.fill()}
      return out}},
  bulge:{label:'Bulge',kind:'static',params:[PA('amount','Amount','num',.6,{min:-1,max:1,step:.01}),PA('radius','Radius','num',.7,{min:.1,max:1.5,step:.01}),PA('cx','Center X','num',.5,{min:0,max:1,step:.01}),PA('cy','Center Y','num',.5,{min:0,max:1,step:.01})],
    apply(I){const P=I.p,cx=P.cx*I.w,cy=P.cy*I.h,R=Math.max(2,P.radius*Math.min(I.w,I.h)/2);
      return warp(I,(x,y,pt)=>{const dx=x-cx,dy=y-cy,d=Math.hypot(dx,dy)/R;if(d>=1){pt[0]=x;pt[1]=y;return}const f=1-P.amount*(1-d*d);pt[0]=cx+dx*f;pt[1]=cy+dy*f})}},
  displacement:{label:'Displacement',kind:'static',params:[PA('amplitudeX','Amplitude X','num',24,{min:0,max:300}),PA('amplitudeY','Amplitude Y','num',24,{min:0,max:300}),PA('frequency','Frequency','num',2,{min:.2,max:12,step:.1}),PA('speed','Speed','num',1,{min:0,max:6,step:.1}),PA('bulge','Bulge','num',0,{min:-1,max:1,step:.01})],
    pad:p=>Math.max(p.amplitudeX,p.amplitudeY),
    apply(I){const P=I.p,r=I.rs,t=I.time*P.speed*2,ax=P.amplitudeX*r,ay=P.amplitudeY*r,TW=6.2832,cx=I.w/2,cy=I.h/2,R=Math.min(I.w,I.h)/2;
      return warp(I,(x,y,pt)=>{let sx=x+Math.sin(y/I.h*TW*P.frequency+t)*ax,sy=y+Math.sin(x/I.w*TW*P.frequency+t*.8)*ay;
        if(P.bulge){const dx=x-cx,dy=y-cy,d=Math.hypot(dx,dy)/R;if(d<1){const f=1-P.bulge*(1-d*d)*.6;sx=cx+(sx-cx)*f;sy=cy+(sy-cy)*f}}
        pt[0]=sx;pt[1]=sy})}},
  ripple:{label:'Ripple',kind:'static',params:[PA('speed','Speed','num',.6,{min:-4,max:4,step:.05}),PA('strength','Strength','num',.18,{min:-1,max:1,step:.01}),PA('frequency','Frequency','num',8,{min:.1,max:40,step:.1}),PA('cx','Center X','num',.5,{min:-1,max:2,step:.01}),PA('cy','Center Y','num',.5,{min:-1,max:2,step:.01}),PA('falloff','Falloff','num',1.2,{min:0,max:10,step:.1}),PA('sharpness','Sharpness','num',6,{min:.1,max:40,step:.1})],
    apply(I){const P=I.p,cx=P.cx*I.w,cy=P.cy*I.h,M=Math.min(I.w,I.h);
      return warp(I,(x,y,pt)=>{const dx=x-cx,dy=y-cy,d=Math.hypot(dx,dy)||1,u=d/M,ph=(u*P.frequency-I.time*P.speed)*6.2832,wave=Math.sin(ph),env=Math.exp(-P.falloff*u)*Math.pow(Math.abs(wave),1/Math.max(.2,P.sharpness/6))*Math.sign(wave);
        const s=env*P.strength*M*.12;pt[0]=x+dx/d*s;pt[1]=y+dy/d*s})}},
  noisewarp:{label:'Noise Warp',kind:'static',params:[PA('amount','Amount','num',26,{min:0,max:400}),PA('noiseScale','Noise Scale','num',1,{min:.1,max:4,step:.05}),PA('speed','Speed','num',1,{min:0,max:5,step:.05}),PA('contain','Contain','bool',false)],
    apply(I){const r=I.rs,sc=Math.max(4,100*I.p.noiseScale*r),t=I.time*I.p.speed*.4,A=I.p.amount*r;
      const o=warp(I,(x,y,pt)=>{pt[0]=x+(fbm(x/sc+t,y/sc,1)-.5)*2*A;pt[1]=y+(fbm(x/sc+31,y/sc-t,2)-.5)*2*A});return I.p.contain?containTo(I,o):o}},
  fluidwarp:{label:'Fluid Warp',kind:'static',params:[PA('amount','Amount','num',25,{min:0,max:400}),PA('noiseScale','Noise Scale','num',1,{min:.1,max:4,step:.05}),PA('octaves','Octaves','num',4,{min:1,max:5,step:1}),PA('speed','Speed','num',1,{min:0,max:5,step:.05}),PA('contain','Contain','bool',false)],
    apply(I){const t=I.time*I.p.speed,r=I.rs,s=Math.max(10,70*I.p.noiseScale)*r,A=I.p.amount*r;
      const o=warp(I,(x,y,pt)=>{pt[0]=x+Math.sin(y/s+t*2.2)*A+Math.sin((x+y)/(s*1.6)-t*1.3)*A*.5;pt[1]=y+Math.cos(x/s*1.2+t*1.7)*A});return I.p.contain?containTo(I,o):o}},
  barrel:{label:'Barrel',kind:'static',params:[PA('outward','Direction','select','in',{opts:[['in','Inward'],['out','Outward']]}),PA('intensity','Intensity','num',.5,{min:0,max:1,step:.01})],apply(I){return barrelCore(I,I.p.intensity*(I.p.outward==='out'?-.6:.6))}},
  flutedglass:{label:'Fluted Glass',kind:'static',params:[PA('numColumns','Columns','num',12,{min:1,max:40,step:1}),PA('strength','Strength','num',.45,{min:0,max:1,step:.01}),PA('glowStrength','Glow Strength','num',.005,{min:0,max:.15,step:.001}),PA('glowWidth','Glow Width','num',.4,{min:.01,max:.5,step:.01})],
    apply(I){const sw=I.w/Math.max(1,I.p.numColumns),P=I.p;
      const o=warp(I,(x,y,pt)=>{const u=(x%sw)/sw-.5;pt[0]=x+u*P.strength*sw*1.6;pt[1]=y});
      if(P.glowStrength<=0)return o;return mapPx({...I,src:o},(D,p,x)=>{const u=Math.abs((x%sw)/sw-.5)*2,g=sstep(1-P.glowWidth*2,1,u)*P.glowStrength*40;if(g>0&&D[p+3])for(let i=0;i<3;i++)D[p+i]=Math.min(255,D[p+i]+255*g)})}},
  echoes:{label:'Echoes',kind:'static',params:[PA('scale','Scale','num',12,{min:1,max:100}),PA('n','Copies','num',5,{min:1,max:12,step:1}),PA('fade','Fade','bool',true)],
    pad:(p,b)=>Math.max(b.w,b.h)*p.n*p.scale/200,apply(I){return echoCore(I,Math.round(I.p.n),I.p.scale,I.p.fade,false)}},
  inwardechoes:{label:'Inward Echoes',kind:'static',params:[PA('repeatCount','Repeat Count','num',5,{min:1,max:16,step:1}),PA('scaleDown','Scale Down','num',.3,{min:.1,max:1,step:.01}),PA('cx','Center X','num',.5,{min:0,max:1,step:.01}),PA('cy','Center Y','num',.5,{min:0,max:1,step:.01})],
    apply(I){const n=Math.round(I.p.repeatCount),px=I.p.cx*I.w,py=I.p.cy*I.h;
      return copiesCore(I,n,(o,i)=>{const sc=1-I.p.scaleDown*i/n;o.translate(px,py);o.scale(sc,sc);o.translate(-px,-py)},i=>(1-i/(n+1))*.6)}},
  trail:{label:'Trail',kind:'static',params:[PA('dist','Distance','num',350,{min:0,max:1000}),PA('reps','Repeats','num',8,{min:2,max:16,step:1}),PA('spread','Distribution','num',.2,{min:0,max:1,step:.05}),PA('dir','Direction','dir','right'),PA('fade','Fade','bool',true)],
    pad:p=>p.dist,apply(I){return trailCore(I,I.p.dist,Math.round(I.p.reps),I.p.spread,I.p.fade,I.p.dir)}},
  radialblur:{label:'Radial Repeat Blur',kind:'static',params:[PA('amount','Blur Amount','num',.18,{min:0,max:1,step:.01}),PA('repeats','Repeats','num',40,{min:2,max:64,step:1}),PA('falloff','Edge Falloff','num',.5,{min:0,max:.5,step:.01}),PA('angle','Angle','num',0,{min:-360,max:360}),PA('cx','Center X','num',0,{min:-1,max:1,step:.01}),PA('cy','Center Y','num',0,{min:-1,max:1,step:.01})],
    apply(I){const n=Math.round(I.p.repeats),out=freeCv(I.src,I.w,I.h),o=out.getContext('2d'),px=I.w/2*(1+I.p.cx),py=I.h/2*(1+I.p.cy),spread=I.p.amount*60;
      for(let i=0;i<n;i++){o.save();o.globalAlpha=Math.max(.02,1/Math.sqrt(i+1)/ (n/8));o.translate(px,py);o.rotate((I.p.angle+(i/(n-1)-.5)*spread)*Math.PI/180);const sc=1+(i/(n-1)-.5)*I.p.amount*.4;o.scale(sc,sc);o.translate(-px,-py);o.drawImage(I.src,0,0);o.restore()}return out}},
  gridscrollx:{label:'Grid Scroll X',kind:'static',params:GRIDP,apply(I){return gridScroll(I,'x')}},
  gridscrolly:{label:'Grid Scroll Y',kind:'static',params:GRIDP,apply(I){return gridScroll(I,'y')}},
  orbit3d:{label:'3D Orbit',kind:'static',params:[PA('rotateX','Rotate X','num',0,{min:-1080,max:1080}),PA('rotateY','Rotate Y','num',35,{min:-1080,max:1080}),PA('rotateZ','Rotate Z','num',0,{min:-1080,max:1080}),PA('perspective','Perspective','num',.45,{min:0,max:1,step:.01}),PA('showFront','Show Front','bool',true),PA('showBack','Show Back','bool',true)],
    apply(I){const P=I.p;return flip3d(I,P.rotateX,P.rotateY,P.rotateZ,P.perspective,P.showFront,P.showBack,0,0)}},
  cardflip3d:{label:'Card Flip',kind:'static',params:[PA('rotationX','Rotation X','num',0,{min:-1080,max:1080}),PA('rotationY','Rotation Y','num',60,{min:-1080,max:1080}),PA('rotationZ','Rotation Z','num',0,{min:-3600,max:3600}),PA('pivotX','Pivot X','num',0,{min:-2,max:2,step:.05}),PA('pivotY','Pivot Y','num',0,{min:-2,max:2,step:.05}),PA('perspective','Perspective','num',.45,{min:0,max:1,step:.01}),PA('frontface','Front Face','bool',true),PA('backface','Back Face','bool',true)],
    apply(I){const P=I.p;return flip3d(I,P.rotationX,P.rotationY,P.rotationZ,P.perspective,P.frontface,P.backface,P.pivotX,P.pivotY)}},
  lumahighlight:{label:'Luma Highlight',kind:'static',params:[PA('luma_threshold','Luma Threshold','num',.5,{min:0,max:1,step:.01}),PA('fuzz_width','Fuzz Width','num',.1,{min:0,max:.6,step:.01}),PA('fuzz_intensity','Fuzz Intensity','num',.9,{min:0,max:1.5,step:.01})],
    apply(I){const P=I.p,th=P.luma_threshold+.03*Math.sin(I.time*.4*3.14159),hw=Math.max(P.fuzz_width/2,.0001);
      return mapPx(I,(D,p)=>{const a=D[p+3]/255,L=lumaOf(D[p],D[p+1],D[p+2]),band=1-sstep(0,hw,Math.abs(L-th)),f=Math.min(1,band*P.fuzz_intensity*a);
        for(let i=0;i<3;i++)D[p+i]=lerp(D[p+i],255,f);D[p+3]=255*Math.min(1,a+(1-a)*Math.min(1,f*.6))})}},
  noisemask:{label:'Noise Mask',kind:'static',params:[PA('threshold','Threshold','num',.5,{min:0,max:1,step:.01}),PA('scale','Scale','num',.55,{min:.1,max:3,step:.01}),PA('seed','Seed','num',0,{min:0,max:100,step:1}),PA('octaves','Octaves','num',4,{min:1,max:5,step:1}),PA('softness','Edge Softness','num',.06,{min:.001,max:.5,step:.001})],
    apply(I){const P=I.p,sc=Math.max(4,Math.min(I.w,I.h)*.35*P.scale);return mapPx(I,(D,p,x,y)=>{const n=fbm(x/sc+P.seed*7.3,y/sc+P.seed*3.9,5);D[p+3]*=sstep(P.threshold-P.softness,P.threshold+P.softness,n)})}},
  noisetile:{label:'Noise Tile',kind:'static',params:[PA('repetitionsX','X Repetitions','num',5,{min:1,max:30,step:1}),PA('repetitionsY','Y Repetitions','num',5,{min:1,max:30,step:1}),PA('gapX','Gap X','num',12,{min:0,max:500}),PA('gapY','Gap Y','num',12,{min:0,max:500}),PA('scale','Scale','num',1,{min:.1,max:4,step:.05}),PA('noiseScale','Noise Scale','num',1.5,{min:.1,max:12,step:.1}),PA('noiseMoveX','Noise Move X','num',.6,{min:-4,max:4,step:.1}),PA('noiseMoveY','Noise Move Y','num',.4,{min:-4,max:4,step:.1}),PA('fps','FPS','num',12,{min:1,max:60,step:1}),PA('threshold','Threshold','num',.45,{min:0,max:1,step:.01}),PA('seedOffset','Seed Offset','num',0,{min:-100,max:100,step:1})],
    apply(I){const P=I.p,nx=Math.round(P.repetitionsX),ny=Math.round(P.repetitionsY),gx=P.gapX*I.rs,gy=P.gapY*I.rs,cw=Math.max(2,(I.w-gx*(nx-1))/nx),ch=Math.max(2,(I.h-gy*(ny-1))/ny),tt=Math.floor(I.time*P.fps)/P.fps;
      const out=freeCv(I.src,I.w,I.h),o=out.getContext('2d');
      for(let j=0;j<ny;j++)for(let i=0;i<nx;i++){const n=fbm((i+tt*P.noiseMoveX)/nx*P.noiseScale*2+P.seedOffset,(j+tt*P.noiseMoveY)/ny*P.noiseScale*2,7);if(n<P.threshold)continue;
        const w2=cw*Math.min(1,P.scale),h2=ch*Math.min(1,P.scale);o.drawImage(I.src,i*(cw+gx)+(cw-w2)/2,j*(ch+gy)+(ch-h2)/2,w2,h2)}
      return out}},
  wiggle:{label:'Wiggle',kind:'static',params:[PA('wiggleX','Wiggle X','num',3,{min:0,max:200}),PA('wiggleY','Wiggle Y','num',3,{min:0,max:200}),PA('speed','Speed','num',3,{min:0,max:20,step:.1}),PA('angle','Angle','num',0,{min:0,max:10,step:.1}),PA('seed_id','Seed','num',1,{min:0,max:200,step:1})],
    pad:p=>Math.max(p.wiggleX,p.wiggleY)*1.2,apply(I){const P=I.p,t=I.time*P.speed*.5,sd=P.seed_id,n=(a,b)=>(vnoise(t+a,sd*3.1+b,sd)-.5)*2,out=freeCv(I.src,I.w,I.h),o=out.getContext('2d');
      o.translate(I.w/2+n(0,0)*P.wiggleX*I.rs,I.h/2+n(9.7,4)*P.wiggleY*I.rs);o.rotate(n(19.3,8)*P.angle*Math.PI/180);o.translate(-I.w/2,-I.h/2);o.drawImage(I.src,0,0);return out}},
  // ---- transitions (driven by an animation: progress 0 = hidden, 1 = shown)
  dissolve:{label:'Dissolve',kind:'trans',params:[PA('scale','Scale','num',10,{min:1,max:100}),PA('sharp','Sharpness','num',100,{min:0,max:100}),PA('variant','Variant','num',1,{min:1,max:10,step:1})],
    apply(I){const pr=I.progress,cell=Math.max(1,I.p.scale*I.rs*.5),soft=(1-I.p.sharp/100)*.5+.0001;
      return mapPx(I,(D,p,x,y)=>{const hh=hash((x/cell)|0,(y/cell)|0,I.seed);D[p+3]*=clamp01((pr*(1+soft)-hh)/soft)})}},
  noisedissolve:{label:'Noise Dissolve',kind:'trans',params:[PA('scale','Scale','num',1,{min:.1,max:3,step:.1}),PA('soft','Softness','num',0,{min:0,max:1,step:.05}),PA('variant','Variant','num',1,{min:1,max:10,step:1})],
    apply(I){const pr=I.progress,sc=Math.max(4,40*I.p.scale*I.rs),soft=I.p.soft*.5+.02;
      return mapPx(I,(D,p,x,y)=>{const nn=fbm(x/sc,y/sc,I.seed);D[p+3]*=clamp01((pr*(1+soft)-nn)/soft)})}},
  pixelwipe:{label:'Pixel Wipe',kind:'trans',params:[PA('scale','Scale','num',34,{min:4,max:100}),PA('spread','Spread','num',25,{min:0,max:100}),PA('dir','Direction','dir','right'),PA('variant','Variant','num',1,{min:1,max:10,step:1})],
    apply(I){const pr=I.progress,cell=Math.max(2,I.p.scale*I.rs*.5),v=vec4(I.p.dir),sp=I.p.spread/100;
      return mapPx(I,(D,p,x,y)=>{const cx=((x/cell)|0)*cell/I.w,cy=((y/cell)|0)*cell/I.h;let g=v[0]>0?cx:v[0]<0?1-cx:v[1]>0?cy:1-cy;
        g=g*(1-sp)+hash((x/cell)|0,(y/cell)|0,I.seed)*sp;D[p+3]=g<pr*(1+.001)?D[p+3]:0})}},
  pixelreveal:{label:'Pixel',kind:'trans',params:[PA('size','Pixel Size','num',40,{min:10,max:100}),PA('variant','Variant','num',1,{min:1,max:10,step:1})],
    apply(I){const pr=I.progress,cell=Math.max(2,I.p.size*I.rs*.5);
      return mapPx(I,(D,p,x,y)=>{const nn=fbm(((x/cell)|0)*.35,((y/cell)|0)*.35,I.seed);D[p+3]=nn<pr?D[p+3]:0})}},
  lumareveal:{label:'Luma Reveal',kind:'trans',params:[PA('rev','Reveal','select','ld',{opts:[['ld','Light → Dark'],['dl','Dark → Light']]}),PA('sharp','Sharpness','num',90,{min:1,max:100})],
    apply(I){const pr=I.progress,soft=(1-I.p.sharp/100)*.6+.02;
      return mapPx(I,(D,p)=>{const l=lumaOf(D[p],D[p+1],D[p+2]),key=I.p.rev==='dl'?l:1-l;D[p+3]*=clamp01((pr*(1+soft)-key)/soft)})}},
  noisewipe:{label:'Wipe',kind:'trans',params:[PA('scale','Scale','num',5,{min:1,max:100}),PA('spread','Spread','num',40,{min:0,max:100}),PA('sharp','Sharpness','num',100,{min:0,max:100}),PA('dir','Direction','dir','right'),PA('variant','Variant','num',1,{min:1,max:10,step:1})],
    apply(I){const pr=I.progress,v=vec4(I.p.dir),sp=I.p.spread/100*.6,soft=(1-I.p.sharp/100)*.4+.01,sc=Math.max(4,I.p.scale*8*I.rs);
      return mapPx(I,(D,p,x,y)=>{const nx=x/I.w,ny=y/I.h,g=v[0]>0?nx:v[0]<0?1-nx:v[1]>0?ny:1-ny,nn=fbm(x/sc,y/sc,I.seed);D[p+3]*=clamp01((pr*(1+sp)-g-nn*sp)/soft)})}},
  glitch:{label:'Glitch',kind:'trans',params:[PA('slice','Slice size','num',30,{min:1,max:100}),PA('speed','Speed','num',65,{min:1,max:100}),PA('shift','Color shift','num',40,{min:1,max:100}),PA('variant','Variant','num',1,{min:1,max:10,step:1})],
    pad:p=>p.shift*.6,
    apply(I){const{w,h}=I,pr=I.progress,q=1-pr,S=I.src.getContext('2d').getImageData(0,0,w,h).data,out=freeCv(I.src,w,h),o=out.getContext('2d'),od=o.createImageData(w,h),D=od.data;
      const band=Math.max(2,Math.round(I.p.slice*I.rs*.4)),frame=Math.floor(I.time*I.p.speed*.25),cs=Math.round(q*I.p.shift*.4*I.rs);
      for(let y=0;y<h;y++){
        const b=(y/band)|0,r1=hash(b,frame,I.seed),r2=hash(b,frame+7,I.seed);
        if(r1<q*1.15-.1&&r2<q+.1)continue;                                    // slice hidden
        const off=Math.round(r1<q?(r2-.5)*q*w*.35:0);
        for(let x=0;x<w;x++){
          const q4=(y*w+x)*4,sx=x-off,sr=Math.max(0,Math.min(w-1,sx-cs)),sb=Math.max(0,Math.min(w-1,sx+cs)),sg=Math.max(0,Math.min(w-1,sx));
          const pr_=(y*w+sr)*4,pb=(y*w+sb)*4,pg=(y*w+sg)*4;
          D[q4]=S[pr_];D[q4+1]=S[pg+1];D[q4+2]=S[pb+2];D[q4+3]=Math.max(S[pr_+3],S[pg+3],S[pb+3]);
        }
      }o.putImageData(od,0,0);return out}},
  barrelT:{label:'Barrel',kind:'trans',params:[PA('k','Intensity','num',0.5,{min:0,max:1,step:.05}),PA('dir','Direction','select','in',{opts:[['in','Inward'],['out','Outward']]})],
    apply(I){const k=(1-I.progress)*I.p.k*(I.p.dir==='out'?-1:1)*.8;return fadeTo(I,barrelCore(I,k),I.progress*1.4)}},
  blinkT:{label:'Blink',kind:'trans',params:[PA('blinks','Blinks','num',3,{min:1,max:20,step:1}),PA('random','Random','bool',false)],
    apply(I){const pr=I.progress,n=Math.max(1,Math.round(I.p.blinks));if(pr>=.999)return I.src;
      const k=Math.floor(pr*n*2+(I.p.random?(hash(Math.floor(pr*n*2),5,I.seed)-.5)*.9:0)),on=((k%2)+2)%2===1;return on?I.src:freeCv(I.src,I.w,I.h)}},
  fluidT:{label:'Fluid Warp',kind:'trans',params:[PA('amount','Amount','num',40,{min:0,max:120})],
    apply(I){return fadeTo(I,fluidCore(I,(1-I.progress)*I.p.amount),I.progress*1.5)}},
  trailT:{label:'Trail',kind:'trans',params:[PA('dist','Distance','num',350,{min:0,max:1000}),PA('reps','Repeats','num',8,{min:2,max:16,step:1}),PA('spread','Distribution','num',0.2,{min:0,max:1,step:.05}),PA('dir','Direction','dir','right'),PA('fade','Fade','bool',true)],
    pad:p=>p.dist,apply(I){return fadeTo(I,trailCore(I,I.p.dist*(1-I.progress),Math.round(I.p.reps),I.p.spread,I.p.fade,I.p.dir),I.progress*2)}},
  echoT:{label:'Echoes',kind:'trans',params:[PA('step','Scale','num',30,{min:1,max:100}),PA('fade','Fade','bool',true)],
    pad:(p,b)=>Math.max(b.w,b.h)*p.step/50,apply(I){return fadeTo(I,echoCore(I,6,I.p.step*(1-I.progress)/3,I.p.fade,false),I.progress*1.6)}},
  filmT:{label:'Film Roll',kind:'trans',params:[PA('n','Copies','num',6,{min:1,max:10,step:1}),PA('blur','Motion Blur','num',50,{min:1,max:100}),PA('curve','Stretch','num',50,{min:0,max:100})],
    pad:(p,b)=>b.h*1.2,apply(I){const n=Math.round(I.p.n),out=freeCv(I.src,I.w,I.h),o=out.getContext('2d'),q=1-I.progress,gap=I.h/n*(1+I.p.curve/100*.25);
      for(let i=0;i<n;i++){o.globalAlpha=(i===0?1:q*I.p.blur/100/ (1+i*.4));o.drawImage(I.src,0,-q*I.h*1.2+i*gap*q*.8)}o.globalAlpha=1;return fadeTo(I,out,I.progress*2)}},
  cardflip:{label:'Card Flip',kind:'trans',params:[PA('axis','Axis','select','y',{opts:[['y','Horizontal'],['x','Vertical']]})],
    apply(I){const a=(1-I.progress)*Math.PI/2,c=Math.cos(a),out=freeCv(I.src,I.w,I.h),o=out.getContext('2d');if(c<.02)return out;
      o.translate(I.w/2,I.h/2);I.p.axis==='x'?o.scale(1,c):o.scale(c,1);o.translate(-I.w/2,-I.h/2);o.drawImage(I.src,0,0);
      o.setTransform(1,0,0,1,0,0);o.globalCompositeOperation='source-atop';o.fillStyle=`rgba(0,0,0,${(1-c)*.5})`;o.fillRect(0,0,I.w,I.h);return out}},
  orbit:{label:'3D Orbit',kind:'trans',params:[PA('angle','Angle','num',70,{min:10,max:160})],
    apply(I){const a=(1-I.progress)*I.p.angle*Math.PI/180,c=Math.cos(a),out=freeCv(I.src,I.w,I.h),o=out.getContext('2d');if(c<.02)return out;
      o.translate(I.w/2+Math.sin(a)*I.w*.35,I.h/2);o.scale(c,1);o.translate(-I.w/2,-I.h/2);o.globalAlpha=Math.min(1,I.progress*2);o.drawImage(I.src,0,0);return out}}
};
// ---------- the Utility effects, worked out the way Jitter's own shaders do (same maths, same parameters, same defaults) ----------
// Maths in "local" coordinates: (0,0)-(1,1) is the layer's own box; the padded canvas around it is where an effect may draw beyond the layer.
const SHC=document.createElement('canvas');
function shaderRun(I,shade,cost){
  const{w,h,rs,bx}=I,cw=bx.w*rs,ch=bx.h*rs,ox=(w-cw)/2,oy=(h-ch)/2,S=I.src.getContext('2d').getImageData(0,0,w,h).data;
  const step=Math.max(1,Math.ceil(Math.sqrt(w*h*(cost||1)/2.6e6))),ow=Math.ceil(w/step),oh=Math.ceil(h/step);
  SHC.width=ow;SHC.height=oh;const sg=SHC.getContext('2d'),od=sg.createImageData(ow,oh),D=od.data;
  // premultiplied bilinear sample of the source at local (lu,lv); transparent outside the layer's box
  const smp=(lu,lv,o)=>{
    if(!(lu>=0&&lu<=1&&lv>=0&&lv<=1)){o[0]=o[1]=o[2]=o[3]=0;return}
    const fx=ox+lu*cw-.5,fy=oy+lv*ch-.5,x0=Math.floor(fx),y0=Math.floor(fy),tx=fx-x0,ty=fy-y0;let R=0,G=0,B=0,A=0;
    for(let j=0;j<2;j++)for(let i=0;i<2;i++){
      const xx=Math.max(0,Math.min(w-1,x0+i)),yy=Math.max(0,Math.min(h-1,y0+j)),p=(yy*w+xx)*4,a=S[p+3]/255,k=(i?tx:1-tx)*(j?ty:1-ty);
      R+=S[p]*a*k;G+=S[p+1]*a*k;B+=S[p+2]*a*k;A+=a*255*k;
    }
    o[0]=R;o[1]=G;o[2]=B;o[3]=A;
  };
  const o=[0,0,0,0],geo={w:bx.w,h:bx.h,cw,ch,smp};
  for(let y=0;y<oh;y++)for(let x=0;x<ow;x++){
    const px=(x+.5)*step,py=(y+.5)*step;
    shade((px-ox)/cw,(py-oy)/ch,o,geo);
    const a=o[3],q=(y*ow+x)*4;
    if(a>.5){D[q]=Math.min(255,o[0]*255/a);D[q+1]=Math.min(255,o[1]*255/a);D[q+2]=Math.min(255,o[2]*255/a);D[q+3]=Math.min(255,a)}
  }
  sg.putImageData(od,0,0);
  const out=freeCv(I.src,w,h),oc=out.getContext('2d');oc.imageSmoothingEnabled=true;oc.imageSmoothingQuality='high';oc.drawImage(SHC,0,0,ow,oh,0,0,w,h);return out;
}
// Brian Sharpe style 2D simplex noise: the value in -1..1 that Jitter's effects read; "res" is the layer's size, scale 1 = a medium cell of 300 px
function simplex2(ux,uy,rw,rh,scl){
  const cell=Math.max(Math.max(scl*150,.001)*2,.001),px=ux*rw/cell,py=uy*rh/cell,SK=.36602540378443864676,UK=.21132486540518711774,TH=.70710678118654752440,
    S0=1-UK,S1=-UK,S2=1-2*UK,sx=px*TH,sy=py*TH,s=(sx+sy)*SK,cx=Math.floor(sx+s),cy=Math.floor(sy+s);
  const fr=v=>v-Math.floor(v),hs=[cx,cy,cx+1,cy+1].map(v=>{const m=v-Math.floor(v/71)*71;return m});
  let h0=hs[0]+26,h1=hs[1]+161,h2=hs[2]+26,h3=hs[3]+161;h0*=h0;h1*=h1;h2*=h2;h3*=h3;
  const hx=[h0*h1,h2*h1,h0*h3,h2*h3];   // hashSeed.xzxz * hashSeed.yyww
  const HX=hx.map(v=>fr(v/951.135664)),HY=hx.map(v=>fr(v/642.949883));
  const u=(cx+cy)*UK,v0x=cx-u-sx,v0y=cy-u-sy,lt=v0x<v0y;
  const v1x=lt?S0:S1,v1y=lt?S1:S0,g1x=lt?HX[1]:HX[2],g1y=lt?HY[1]:HY[2];
  const v12x=v1x+v0x,v12y=v1y+v0y,v12z=S2+v0x,v12w=S2+v0y;
  const gx=[HX[0]-.49999,g1x-.49999,HX[3]-.49999],gy=[HY[0]-.49999,g1y-.49999,HY[3]-.49999];
  const vx=[v0x,v12x,v12z],vy=[v0y,v12y,v12w];let sum=0;
  for(let k=0;k<3;k++){const ir=1/Math.sqrt(gx[k]*gx[k]+gy[k]*gy[k]),gr=ir*(gx[k]*vx[k]+gy[k]*vy[k]);let m=Math.max(.5-(vx[k]*vx[k]+vy[k]*vy[k]),0);m*=m;sum+=m*m*gr}
  return sum*99.204334582718712977;
}
const smooth01=(a,b,x)=>{const t=Math.max(0,Math.min(1,(x-a)/((b-a)||1e-9)));return t*t*(3-2*t)};
const modp=(a,b)=>a-b*Math.floor(a/b);
// a flat layer seen through a camera, turned about a pivot: the ray from every pixel is carried back onto the layer's plane
function planarOrbit(lu,lv,aspect,rx,ry,rz,pv,persp,camDist,o,smp){
  const D=Math.PI/180,cx=Math.cos(rx*D),sx=Math.sin(rx*D),cy=Math.cos(ry*D),sy=Math.sin(ry*D),cz=Math.cos(rz*D),sz=Math.sin(rz*D);
  const focal=8+(.6-8)*Math.max(0,Math.min(1,persp)),camZ=Math.max(camDist,.05),ndx=(lu*2-1)*aspect,ndy=lv*2-1;
  const rayX=ndx/focal,rayY=ndy/focal,rayZ=1,px=pv[0]*aspect,py=pv[1],pz=pv[2],rox=0-px,roy=0-py,roz=-camZ-pz;
  const ry1=rayY*cx-rayZ*sx,rz1=rayY*sx+rayZ*cx,oy1=roy*cx-roz*sx,oz1=roy*sx+roz*cx;
  const rx2=rayX*cy+rz1*sy,rz2=-rayX*sy+rz1*cy,ox2=rox*cy+oz1*sy,oz2=-rox*sy+oz1*cy;
  const rx3=rx2*cz-ry1*sz,ry3=rx2*sz+ry1*cz,ox3=ox2*cz-oy1*sz,oy3=ox2*sz+oy1*cz;
  const fox=ox3+px,foy=oy3+py,foz=oz2+pz;let den=rz2,hit=1;if(Math.abs(den)<1e-5){hit=0;den=1e-5}
  const hd=-foz/den;if(hd<=0)hit=0;
