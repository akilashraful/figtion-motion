ART.fluidwarp=(g,w,h)=>{g.fillStyle='#6b4fb8';g.fillRect(0,0,w,h);const cols=['#d6c9ff','#3a2788','#9d8de6','#f0eaff','#281a66','#7d66d0'];
  for(let i=0;i<14;i++){g.fillStyle=cols[i%cols.length];g.globalAlpha=.85;g.beginPath();g.moveTo(0,i*40-60);for(let x=0;x<=w;x+=40)g.lineTo(x,i*40-60+Math.sin(x/90+i)*40);for(let x=w;x>=0;x-=40)g.lineTo(x,i*40-10+Math.sin(x/90+i+1)*40);g.fill()}g.globalAlpha=1};
