// ---------- the Distortion effects, worked out like Jitter's shaders: Bulge + Displacement share one displacement shader; Fluid Warp, Noise Warp, Fluted Glass and Ripple are their own ----------
const barrelPt=(u,v,k)=>{const sx=u-.5,sy=v-.5,f=1+k*(sx*sx+sy*sy);return[.5+sx*f,.5+sy*f]};
const mirrorFold=v=>{let m=v-2*Math.floor(v/2);return m>1?2-m:m};
const hash11=n=>{const v=Math.sin(n*127.1)*43758.5453;return v-Math.floor(v)};
const warpPad=p=>Math.max(0,p.amount);
function warpNoise(I,fluid){
  const P=I.p,{bx}=I,W=Math.max(bx.w,1e-4),H=Math.max(bx.h,1e-4),t=I.time*.4*P.speed,asp=W/H,sA=P.amount/W,oct=Math.floor(Math.max(1,Math.min(5,P.octaves||1))),nsc=P.noiseScale,
    qx1=t,qy1=t*.7,qx2=-t*.6+5.2,qy2=t*.9+1.3,contain=!!P.contain,o2=[0,0,0,0];
  return shaderRun(I,(lu,lv,o,g)=>{
    const ux=lu,uy=lv*H/W;
    let dX,dY;
    if(fluid){
      const q1x=ux+qx1,q1y=uy+qy1,q2x=ux+qx2,q2y=uy+qy2,nX=fbmSimplex(q1x,q1y,W,H,nsc,oct,2,.55),nY=fbmSimplex(q2x,q2y,W,H,nsc,oct,2,.55),
        q3x=q1x+nX*.4+t*.3,q3y=q1y+nY*.4-t*.2,q4x=q2x+nY*.4-t*.25,q4y=q2y+nX*.4+t*.35,o1=Math.max(oct-1,1);
      dX=fbmSimplex(q3x,q3y,W,H,nsc*.85,o1,2,.5);dY=fbmSimplex(q4x,q4y,W,H,nsc*.85,o1,2,.5);
    }else{dX=simplex2(ux+qx1,uy+qy1,W,H,nsc);dY=simplex2(ux+qx2,uy+qy2,W,H,nsc)}
    let wu=lu+dX*sA,wv=lv+dY*sA*asp;
    if(contain){
      if(lu<0||lu>1||lv<0||lv>1){o[0]=o[1]=o[2]=o[3]=0;return}
      wu=mirrorFold(wu);wv=mirrorFold(wv);
      g.smp(Math.max(0,Math.min(1,wu)),Math.max(0,Math.min(1,wv)),o);return;
    }
