      effects:(n.effects||[]).filter(x=>x.visible!==false&&!(x.color&&x.color.a===0)).map(x=>({type:x.type,radius:x.radius,offset:x.offset,color:x.color,spread:x.spread}))};
    const ip=(n.fillPaints||[]).find(q=>q.type==='IMAGE'&&q.visible!==false);
