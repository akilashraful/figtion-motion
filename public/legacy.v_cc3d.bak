      o.characters=n.textData&&n.textData.characters||'';o.fontSize=n.fontSize;o.fontName=n.fontName?{family:n.fontName.family,style:n.fontName.style}:undefined;
      o.lineHeight=unit(n.lineHeight);o.letterSpacing=n.letterSpacing?unit(n.letterSpacing):{unit:'PIXELS',value:0};
      o.textAlignHorizontal=n.textAlignHorizontal;o.textAlignVertical=n.textAlignVertical;o.textAutoResize=n.textAutoResize;o.textCase=n.textCase;
