}
function picScene(mut,key){const q=selScene(mut);if(q)return q;const l=artLayer(key);mut(l);return{bg:'#ffffff',layers:[l]}}
// every effect from the Effects tab is also an animation, so it gets a timeline bar you can move and stretch
// Jitter: an effect runs to the end of the scene (0.8–4 s), linearly unless its preset says otherwise
Object.keys(FXLIB).forEach(id=>{const d=FXLIB[id];ANIMS['Fx:'+id]={modes:false,ease:(d.op&&d.op.ease)||'linear',params:d.params||[],gen:()=>({_hold:{id}}),fxhold:true,fxop:d.op,fxpre:d.pre,durFn:t0=>Math.min(4,Math.max(.8,scene.duration-t0))};ANIM_LABEL['Fx:'+id]=d.label||id});
const FX_CATS=[['Distortion',['bulge','displacement','fluidwarp','flutedglass','noisewarp','ripple']],
  ['Post FX',['dither','dotgrid','duotone','lumahighlight','noisemask','pixelate','threshold','tritone','rgbshift']],
  ['Utility',['orbit3d','cardflip3d','colorgrade','colorremove','gridscrollx','gridscrolly','inwardechoes','noisetile','radialblur','wiggle']]];
function fxLibScene(id){const l=dummy();l.effects=[{id,p:defaultsOf(FXLIB[id].params)}];return{bg:'#2f323b',layers:[l]}}
function fxScene(fx){const l=dummy();fx(l);return{bg:'#2f323b',layers:[l]}}
function thumbDraw(e,time){const cw=e.c.canvas.width,ch=e.c.canvas.height,k=ch/720;render(e.c,e.sc,time,false,k,(cw-1280*k)/2)}
function card(list,name,sc,staticT,d,click,extra='',fx=false){
  const i=list.push({name,sc,staticT,d,click})-1;
  if(fx)return `<div class="card fx" data-i="${i}" style="position:relative"><div class="tile"><canvas width="300" height="240"></canvas></div>${extra}<div class="cl">${esc(name)}</div></div>`;
  return `<div class="card" data-i="${i}" style="position:relative"><canvas width="210" height="210"></canvas>${extra}<div class="cl">${esc(name)}</div></div>`;
}
function bindCards(root){
  root.querySelectorAll('.card').forEach(el=>{
    const e=thumbs[el.dataset.i];e.c=el.querySelector('canvas').getContext('2d');
    thumbDraw(e,e.staticT);
    el.onclick=ev=>{if(ev.target.classList.contains('x'))return;keepOpen=ev.shiftKey||ev.metaKey||ev.ctrlKey;try{e.click()}finally{keepOpen=false}};
    e.el=el;if(cardIO)cardIO.observe(el);
