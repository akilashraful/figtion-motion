// selection outlines and handles are drawn last so nothing can cover them
function drawOverlay(c,time){
  const leaves=selected();let ux0=1e9,ux1=-1e9,uy0=1e9,uy1=-1e9,any=false;
  leaves.forEach(l=>{
    if(l.type==='audio'||hiddenDeep(l)||!visibleAt(l,time))return;
    const s=state(l,time),bx=boxSize(l,s),bw=bx.w,bh=bx.h,hw=bw*s.scale/2,hh=bh*s.scale/2;any=true;
    ux0=Math.min(ux0,s.x-hw);ux1=Math.max(ux1,s.x+hw);uy0=Math.min(uy0,s.y-hh);uy1=Math.max(uy1,s.y+hh);
    c.save();c.translate(s.x,s.y);c.rotate(s.rot*Math.PI/180);c.scale(s.scale,s.scale);
    c.strokeStyle=lockedDeep(l)?'#9a9aa6':'#7a3ff2';c.lineWidth=1.5/(viewZ*s.scale);c.strokeRect(-bw/2,-bh/2,bw,bh);
    if(cropEdit&&cropEdit.id===l.id)drawCrop(c,l,s.scale);
    if(pe&&pe.id===l.id&&!lockedDeep(l))drawPoints(c,l,s,s.scale);
