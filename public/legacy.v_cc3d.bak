    if(n.hidden)return;
    if(n.type==='group'){
      const ch=childrenIn(sc,n.id);
      let clipped=false;
      if(n.clipId!=null){const cl=sc.layers.find(x=>x.id===n.clipId);if(cl){const st=state(cl,time);c.save();rrPath(c,st.x-st.w/2,st.y-st.h/2,st.w,st.h,crOf(cl,st));c.clip();clipped=true}}
