  varuint(){let v=0,sh=0,b;do{b=this.d[this.i++];v+=(b&127)*Math.pow(2,sh);sh+=7}while(b&128);return v}
  varint(){const v=this.varuint();return v%2?-(Math.floor(v/2))-1:Math.floor(v/2)}
  varfloat(){const f=this.d[this.i];if(f===0){this.i++;return 0}let bits=f|(this.d[this.i+1]<<8)|(this.d[this.i+2]<<16)|(this.d[this.i+3]<<24);this.i+=4;bits=(bits<<23)|(bits>>>9);this.i32[0]=bits;return this.f32[0]}
