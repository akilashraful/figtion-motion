function artLayer(key){
  const k=ART[key]?key:'photo';let e=artImgs.get(k);
  if(!e){const im=new Image();e={im,id:-(2+artSeq++)};im.onload=()=>thumbs.forEach(t=>{if(t.c)thumbDraw(t,t.staticT)});im.src=artCv(ART[k]).toDataURL();artImgs.set(k,e)}
  imgs[e.id]=e.im;
