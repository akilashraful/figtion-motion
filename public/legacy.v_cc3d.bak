// the browser's paste event: images, SVG, plugin JSON, then the app's own clipboard
addEventListener('paste',e=>{
  if(palOpen()||['INPUT','SELECT','TEXTAREA'].includes(e.target.tagName)||e.target.isContentEditable)return;
  const cd=e.clipboardData;if(!cd)return;
  e.preventDefault();
  const html0=cd.getData('text/html');
  if(html0&&/\(figma\)/.test(html0)&&!(cd.getData('text/plain')||'').trim().startsWith('{')){
    decodeFigmaHtml(html0).then(async msg=>{
      window.__lastFigmaMsg=msg;
      try{if(localStorage.getItem('fg_debug')==='on')setTimeout(saveFigmaPasteReport,400)}catch(e){}   // opt-in: every Figma paste also drops a small report in Downloads
      const nodes=msg&&kiwiToNodes(msg,msg._meta);
      if(nodes&&nodes.length)await resolveFigmaImages(nodes,msg._meta);
      if(nodes&&nodes.length){const r=figToItems({format:'figtion-figma',nodes});if(r&&(r.frames?r.items.length:r.layers.length)){pasteImport(r);return}}
      toast('Nothing importable in that Figma selection');
    }).catch(err=>toast(String(err&&err.message).includes('zstd')?'Could not load the decoder for this Figma copy (needs internet once)':'Could not read Figma\u2019s clipboard \u2014 use the Figtion plugin or Copy as SVG'));
    return;
  }
  const img=[...cd.files].find(f=>f.type.startsWith('image/'))||[...cd.items].map(i=>i.kind==='file'&&i.type.startsWith('image/')?i.getAsFile():null).find(Boolean);
  const text=cd.getData('text/plain')||cd.getData('text');
  if(text&&importText(text))return;
  if(img){importImageFile(img);return}
  const html=cd.getData('text/html');
  if(html&&/<svg[\s>]/i.test(html)){const m=html.match(/<svg[\s\S]*<\/svg>/i);if(m&&importText(m[0]))return}
  pasteNodes(false);
});
async function pasteSystem(){
  try{
    const items=await navigator.clipboard.read();
    for(const it of items){
      const ty=it.types.find(t=>t==='web '+JITTER_MIME);
      if(ty&&importText(await(await it.getType(ty)).text()))return;
      if(it.types.includes('text/plain')&&importText(await(await it.getType('text/plain')).text()))return;
      const im=it.types.find(t=>t.startsWith('image/'));
      if(im){importImageFile(new File([await it.getType(im)],'pasted',{type:im}));return}
    }
  }catch(e){}
  pasteNodes(false);
}
const cutNodes=()=>{if(!selSet.size)return;copyNodes();delNodes(topSelNodes())};
const dupById=id=>{const l=byId(id);if(!l)return;dupNodes(selSet.has(id)?topSelNodes():[l])};
function delNodes(nodes,quiet){
  const ids=new Set();nodes.forEach(n=>{ids.add(n.id);if(n.type==='group')descendantsOf(n).forEach(d=>ids.add(d.id))});
  scene.layers=scene.layers.filter(l=>!ids.has(l.id));
  for(let ch=true;ch;){ch=false;const cur_=scene.layers;scene.layers=cur_.filter(g=>{if(g.type==='group'&&!cur_.some(k=>k.parent===g.id)){ch=true;return false}return true})}
  selectOnly(null);selKey=null;if(!quiet)refresh();
}
const delLayers=delNodes;
// bring forward / send backward move one step among siblings; front / back jump to the ends
function arrange(nodes,op){
  if(!nodes.length)return;
  const sibs=n=>childrenOf(scene.layers,parentKey(n));
  const ordered=[...nodes].sort((a,b)=>scene.layers.indexOf(a)-scene.layers.indexOf(b));
  if(op==='front')ordered.forEach(n=>{scene.layers.splice(scene.layers.indexOf(n),1);scene.layers.push(n)});
  else if(op==='back')[...ordered].reverse().forEach(n=>{scene.layers.splice(scene.layers.indexOf(n),1);scene.layers.unshift(n)});
  else{
    const dir=op==='forward'?1:-1,seq=dir>0?[...ordered].reverse():ordered;
    seq.forEach(n=>{const s=sibs(n),i=s.indexOf(n),j=i+dir;if(j<0||j>=s.length||nodes.includes(s[j]))return;
      const a=scene.layers.indexOf(n),b=scene.layers.indexOf(s[j]);[scene.layers[a],scene.layers[b]]=[scene.layers[b],scene.layers[a]]});
  }
  refresh();
}
const moveLayers=(ls,d)=>arrange(ls,d>0?'forward':'backward');
function moveNode(srcId,targetId,pos){
  const src=byId(srcId),tgt=byId(targetId);if(!src||!tgt||src===tgt)return;
  let movers=selSet.has(srcId)?topSelNodes():[src];
  movers=movers.filter(n=>{for(let p=tgt;p;p=parentOf(p))if(p===n)return false;return n!==tgt});     // never drop a group into itself
  if(!movers.length)return;
  scene.layers=scene.layers.filter(l=>!movers.includes(l));
  let newParent,at;
  if(pos==='inside'&&tgt.type==='group'){newParent=tgt.id;at=scene.layers.length}
  else{newParent=parentKey(tgt);const ti=scene.layers.indexOf(tgt);at=pos==='before'?ti+1:ti}   // "before" = drawn above = later in the array
  movers.forEach(n=>{n.parent=newParent});
  scene.layers.splice(at,0,...movers);
  if(newParent!=null){const g=byId(newParent);if(g)g.expanded=true}
  refresh();
}
// groups & masks
function groupSelected(){
  const nodes=topSelNodes();if(!nodes.length)return toast('Select layers to group');
  const topmost=nodes.reduce((a,b)=>scene.layers.indexOf(a)>scene.layers.indexOf(b)?a:b);
  const n=scene.layers.filter(l=>l.type==='group').length+1;
  const g={id:uid++,type:'group',name:'Group '+n,x:W/2,y:H/2,w:100,h:100,rot:0,scale:1,opacity:1,tracks:{},tag:'',...BASEDEF,anims:[],parent:parentKey(topmost),expanded:true,mask:false};
  nodes.forEach(x=>{x.parent=g.id});
  scene.layers.splice(scene.layers.indexOf(topmost)+1,0,g);
  selectOnly(g.id);refresh();return g;
}
// ---------- boolean operations: union / subtract / intersect / exclude keep the shapes live inside a boolean group; flatten bakes them
const BOOL_OPS=[['union','Union','U','bool-union'],['subtract','Subtract','S','bool-subtract'],['intersect','Intersect','I','bool-intersect'],['exclude','Exclude','E','bool-exclude'],['flatten','Flatten','F','flatten']];
const BOOL_NAME={union:'Union',subtract:'Subtract',intersect:'Intersect',exclude:'Exclude'};
const BOOL_COMP={union:'source-over',subtract:'destination-out',intersect:'destination-in',exclude:'xor'};
const boolShape=n=>n.type!=='group'&&(['rect','ellipse','star','polygon'].includes(n.type)||(n.type==='path'&&n.closed));
function silhouetteOf(l,s){
  if(['rect','ellipse','star','polygon'].includes(l.type))return shapePath(l,s);
  if(l.type==='path'&&l.closed){const P=new Path2D();if(l.subs){l.subs.forEach(sub=>{sub.forEach(([nx,ny],i)=>i?P.lineTo(nx*s.w,ny*s.h):P.moveTo(nx*s.w,ny*s.h));P.closePath()});P._eo=true}else{(l.pts||[]).forEach(([nx,ny],i)=>i?P.lineTo(nx*s.w,ny*s.h):P.moveTo(nx*s.w,ny*s.h));P.closePath()}return P}
  return null;
}
const boolCv=document.createElement('canvas');
// drawn by drawNodes in place of the group's children
function drawBoolGroup(c,n,ch,time,k){
  const kids=ch.filter(l=>!l.hidden&&l.type!=='group'&&silhouetteOf(l,state(l,time)));
  if(!kids.length)return;
  let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;
  kids.forEach(l=>{const s=state(l,time),b=boxSize(l,s),hw=b.w*s.scale/2,hh=b.h*s.scale/2,th=s.rot*Math.PI/180,co=Math.abs(Math.cos(th)),si=Math.abs(Math.sin(th)),ex=hw*co+hh*si,ey=hw*si+hh*co;
    x0=Math.min(x0,s.x-ex);x1=Math.max(x1,s.x+ex);y0=Math.min(y0,s.y-ey);y1=Math.max(y1,s.y+ey)});
  const pad=2,bw=x1-x0+pad*2,bh=y1-y0+pad*2,kk=Math.max(.25,Math.min(k||1,4096/Math.max(bw,bh)));
  x0-=pad;y0-=pad;
  boolCv.width=Math.max(2,Math.ceil(bw*kk));boolCv.height=Math.max(2,Math.ceil(bh*kk));
  const g=boolCv.getContext('2d');g.setTransform(kk,0,0,kk,-x0*kk,-y0*kk);
  kids.forEach((l,i)=>{
    const s=state(l,time),P=silhouetteOf(l,s);g.save();g.translate(s.x,s.y);g.rotate(s.rot*Math.PI/180);g.scale(s.scale*(l.flipX?-1:1),s.scale*(l.flipY?-1:1));
    g.globalCompositeOperation=i?(BOOL_COMP[n.bool]||'source-over'):'source-over';g.fillStyle='#000';g.fill(P,ruleOf(P));g.restore();
  });
  // the result takes the look of the bottom-most shape
  const base=kids[0],bs_=state(base,time);
  g.globalCompositeOperation='source-in';
  if(base.fills&&base.fills.length){g.save();g.translate(x0+bw/2,y0+bh/2);base.fills.forEach(f=>paintFill(g,f,bw,bh));g.restore()}
  else{g.fillStyle=fillAlphaCss(base,base.fill);g.fillRect(x0,y0,bw,bh)}
  g.globalCompositeOperation='source-over';
  c.save();c.globalAlpha*=Math.max(0,Math.min(1,n.opacity==null?1:n.opacity));c.drawImage(boolCv,x0,y0,bw,bh);c.restore();
}
// the result is a real vector shape (a "custom shape"): the combined outline is traced into a compound path, holes included
const boolOperand=n=>boolShape(n)||n.type==='bool';
// absolute description of every operand (bool layers are expanded to the shapes they carry)
function specsOf(nodes){
  const out=[];
  nodes.forEach(l=>{
    const s=state(l,t);
    if(l.type==='bool'){
      const sx=s.w/(l.baseW||s.w),sy=s.h/(l.baseH||s.h),th=s.rot*Math.PI/180,co=Math.cos(th),si=Math.sin(th);
      (l.shapes||[]).forEach(sh=>{const ux=sh.x*sx*s.scale,uy=sh.y*sy*s.scale;
        out.push({...sh,x:s.x+ux*co-uy*si,y:s.y+ux*si+uy*co,w:sh.w*sx*s.scale,h:sh.h*sy*s.scale,rot:(sh.rot||0)+s.rot,cr:(sh.cr||0)*sx,op:l.op})});
    }else out.push({type:l.type,x:s.x,y:s.y,w:s.w,h:s.h,rot:s.rot,scale:s.scale,flipX:!!l.flipX,flipY:!!l.flipY,cr:s.cr||0,crI:l.crI?[...l.crI]:undefined,points:l.points,ir:s.ir,sides:l.sides,pts:l.pts,subs:l.subs,closed:l.closed,fill:l.fill});
  });
  return out;
}
function specBox(sh){const hw=sh.w*sh.scale/2,hh=sh.h*sh.scale/2,th=(sh.rot||0)*Math.PI/180,co=Math.abs(Math.cos(th)),si=Math.abs(Math.sin(th)),ex=hw*co+hh*si,ey=hw*si+hh*co;return{x0:sh.x-ex,x1:sh.x+ex,y0:sh.y-ey,y1:sh.y+ey}}
// marching squares over an alpha mask -> closed loops (grid coordinates)
function traceLoops(D,w,h,thr){
  const A=(x,y)=>D[(y*w+x)*4+3],pt=new Map(),adj=new Map();
  const addSeg=(i1,i2)=>{(adj.get(i1)||adj.set(i1,[]).get(i1)).push(i2);(adj.get(i2)||adj.set(i2,[]).get(i2)).push(i1)};
  const hid=(x,y)=>{const id='h'+x+','+y;if(!pt.has(id)){const a=A(x,y),b=A(x+1,y);pt.set(id,[x+(thr-a)/(b-a),y])}return id};
  const vid=(x,y)=>{const id='v'+x+','+y;if(!pt.has(id)){const a=A(x,y),b=A(x,y+1);pt.set(id,[x,y+(thr-a)/(b-a)])}return id};
  for(let y=0;y<h-1;y++)for(let x=0;x<w-1;x++){
    const m=(A(x,y)>=thr?1:0)|(A(x+1,y)>=thr?2:0)|(A(x+1,y+1)>=thr?4:0)|(A(x,y+1)>=thr?8:0);
    if(m===0||m===15)continue;
    const T=()=>hid(x,y),B=()=>hid(x,y+1),L=()=>vid(x,y),R=()=>vid(x+1,y);
    switch(m){case 1:case 14:addSeg(L(),T());break;case 2:case 13:addSeg(T(),R());break;case 3:case 12:addSeg(L(),R());break;case 4:case 11:addSeg(R(),B());break;
      case 5:addSeg(L(),T());addSeg(R(),B());break;case 6:case 9:addSeg(T(),B());break;case 7:case 8:addSeg(L(),B());break;case 10:addSeg(T(),R());addSeg(L(),B());break}
  }
  const seen=new Set(),loops=[];
  for(const id0 of adj.keys()){
    if(seen.has(id0))continue;const loop=[];let cur=id0;
    while(cur&&!seen.has(cur)){seen.add(cur);loop.push(pt.get(cur));cur=(adj.get(cur)||[]).find(n=>!seen.has(n))}
    if(loop.length>=3)loops.push(loop);
  }
  return loops;
}
function simplifyClosed(pts,eps){
  const n=pts.length;if(n<4)return pts;
  const dist=(p,a,b)=>{const dx=b[0]-a[0],dy=b[1]-a[1],L=Math.hypot(dx,dy)||1e-9;return Math.abs((p[0]-a[0])*dy-(p[1]-a[1])*dx)/L};
  const rdp=(arr)=>{if(arr.length<3)return arr;let md=0,mi=0;for(let i=1;i<arr.length-1;i++){const d=dist(arr[i],arr[0],arr[arr.length-1]);if(d>md){md=d;mi=i}}
    return md>eps?[...rdp(arr.slice(0,mi+1)).slice(0,-1),...rdp(arr.slice(mi))]:[arr[0],arr[arr.length-1]]};
  let fi_=0,fd=0;for(let i=1;i<n;i++){const d=Math.hypot(pts[i][0]-pts[0][0],pts[i][1]-pts[0][1]);if(d>fd){fd=d;fi_=i}}
  const a=rdp(pts.slice(0,fi_+1)),b=rdp([...pts.slice(fi_),pts[0]]);
  return [...a.slice(0,-1),...b.slice(0,-1)];
}
// combine specs with an operation; returns closed contours in scene coordinates (or null when nothing is left)
function boolContours(specs,op){
  let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;specs.forEach(sh=>{const b=specBox(sh);x0=Math.min(x0,b.x0);x1=Math.max(x1,b.x1);y0=Math.min(y0,b.y0);y1=Math.max(y1,b.y1)});
  const pad=3,bw=x1-x0+pad*2,bh=y1-y0+pad*2,R=Math.max(.5,Math.min(4,2400/Math.max(bw,bh)));x0-=pad;y0-=pad;
  const cv_=document.createElement('canvas');cv_.width=Math.ceil(bw*R);cv_.height=Math.ceil(bh*R);
  const g=cv_.getContext('2d',{willReadFrequently:true});g.setTransform(R,0,0,R,-x0*R,-y0*R);
  specs.forEach((sh,i)=>{
    const P=silhouetteOf(sh,{w:sh.w,h:sh.h,cr:sh.cr||0,ir:sh.ir==null?.45:sh.ir});if(!P)return;
    g.save();g.translate(sh.x,sh.y);g.rotate((sh.rot||0)*Math.PI/180);g.scale(sh.scale*(sh.flipX?-1:1),sh.scale*(sh.flipY?-1:1));
    g.globalCompositeOperation=i?(BOOL_COMP[op]||'source-over'):'source-over';g.fillStyle='#000';g.fill(P,ruleOf(P));g.restore();
  });
  const im=g.getImageData(0,0,cv_.width,cv_.height),loops=traceLoops(im.data,cv_.width,cv_.height,128);
  const out=loops.map(l=>simplifyClosed(l.map(([px,py])=>[x0+px/R,y0+py/R]),.18)).filter(l=>l.length>=3);
  return out.length?out:null;
}
// a closed path layer made of the contours (compound path, even-odd)
function pathFromContours(contours,props){
  let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;contours.forEach(c=>c.forEach(([x,y])=>{x0=Math.min(x0,x);x1=Math.max(x1,x);y0=Math.min(y0,y);y1=Math.max(y1,y)}));
  const w=Math.max(1,x1-x0),h=Math.max(1,y1-y0),cx=(x0+x1)/2,cy=(y0+y1)/2,subs=contours.map(c=>c.map(([x,y])=>[+((x-cx)/w).toFixed(5),+((y-cy)/h).toFixed(5)]));
  const biggest=subs.reduce((a,b)=>b.length>a.length?b:a,subs[0]);
  return{id:uid++,type:'path',x:cx,y:cy,w,h,pts:biggest,subs,closed:true,evenodd:true,rot:0,scale:1,opacity:1,tracks:{},tag:'',...BASEDEF,anims:[],fillOn:true,strokeW:0,stroke:'#111111',...props};
}
function boolOp(op){
  if(op==='flatten')return flattenSelection();
  const sel0=selNodes();
  if(sel0.length===1&&(sel0[0].type==='bool'||(sel0[0].type==='group'&&sel0[0].bool))){const g=sel0[0];if(g.type==='bool')g.op=op;else g.bool=op;g.name=BOOL_NAME[op];refresh();return}
  const nodes=topSelNodes().filter(boolOperand);
  if(nodes.length<2)return toast('Select two or more shapes');
  const ordered=[...nodes].sort((a,b)=>scene.layers.indexOf(a)-scene.layers.indexOf(b));
  const contours=boolContours(specsOf(ordered),op);
  if(!contours)return toast('Nothing is left after that operation');
  const base=ordered[0],topmost=ordered[ordered.length-1];
  const L=pathFromContours(contours,{name:BOOL_NAME[op],fill:base.fill,fillA:base.fillA,parent:parentKey(topmost)});
  if(base.fills)L.fills=JSON.parse(JSON.stringify(base.fills));
  scene.layers.splice(scene.layers.indexOf(topmost)+1,0,L);
  delNodes(nodes,true);selectOnly(L.id);refresh();toast(BOOL_NAME[op]+' applied');
}
// back to separate shapes
function releaseBool(l){
  const sx=l.w/(l.baseW||l.w),sy=l.h/(l.baseH||l.h),th=(l.rot||0)*Math.PI/180,co=Math.cos(th),si=Math.sin(th),at=scene.layers.indexOf(l),made=[];
  (l.shapes||[]).forEach((sh,i)=>{
    const ux=sh.x*sx*l.scale,uy=sh.y*sy*l.scale,n={id:uid++,name:(l.name||'Shape')+' '+(i+1),type:sh.type,fill:l.fill,fillOn:true,x:l.x+ux*co-uy*si,y:l.y+ux*si+uy*co,w:sh.w*sx*l.scale,h:sh.h*sy*l.scale,rot:(sh.rot||0)+(l.rot||0),scale:sh.scale,opacity:1,tracks:{},tag:'',...BASEDEF,anims:[],parent:l.parent==null?null:l.parent,
      cr:(sh.cr||0)*sx,crI:sh.crI,points:sh.points,ir:sh.ir,sides:sh.sides,pts:sh.pts,closed:sh.closed,flipX:sh.flipX,flipY:sh.flipY,strokeW:0};
    if(l.fills&&i===0)n.fills=JSON.parse(JSON.stringify(l.fills));
    rebuild(n);made.push(n)});
  scene.layers.splice(at,1,...made);return made.map(m=>m.id);
}
function flattenSelection(){
  const nodes=topSelNodes();if(!nodes.length)return toast('Select shapes to flatten');
  if(nodes.every(boolOperand)){
    const ordered=[...nodes].sort((a,b)=>scene.layers.indexOf(a)-scene.layers.indexOf(b)),contours=boolContours(specsOf(ordered),'union');
    if(contours){const topmost=ordered[ordered.length-1],L=pathFromContours(contours,{name:'Flattened',fill:ordered[0].fill,fillA:ordered[0].fillA,parent:parentKey(topmost)});
      if(ordered[0].fills)L.fills=JSON.parse(JSON.stringify(ordered[0].fills));
      scene.layers.splice(scene.layers.indexOf(topmost)+1,0,L);delNodes(nodes,true);selectOnly(L.id);refresh();toast('Flattened to a shape');return}
  }
  const all=nodes.flatMap(n=>[n,...(n.type==='group'?descendantsOf(n):[])]);
  const leaves=all.filter(x=>x.type!=='group'&&x.type!=='audio');if(!leaves.length)return;
  const bb=selBounds(leaves),pad=6,x0=bb.x0-pad,y0=bb.y0-pad,bw=bb.x1-bb.x0+pad*2,bh=bb.y1-bb.y0+pad*2;
  const k=Math.max(.5,Math.min(2,4096/Math.max(bw,bh))),tops=new Set(nodes.map(n=>n.id));
  const tmp={layers:all.map(x=>{const c2=JSON.parse(JSON.stringify({...x,src:undefined}));if(tops.has(x.id))c2.parent=null;return c2})};
  const cvx=document.createElement('canvas');cvx.width=Math.ceil(bw*k);cvx.height=Math.ceil(bh*k);
  const c=cvx.getContext('2d');c.setTransform(k,0,0,k,-x0*k,-y0*k);drawNodes(c,tmp,childrenIn(tmp,null),t,k,0,0);
  const idx=Math.max(...all.map(x=>scene.layers.indexOf(x))),url=cvx.toDataURL('image/png');
  const L=addLayer('image',{src:url,x:x0+bw/2,y:y0+bh/2,w:bw,h:bh,name:'Flattened'});
  scene.layers.splice(scene.layers.indexOf(L),1);scene.layers.splice(idx+1,0,L);
  const im=new Image();im.onload=()=>drawAll();im.src=url;imgs[L.id]=im;
  delNodes(nodes,true);selectOnly(L.id);refresh();toast('Flattened to an image');
}
// the header dropdown
const boolBtnHTML=()=>{const sel=selNodes(),cur_=sel.length===1?(sel[0].type==='bool'?sel[0].op:sel[0].bool)||'':'';
  return `<span class="boolwrap"><button class="bbtn" id="boolbtn" title="Boolean operations">${ic(cur_?'bool-'+cur_:'bool-union',16)}${ic('chevron-down',12)}</button><div class="menu dmenu" id="boolmenu">${BOOL_OPS.map(([id,nm,key,icn])=>`<div data-bool="${id}" class="${cur_===id?'sel':''}">${ic(icn,16)}<span>${nm}</span><kbd>${id==='flatten'?kbd('M','E'):kbd('AS',key)}</kbd></div>`).join('')}</div></span>`};
let boolHooked=false;
function hookBool(){
  if(boolHooked)return;boolHooked=true;
  $('rbody').addEventListener('click',e=>{
    const b=e.target.closest('#boolbtn'),it=e.target.closest('[data-bool]');
    if(b){e.stopPropagation();const m=$('boolmenu'),open=m.style.display==='block';document.querySelectorAll('.menu').forEach(x=>x.style.display='none');if(open)return;
      m.style.display='block';m.style.position='fixed';m.style.right='auto';const r=b.getBoundingClientRect(),mw=m.offsetWidth,mh=m.offsetHeight;
      m.style.left=Math.max(8,Math.min(innerWidth-mw-8,r.right-mw))+'px';m.style.top=Math.max(8,(innerHeight-r.bottom-8>=mh?r.bottom+4:r.top-mh-4))+'px';return}
    if(it){e.stopPropagation();document.querySelectorAll('.menu').forEach(x=>x.style.display='none');boolOp(it.dataset.bool)}
  });
}
function ungroupSelected(){
  const bools=selNodes().filter(n=>n.type==='bool');
  if(bools.length&&!selNodes().some(n=>n.type==='group')){const ids=bools.flatMap(releaseBool);selSet=new Set(ids);sel=ids[ids.length-1]??null;selKey=null;refresh();toast('Shapes released');return}
  const groups=selNodes().filter(n=>n.type==='group');if(!groups.length)return toast('Select a group to ungroup');
  const freed=[];
  groups.forEach(g=>{kidsOf(g).forEach(k=>{k.parent=parentKey(g);freed.push(k.id)});scene.layers=scene.layers.filter(l=>l!==g)});
  selSet=new Set(freed);sel=freed[freed.length-1]??null;refresh();
}
function maskSelected(){
  const nodes=topSelNodes();
  if(nodes.length===1&&nodes[0].type==='group'){nodes[0].mask=true;refresh();return toast('Top layer of the group now masks the ones below')}
  if(nodes.length<2)return toast('Select two or more layers: the top one becomes the mask');
  const g=groupSelected();if(g){g.mask=true;g.name='Mask group';refresh();toast('Top layer now masks the ones below')}
}
function removeMask(){
  const gs=selNodes().filter(n=>n.type==='group'&&n.mask);if(!gs.length)return toast('No mask group selected');
  gs.forEach(g=>{g.mask=false;if(g.name==='Mask group')g.name='Group'});refresh();
}
function setFlag(nodes,key,val){nodes.forEach(n=>{n[key]=val});refresh()}
function toggleFlag(nodes,key){if(!nodes.length)return;setFlag(nodes,key,!nodes.every(n=>n[key]))}
// walking the tree with the keyboard
const setSel=ids=>{selSet=new Set(ids);sel=ids.length?ids[ids.length-1]:null;selKey=null;refresh()};
function selectParent(){const ps=new Set();selNodes().forEach(n=>{const p=parentOf(n);ps.add(p?p.id:n.id)});if(ps.size)setSel([...ps])}
function selectChildren(){const out=[];selNodes().forEach(n=>{if(n.type==='group')kidsOf(n).forEach(k=>out.push(k.id))});if(out.length)setSel(out)}
function selectSibling(dir){
  const n=cur();if(!n)return;
  const s=childrenOf(scene.layers,parentKey(n));if(s.length<2)return;
  setSel([s[(s.indexOf(n)+dir+s.length)%s.length].id]);
}
function startRename(id){renaming=id;renderLayers()}
const startRenameSelected=()=>{const n=selNodes()[0];if(n)startRename(n.id);else toast('Select a layer to rename')};
function staggerSelected(delay=0.15){
  const ls=selected();if(ls.length<2)return toast('Select two or more layers to stagger');
  ls.forEach((l,i)=>{(l.anims||[]).forEach(a=>{a.start=+(a.start+i*delay).toFixed(3);scene.duration=Math.max(scene.duration,Math.ceil((a.start+a.dur)*10)/10)});rebuild(l)});
  refresh();toast(`Staggered by ${delay}s`);
}
// edit text right on the canvas: a transparent textarea sits over the layer while the canvas copy is hidden
let editingId=null,editEl=null;
function focusText(){const l=cur();if(l&&l.type==='text'&&isSingleLeaf())editTextOnCanvas(l)}
function editTextOnCanvas(l){
  if(editEl)endTextEdit();
  if(lockedDeep(l))return toast('Layer is locked');
  editingId=l.id;draw();
  const ta=document.createElement('textarea');ta.className='tedit';ta.value=l.text;ta.spellcheck=false;document.body.appendChild(ta);editEl=ta;
  const place=()=>{
    const s=state(l,t),bx=boxSize(l,s),r=cv.getBoundingClientRect(),z=r.width/W,fs=s.h*s.scale*z,lh=(bx.lay?bx.lay.lh:s.h*1.2)*s.scale*z;
    const w=Math.max(20,bx.w*s.scale*z+4),h=Math.max(lh,bx.h*s.scale*z);
    Object.assign(ta.style,{left:r.left+s.x*z-w/2+'px',top:r.top+s.y*z-h/2+'px',width:w+'px',height:h+'px',font:`${l.italic?'italic ':''}${l.weight} ${fs}px ${l.font}`,lineHeight:lh+'px',color:l.fill,textAlign:l.align,transform:`rotate(${s.rot}deg)`,letterSpacing:(l.ls*fs/100)+'px',whiteSpace:l.autoResize==='width'?'pre':'pre-wrap'});
  };
  place();
  ta.oninput=()=>{l.text=ta.value;fitText(l);if(l.autoResize==='height'||l.autoResize==='auto')rebuild(l);draw();place();commitLater()};
  ta.onkeydown=e=>{e.stopPropagation();if(e.key==='Escape'){e.preventDefault();endTextEdit()}else if(e.key==='Enter'&&(e.metaKey||e.ctrlKey)){e.preventDefault();endTextEdit()}};
  ta.onblur=()=>endTextEdit();
  ta.focus();ta.select();
}
function endTextEdit(){
  if(!editEl)return;const ta=editEl;editEl=null;editingId=null;
  ta.onblur=null;ta.remove();refresh();
}
function downloadPNG(){
  const prev=exporting;exporting=true;draw();
  cv.toBlob(b=>{const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=(project.title||'frame')+' - '+scene.name+'.png';a.click();exporting=prev;draw()});
}
function copyPNG(){
  const prev=exporting;exporting=true;draw();
  cv.toBlob(b=>{exporting=prev;draw();try{navigator.clipboard.write([new ClipboardItem({'image/png':b})]).then(()=>toast('Frame copied as PNG'),()=>toast('The browser blocked copying — use Download'))}catch(e){toast('Copying images is not supported here — use Download')}});
}
function zoomToSelection(){
  const ls=selected();if(!ls.length)return toast('Select something first');
  const bb=selBounds(ls),st=$('stage');
  const z=Math.max(.1,Math.min(4,Math.min((st.clientWidth-120)/Math.max(40,bb.x1-bb.x0),(st.clientHeight-170)/Math.max(40,bb.y1-bb.y0))));
  setZoom(z,true);
  setTimeout(()=>{const r=cv.getBoundingClientRect(),sr=st.getBoundingClientRect(),cx=(bb.x0+bb.x1)/2,cy=(bb.y0+bb.y1)/2;st.scrollLeft+=(r.left-sr.left+cx*z)-sr.width/2;st.scrollTop+=(r.top-sr.top+cy*z)-sr.height/2},30);
  toast('Zoom '+Math.round(z*100)+'%');
}
function menuAction(a){
  const nodes=topSelNodes();
  ({dup:()=>dupNodes(nodes),del:()=>delNodes(nodes),fwd:()=>arrange(nodes,'forward'),back:()=>arrange(nodes,'backward'),group:groupSelected,ungroup:ungroupSelected,mask:maskSelected,unmask:removeMask,
    hide:()=>toggleFlag(nodes,'hidden'),lock:()=>toggleFlag(nodes,'locked')})[a]();
}
function upsertKey(l,p,time,v){
  const ks=l.tracks[p]||(l.tracks[p]=[]);
  const ex=ks.find(k=>Math.abs(k.t-time)<0.02);
  if(ex)ex.v=v;else{ks.push({t:+time.toFixed(3),v,ease:'easeInOut'});ks.sort((a,b)=>a.t-b.t)}
}
function setProp(l,p,v){
  if(lockedDeep(l))return;
  if(!KEYFRAMES){
    // keyframes are derived from animations: edit the layer's base value and let the animations re-generate around it
    const c=state(l,t)[p];
    if(l.tracks[p]&&l.tracks[p].length){
      const mult=(p==='scale'||p==='opacity')&&Math.abs(c)>1e-6;
      l[p]=mult?l[p]*(v/c):l[p]+(v-c);
      if(p==='opacity')l.opacity=Math.max(0,Math.min(1,l.opacity));if(p==='cr')l.cr=Math.max(0,l.cr);rebuild(l);
    }else l[p]=v;
    return;
  }
  if(l.tracks[p]||(auto.checked&&t>0.001)){
    if(!l.tracks[p])l.tracks[p]=[{t:0,v:l[p],ease:'easeInOut'}];
    upsertKey(l,p,t,v);
  }else l[p]=v;
}
// ---------- video layers: an image layer whose picture is a <video>, kept in step with the timeline ----------
let exportLive=false;   // true while a real-time recording is running (videos must play on their own then)
const allVideos=new Set();   // every video element ever made, so none can be left playing behind the timeline
const pauseAllVideos=()=>allVideos.forEach(v=>{if(!v.paused)v.pause()});
function attachVideo(l,v){
  const old=imgs[l.id];if(old&&old!==v&&old.pause)old.pause();   // a replaced element must not keep playing
  allVideos.add(v);v.onplay=()=>{if(!playing&&!exportLive)v.pause()};   // anything that starts while the timeline is stopped is stopped again
  v.muted=true;v.preload='auto';v.playsInline=true;
  Object.defineProperty(v,'complete',{get:()=>v.readyState>1});   // so it passes everywhere an <img> does
  Object.defineProperty(v,'naturalWidth',{get:()=>v.videoWidth});Object.defineProperty(v,'naturalHeight',{get:()=>v.videoHeight});
  v.onloadeddata=()=>drawAll();v.onseeked=()=>{if(!playing&&!exporting)draw()};
  imgs[l.id]=v;
}
function loadImgEl(l){
  srcStore[l.id]=l.src;
  if(l.srcOrig){origStore[l.id]=l.srcOrig;delete l.srcOrig}
  if(l.matte){restoreMatte(l,l.matte);delete l.matte}
  if(l.video){const v=document.createElement('video');attachVideo(l,v);v.src=l.src}
  else{const im=new Image();im.onload=()=>drawAll();im.src=l.src;imgs[l.id]=im}
}
const videoTime=(l,v,time)=>{const want=time-inOf(l),dur=v.duration;return l.vloop===false?Math.max(0,Math.min(want,dur)):((want%dur)+dur)%dur};
function syncVideo(l,v,time){
  if(!v.duration)return;
  const tt=videoTime(l,v,time),inside=time>=inOf(l)&&time<outOf(l);
  if(l.vloop===false&&time-inOf(l)>=v.duration-.03){   // Loop off: hold the last frame (play() on a finished video would restart it)
    if(!v.paused)v.pause();if(!v.seeking&&Math.abs(v.currentTime-tt)>.02)v.currentTime=tt;return;
  }
  if((playing||exportLive)&&inside){
    const vol=Math.max(0,Math.min(1,l.vol==null?1:l.vol));v.muted=!!l.muted||vol<=0;v.volume=vol;
    if(v.paused){v.currentTime=tt;const p=v.play();if(p&&p.catch)p.catch(()=>{})}
    else if(Math.abs(v.currentTime-tt)>.35&&!v.seeking)v.currentTime=tt;
  }else{
    if(!v.paused)v.pause();
    if(!v.seeking&&Math.abs(v.currentTime-tt)>.02)v.currentTime=tt;
  }
}
// frame-exact exports: put every video on the right frame and wait until it has arrived
async function seekVideos(time){
  const ps=[];
  scene.layers.forEach(l=>{
    const v=l.video&&imgs[l.id];if(!v||!v.duration)return;
    if(!v.paused)v.pause();const tt=videoTime(l,v,time);if(Math.abs(v.currentTime-tt)<.001&&!v.seeking)return;
    ps.push(new Promise(ok=>{const done=()=>{v.removeEventListener('seeked',done);ok()};v.addEventListener('seeked',done);v.currentTime=tt;setTimeout(done,1500)}));
  });
  if(ps.length)await Promise.all(ps);
}

// ---------- background remover: pictures (Figma-style, one click, cut-out replaces the picture) · videos (CapCut-style auto removal, a mask for every frame) ----------
let bgJob=null;   // {id,label,cancel}
const bgBlob2URL=b=>new Promise(ok=>{const r=new FileReader();r.onload=()=>ok(r.result);r.readAsDataURL(b)});
const hasCutout=l=>l.video?!!matteStore[l.id]:!!(origStore[l.id]&&srcStore[l.id]!==origStore[l.id]);
function bgUpdateUI(){document.querySelectorAll('[data-bgbtn]').forEach(b=>{if(bgJob&&bgJob.id==+b.dataset.bgbtn){b.textContent=bgJob.label;b.disabled=false;b.dataset.bg='cancel'}})}
function bgProgress(l,label){bgJob.label=label;bgUpdateUI()}
async function removeImageBg(l){
  if(bgJob)return;
  bgJob={id:l.id,label:'Loading model…',cancel:false};renderRight();
  try{
    const lib=await import('https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.5.5/+esm');
    const blob=await(await fetch(srcStore[l.id]||l.src)).blob();
    const out=await lib.removeBackground(blob,{model:'medium',output:{format:'image/png'},progress:(key,cur,tot)=>{if(!bgJob)return;const pc=tot?Math.round(cur/tot*100):0;bgProgress(l,(String(key).startsWith('fetch')?'Downloading model ':'Removing background ')+pc+'%')}});
    if(bgJob&&bgJob.cancel)throw'cancel';
    const url=await bgBlob2URL(out);
    if(!origStore[l.id])origStore[l.id]=srcStore[l.id]||l.src;
    await new Promise((ok,no)=>{const im=new Image();im.onload=()=>{imgs[l.id]=im;ok()};im.onerror=no;im.src=url});
    l.src=url;srcStore[l.id]=url;toast('Background removed');
  }catch(e){if(e!=='cancel')toast('Couldn’t remove the background — check your connection and try again')}
  bgJob=null;rebuild(l);refresh();
}
function restoreImageBg(l){
  const o=origStore[l.id];if(!o)return;
  const im=new Image();im.onload=()=>{imgs[l.id]=im;l.src=o;srcStore[l.id]=o;delete origStore[l.id];refresh();toast('Background restored')};im.src=o;
}
let _seg=null;
async function loadSegmenter(){
  if(_seg)return _seg;
  const V='https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.14',mp=await import(V+'/vision_bundle.mjs'),fs=await mp.FilesetResolver.forVisionTasks(V+'/wasm');
  const mk=d=>mp.ImageSegmenter.createFromOptions(fs,{baseOptions:{modelAssetPath:'https://storage.googleapis.com/mediapipe-models/image_segmenter/selfie_segmenter/float16/latest/selfie_segmenter.tflite',...(d?{delegate:d}:{})},runningMode:'IMAGE',outputConfidenceMasks:true,outputCategoryMask:false});
  try{_seg=await mk('GPU')}catch(e){_seg=await mk()}
  return _seg;
}
const seekTo=(v,tm)=>new Promise(ok=>{if(Math.abs(v.currentTime-tm)<.001&&!v.seeking)return ok();const d=()=>{v.removeEventListener('seeked',d);ok()};v.addEventListener('seeked',d);v.currentTime=tm;setTimeout(d,2000)});
const matteCanvas=(w,h)=>{const c=document.createElement('canvas');c.width=w;c.height=h;Object.defineProperty(c,'naturalWidth',{get:()=>c.width});Object.defineProperty(c,'naturalHeight',{get:()=>c.height});Object.defineProperty(c,'complete',{get:()=>true});return c};
async function removeVideoBg(l){
  const v=imgs[l.id];if(bgJob||!v||!v.duration)return;
  if(playing)togglePlay();
  bgJob={id:l.id,label:'Loading model…',cancel:false};renderRight();
  try{
    const seg=await loadSegmenter(),fps=15,n=Math.max(1,Math.ceil(v.duration*fps)+1),frames=[];v.pause();
    for(let i=0;i<n;i++){
      if(bgJob.cancel)throw'cancel';
      await seekTo(v,Math.min(v.duration-.001,i/fps));
      const r=seg.segment(v),m=r.confidenceMasks[0],w=m.width,h=m.height,f=m.getAsFloat32Array(),c=matteCanvas(w,h),g=c.getContext('2d'),id=g.createImageData(w,h);
      for(let k=0;k<f.length;k++){let a=(f[k]-.3)/.4;a=a<0?0:a>1?1:a;id.data[k*4+3]=a*a*(3-2*a)*255}
      g.putImageData(id,0,0);frames.push(c);if(r.close)r.close();
      bgProgress(l,'Removing background '+Math.round((i+1)/n*100)+'%');
      if(i%3===2)await new Promise(r=>setTimeout(r));
    }
    matteStore[l.id]={fps,frames};l.cutout=true;toast('Background removed');
  }catch(e){if(e!=='cancel')toast('Couldn’t remove the background — check your connection and try again')}
  bgJob=null;t=Math.min(t,scene.duration);rebuild(l);refresh();
}
function restoreMatte(l,m){   // from a saved file: PNG masks back into canvases
  Promise.all(m.frames.map(u=>new Promise(ok=>{const im=new Image();im.onload=()=>{const c=matteCanvas(im.width,im.height);c.getContext('2d').drawImage(im,0,0);ok(c)};im.onerror=()=>ok(null);im.src=u})))
    .then(fr=>{if(fr.every(Boolean)){matteStore[l.id]={fps:m.fps,frames:fr};drawAll()}});
}
function bgSection(l){
  const FS=(title,inner)=>`<div class="fsec"><div class="fhd"><span>${title}</span><span class="fact"></span></div>${inner||''}</div>`;
  const busy=bgJob&&bgJob.id===l.id,wand='<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4V2M15 16v-2M8 9h2M20 9h2M17.8 11.8L19 13M17.8 6.2L19 5M12.2 6.2L11 5M3 21l9-9"/></svg>';
  if(l.video){
    const on=hasCutout(l)&&l.cutout!==false;
    return FS('Background',busy?`<button class="bgbtn" data-bgbtn="${l.id}" data-bg="cancel">${esc(bgJob.label)}</button>`
      :on?`<button class="bgbtn" data-bg="toggle">Restore background</button>`:`<button class="bgbtn pri" data-bg="toggle">${wand}Remove background</button>`);
  }
  return FS('Background',busy?`<button class="bgbtn" data-bgbtn="${l.id}" data-bg="cancel">${esc(bgJob.label)}</button>`
    :hasCutout(l)?`<button class="bgbtn" data-bg="restore">Restore background</button>`:`<button class="bgbtn pri" data-bg="remove">${wand}Remove background</button>`);
}
(()=>{const st=document.createElement('style');st.textContent=`.bgbtn{width:100%;height:34px;border:0;border-radius:0;background:#ececf0;font:inherit;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px}.bgbtn:hover{background:#e2e2e8}.bgbtn.pri{background:#7a3ff2;color:#fff}.bgbtn.pri:hover{background:#6a2fe2}.bghint{font-size:11px;color:#8a8a94;line-height:1.5;margin-top:6px}`;document.head.appendChild(st)})();
function addVideoFile(f,at){
  if(f.size>150*1024*1024)return toast('That video is over 150 MB');
  toast('Adding video…');
  const url=URL.createObjectURL(f),v=document.createElement('video');v.src=url;v.muted=true;v.preload='auto';
  v.onerror=()=>toast('This browser can\u2019t play that video format');
  v.onloadedmetadata=()=>{
    if(!v.videoWidth)return toast('This browser can\u2019t play that video format');
    const m=Math.min(1,600/Math.max(v.videoWidth,v.videoHeight)),r=new FileReader();
    r.onload=()=>{
      const t0=+t.toFixed(2),l=addLayer('image',{src:r.result,video:true,inT:t0,outT:+(t0+v.duration).toFixed(2),w:Math.round(v.videoWidth*m),h:Math.round(v.videoHeight*m),name:f.name.slice(0,22),...(at||{})});
      attachVideo(l,v);   // the file's own blob URL plays; the data URL is kept for saving
      scene.duration=Math.max(scene.duration,Math.min(60,Math.ceil(v.duration*10)/10));
      drawAll();refresh();toast('Video added');
    };
    r.readAsDataURL(f);
  };
}
function addImageFile(f,at){
  const r=new FileReader();
  r.onload=()=>{const im=new Image();im.onerror=()=>toast('Couldn\u2019t read that image');im.onload=()=>{
    const m=Math.min(1,600/Math.max(im.width,im.height));
    const l=addLayer('image',{src:r.result,w:Math.round(im.width*m),h:Math.round(im.height*m),name:f.name.slice(0,22),...(at||{})});
    imgs[l.id]=im;drawAll();
  };im.src=r.result};
  r.readAsDataURL(f);
}
$('file').onchange=e=>{
  const f=e.target.files[0];if(!f)return;
  if(f.type.startsWith('video/'))addVideoFile(f);else addImageFile(f);
  e.target.value='';
};
$('key').onclick=()=>{const ls=selected();if(!ls.length)return toast('Select a layer first');ls.forEach(l=>{const s=state(l,t);TPROPS.forEach(p=>upsertKey(l,p,t,s[p]))});refresh()};

let drag=null;
const pt=e=>{const r=cv.getBoundingClientRect();return{x:(e.clientX-r.left)*W/r.width,y:(e.clientY-r.top)*H/r.height}};
function layerBox(l,time){const s=state(l,time),b=boxSize(l,s);return{s,hw:b.w*s.scale/2,hh:b.h*s.scale/2}}
function layerAt(m){
  for(const l of paintOrder().reverse()){
    if(l.type==='audio'||!visibleAt(l,t)||hiddenDeep(l)||lockedDeep(l))continue;
    const{s,hw,hh}=layerBox(l,t);
    if(Math.abs(m.x-s.x)<=hw&&Math.abs(m.y-s.y)<=hh)return l;
  }
  return null;
}
// clicking a layer inside a group selects the outermost group, unless that group (or something inside it) is already selected
function pickNode(leaf){
  const chain=[leaf];for(let p=parentOf(leaf);p;p=parentOf(p))chain.push(p);
  return chain.find(n=>selSet.has(n.id))||chain[chain.length-1];
}
let tool='select',pan=null,ratioLock=true;   // proportions are locked until you unlock them (Shift also locks them while held)
var toolbarReady=false;
function setTool(name){
  if(tool==='pen'&&name!=='pen'&&pen.pts.length)finishPen(false);
  if(tool==='comment'&&name!=='comment')closeThread(true);
  tool=name;
  if(tool==='direct'&&name!=='direct'&&pe)pe=null;
  if(name!=='join')joinSel=null;
  xhover=null;if(xs){clearInterval(xs.tick);xs=null}
  if(toolbarReady)for(const g in TGROUPS)if(TGROUPS[g].some(x=>x.id===name)&&tcur[g]!==name){tcur[g]=name;buildToolbar()}
  if(toolbarReady){syncToolbar();syncBrushPanel()}
  document.body.classList.toggle('handtool',tool==='hand');
  canvases.forEach(c=>{c.style.cursor=tool==='select'?'':tool==='hand'?'grab':tool==='comment'?'copy':'crosshair'});
}
// ---------- floating toolbar: insert · collaborate · actions ----------
