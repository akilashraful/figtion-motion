    const x=Math.min(marquee.x0,marquee.x1),y=Math.min(marquee.y0,marquee.y1),w=Math.abs(marquee.x1-marquee.x0),h=Math.abs(marquee.y1-marquee.y0);
    if(!marquee.create){c.fillStyle='rgba(122,63,242,.12)';c.fillRect(x,y,w,h)}
    c.save();c.strokeStyle='#7a3ff2';c.lineWidth=1.5/viewZ;if(marquee.create)c.setLineDash([6/viewZ,4/viewZ]);c.strokeRect(x,y,w,h);c.restore();
  }
