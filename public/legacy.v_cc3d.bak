function render(c,sc,time,showSel,k=1,ox=0){
  syncAreaText(sc,time);
  c.setTransform(1,0,0,1,0,0);c.clearRect(0,0,c.canvas.width,c.canvas.height);
  c.setTransform(k,0,0,k,ox,0);
  if(sc.bgOn!==false){c.fillStyle=sc.bg;c.fillRect(0,0,sc.w||1280,sc.h||720)}
  drawNodes(c,sc,childrenIn(sc,null),time,k,ox,0);
  if(showSel)drawOverlay(c,time);
}

const inOf=l=>l.inT||0,outOf=l=>l.outT==null?scene.duration:l.outT;
const EMPTY_LEN=4,MAXT=60;
function calcDuration(f){
  const ends=[];f.layers.forEach(l=>{(l.anims||[]).forEach(a=>ends.push(a.start+a.dur));if((l.type==='audio'||l.video)&&l.outT!=null)ends.push(l.outT)});   // audio / video bars count too
  return ends.length?Math.max(0.5,+Math.max(...ends).toFixed(2)):EMPTY_LEN;
}
function autoDuration(){
  project.frames.forEach(f=>{f.duration=calcDuration(f)});
  if(t>scene.duration)t=scene.duration;
}
const visibleAt=(l,time)=>time>=(l.inT||0)-1e-6&&(l.outT==null||time<=l.outT+1e-6);
const draw=()=>render(ctx,scene,t,!exporting);
function drawAll(){project.frames.forEach((f,i)=>{if(i===fi)render(ctx,f,t,!exporting);else render(canvases[i].getContext('2d'),f,0,false)})}
const fmt=n=>n%1?n.toFixed(1):String(n);

// ---------- editing ----------
const cur=()=>scene.layers.find(l=>l.id===sel);
const isMac=/Mac|iPhone|iPad/.test(navigator.platform);
// ---------- layer tree: a group is a layer of type "group"; its children point at it with .parent ----------
const byId=id=>scene.layers.find(l=>l.id===id);
const parentKey=l=>l.parent==null?null:l.parent;
const childrenOf=(list,pid)=>list.filter(x=>parentKey(x)===pid);          // array order = z-order (back → front)
const kidsOf=g=>childrenOf(scene.layers,g.id);
const parentOf=l=>l.parent!=null?(byId(l.parent)||null):null;
function topAncestor(l){let n=l;for(let p=parentOf(n);p;p=parentOf(n))n=p;return n}
const hiddenDeep=l=>{for(let n=l;n;n=parentOf(n))if(n.hidden)return true;return false};
const lockedDeep=l=>{if(scene.locked)return true;for(let n=l;n;n=parentOf(n))if(n.locked)return true;return false};
function leavesOfNode(n,out=[]){if(n.type!=='group'){out.push(n);return out}kidsOf(n).forEach(k=>leavesOfNode(k,out));return out}
function descendantsOf(n,out=[]){kidsOf(n).forEach(k=>{out.push(k);if(k.type==='group')descendantsOf(k,out)});return out}
function paintOrder(){const out=[];const walk=list=>list.forEach(n=>{if(n.type==='group')walk(kidsOf(n));else out.push(n)});walk(childrenOf(scene.layers,null));return out}
const selNodes=()=>scene.layers.filter(l=>selSet.has(l.id));
function topSelNodes(){const ids=new Set(selNodes().map(n=>n.id));return selNodes().filter(n=>{for(let p=parentOf(n);p;p=parentOf(p))if(ids.has(p.id))return false;return true})}
const selected=()=>{const set=new Set();selNodes().forEach(n=>leavesOfNode(n).forEach(l=>set.add(l.id)));return paintOrder().filter(l=>set.has(l.id))};
const isSingleLeaf=()=>selSet.size===1&&!!cur()&&cur().type!=='group';
const isMulti=()=>selected().length>1||(!!cur()&&cur().type==='group');
const selTitle=ls=>{const ns=selNodes();return ns.length===1&&ns[0].type==='group'?`${ns[0].name} · ${ls.length} layer${ls.length===1?'':'s'}`:`${ls.length} layers`};
const MENU_KEYS={dup:()=>kbd('M','D'),group:()=>kbd('M','G'),ungroup:()=>kbd('MS','G'),mask:()=>isMac?'⌃⌘M':'Ctrl+Alt+M',unmask:()=>isMac?'⌃⇧⌘M':'Ctrl+Alt+Shift+M',fwd:()=>kbd('MS',']'),back:()=>kbd('MS','['),hide:()=>kbd('MS','H'),lock:()=>kbd('MS','L'),del:()=>isMac?'⌫':'Del'};
const MENU_HTML=()=>`<div class="menu" id="menu"><div data-m="dup"><span>Duplicate</span><kbd>${MENU_KEYS.dup()}</kbd></div><div data-m="group"><span>Group</span><kbd>${MENU_KEYS.group()}</kbd></div><div data-m="ungroup"><span>Ungroup</span><kbd>${MENU_KEYS.ungroup()}</kbd></div><div data-m="mask"><span>Mask selection</span><kbd>${MENU_KEYS.mask()}</kbd></div><div data-m="unmask"><span>Remove mask</span><kbd>${MENU_KEYS.unmask()}</kbd></div><div data-m="fwd"><span>Bring forward</span><kbd>${MENU_KEYS.fwd()}</kbd></div><div data-m="back"><span>Send backward</span><kbd>${MENU_KEYS.back()}</kbd></div><div data-m="hide"><span>Hide / show</span><kbd>${MENU_KEYS.hide()}</kbd></div><div data-m="lock"><span>Lock / unlock</span><kbd>${MENU_KEYS.lock()}</kbd></div><div data-m="del"><span>Delete</span><kbd>${MENU_KEYS.del()}</kbd></div></div>`;
let renaming=null;

let opKey={d:'',t:0};   // first digit of an opacity shortcut, waiting for a possible second one
let barAnchor=null;
const barSet=new Set();   // 'layerId:animIndex' of every selected animation bar (Shift + right-click adds more)
let barSel=false,loopRange=null;   // barSel: an animation bar is selected; playing then loops just that bar
function selectOnly(id){barSel=false;barSet.clear();barAnchor=null;if(typeof pe!=='undefined'&&pe&&pe.id!==id)pe=null;sel=id;selSet=id==null?new Set():new Set([id])}
function toggleSel(id){
  if(selSet.has(id)){selSet.delete(id);if(sel===id)sel=selSet.size?[...selSet].pop():null}
  else{selSet.add(id);sel=id}
}
function syncSel(){
  const ids=new Set(scene.layers.map(l=>l.id));
  scene.layers.forEach(l=>{if(l.parent!=null&&!ids.has(l.parent))l.parent=null});
  if(sel==null||!ids.has(sel)){if(sel!=null||!selSet.size){sel=null;selSet.clear();return}}
  if(!selSet.has(sel))selSet=new Set([sel]);
  selSet.forEach(i=>{if(!ids.has(i))selSet.delete(i)});
  if(!selSet.size)sel=null;
}
function addLayer(type,extra={}){
  const id=uid++;
  const l={id,name:type[0].toUpperCase()+type.slice(1)+' '+id,type,fill:['#7a3ff2','#ff5c8a','#26c6a6','#ffb020'][id%4],text:'Hello',
    x:W/2,y:H/2,w:240,h:type==='text'?60:240,rot:0,scale:1,opacity:1,tracks:{},tag:'',...BASEDEF,anims:[],...extra};
  if(type==='text')l.fill='#111111';
  fitText(l);if(l.src)srcStore[l.id]=l.src;
  scene.layers.push(l);selectOnly(l.id);ptab='design';refresh();return l;
}
function dupNodes(nodes,noOffset){
  if(!nodes.length)return;
  const roots=[];
  const idm=new Map();
  nodes.forEach(n=>{
    const cl=[];
    const walk=(x,newParent)=>{
      const c=JSON.parse(JSON.stringify(x)),nid=uid++;c.id=nid;c.parent=newParent;idm.set(x.id,nid);
      if(imgs[x.id])imgs[nid]=imgs[x.id];if(srcStore[x.id])srcStore[nid]=srcStore[x.id];
      cl.push(c);if(x.type==='group')kidsOf(x).forEach(k=>walk(k,nid));return c;
    };
    const root=walk(n,parentKey(n));root.name=n.name+' copy';
    cl.forEach(c=>{if(c.clipId!=null&&idm.has(c.clipId))c.clipId=idm.get(c.clipId);if(c.type!=='group'){if(!noOffset){c.x+=24;c.y+=24}rebuild(c)}});
    scene.layers.splice(scene.layers.indexOf(n)+1,0,...cl);roots.push(root.id);
  });
  selSet=new Set(roots);sel=roots[roots.length-1];refresh();
}
const dupLayers=dupNodes;
// copy / paste: an in-app clipboard of layer trees (image data included), pasted into whichever frame is active
// ---------- copy / paste / placing: layers, groups and whole frames (follows how Jitter places pasted content) ----------
//  · layers pasted with a layer selected go into that layer's frame/group, directly above it, in place
//  · if they would land outside the target frame they are centred in it (relative offsets kept)
//  · with a frame selected they go on top of that frame; with nothing selected they get a new frame of their own
//  · frames pasted with nothing selected (or onto a frame of the same size) become new frames next to the current one;
//    otherwise each frame is turned into a group inside the target frame
//  · the pasted content is selected and scrolled into view
let clip=[],clipFrames=[],clipBounds=null,pasteN=0;
function copyNodes(){
  const nodes=topSelNodes();
  if(!nodes.length){
    if(frameSel){
      const f=JSON.parse(JSON.stringify(scene));project.frames[fi].layers.forEach((l,i)=>{if((l.type==='image'||l.type==='audio')&&!f.layers[i].src)f.layers[i].src=srcStore[l.id]});
      clipFrames=[f];clip=[];clipBounds=null;pasteN=0;writeSystemClip();toast('Copied frame');return;
    }
    return toast('Select something to copy');
  }
  clipFrames=[];
  clip=nodes.map(n=>[n,...(n.type==='group'?descendantsOf(n):[])].map(x=>{const c=JSON.parse(JSON.stringify(x));if(x.type==='image'||x.type==='audio')c.src=srcStore[x.id]||x.src;return c}));
  const bb=selBounds(selected());clipBounds={x0:bb.x0,x1:bb.x1,y0:bb.y0,y1:bb.y1};
  pasteN=0;writeSystemClip();toast(`Copied ${nodes.length} layer${nodes.length>1?'s':''}`);
}
const copyLayers=copyNodes;
const revealPasted=()=>setTimeout(()=>{try{cv.scrollIntoView({block:'nearest',inline:'nearest',behavior:'smooth'})}catch(e){}},60);
// clone a list of layers with fresh ids, remapped parents and clip references
function cloneLayerList(list,rootParent){
  const map=new Map();list.forEach(c=>map.set(c.id,uid++));
  return list.map(src=>{
    const c=JSON.parse(JSON.stringify(src));c.id=map.get(src.id);c.parent=map.has(src.parent)?map.get(src.parent):rootParent;
    if(c.clipId!=null)c.clipId=map.get(c.clipId);
    if(c.type==='image'&&c.src){loadImgEl(c)}
    if(c.type==='audio'&&c.src)srcStore[c.id]=c.src;
    return c;
  });
}
function pasteNodes(replace){
  if(clipFrames.length&&!clip.length)return pasteFrames(replace);
  if(!clip.length)return toast('Nothing copied yet');
  let center=null;
  if(replace){const ls=selected();if(ls.length){const bb=selBounds(ls);center={x:(bb.x0+bb.x1)/2,y:(bb.y0+bb.y1)/2};delNodes(topSelNodes(),true)}}
  const hadSel=selSet.size>0,hadFrame=frameSel&&!hadSel;
  let insertAt=scene.layers.length,parentId=null,forceCenter=false;
  if(!replace&&hadSel){
    const tops=topSelNodes(),all=tops.flatMap(n=>[n,...(n.type==='group'?descendantsOf(n):[])]);
    insertAt=Math.max(...all.map(x=>scene.layers.indexOf(x)))+1;parentId=parentKey(tops[tops.length-1]);
  }else if(!replace&&!hadFrame){      // nothing selected: the layers get a frame of their own
    const f={id:Date.now(),name:'Frame '+(project.frames.length+1),duration:4,bg:'#ffffff',w:W,h:H,layers:[]};
    project.frames.splice(fi+1,0,f);switchFrame(fi+1);insertAt=0;forceCenter=true;
  }
  let dx=0,dy=0;
  if(clipBounds&&!replace){
    const b=clipBounds,outX=b.x1<0||b.x0>W,outY=b.y1<0||b.y0>H;
    if(forceCenter||outX||outY){dx=W/2-(b.x0+b.x1)/2;dy=H/2-(b.y0+b.y1)/2}
  }
  const roots=[];let at=insertAt;
  clip.forEach(tree=>{
    const made=cloneLayerList(tree,parentId);
    made.forEach(c=>{if(c.type!=='group'){c.x+=dx;c.y+=dy}});
    made.forEach(c=>{if(c.type!=='group')rebuild(c)});
    scene.layers.splice(at,0,...made);at+=made.length;roots.push(made[0].id);
  });
  selSet=new Set(roots);sel=roots[roots.length-1];frameSel=false;
  if(center){const ls=selected(),bb=selBounds(ls),cx=center.x-(bb.x0+bb.x1)/2,cy=center.y-(bb.y0+bb.y1)/2;ls.forEach(l=>{l.x+=cx;l.y+=cy;rebuild(l)})}
  selKey=null;refresh();revealPasted();toast(`${replace?'Replaced with':'Pasted'} ${roots.length} layer${roots.length>1?'s':''}`);
}
const pasteLayers=()=>pasteNodes(false);
function pasteFrames(replace){
  const F=clipFrames,hadSel=selSet.size>0,hadFrame=frameSel&&!hadSel;
  const tw=scene.w||1280,th=scene.h||720,same=F.every(f=>(f.w||1280)===tw&&(f.h||720)===th);
  const asFrames=(!hadSel&&!hadFrame)||(hadFrame&&same);
  if(asFrames){
    let at=fi+1,first=at;
    F.forEach(src=>{
      const f=JSON.parse(JSON.stringify(src));f.id=Date.now()+at;
      if(project.frames.some(x=>x.name===f.name))f.name+=' copy';
      f.layers=cloneLayerList(f.layers,null);f.layers.forEach(l=>{if(l.type!=='group')rebuild(l)});
      project.frames.splice(at,0,f);at++;
    });
    switchFrame(first);selectFrame();revealPasted();toast(`Pasted ${F.length} frame${F.length>1?'s':''}`);return;
  }
  // otherwise each frame becomes a group inside the target frame, centred
  let insertAt=scene.layers.length,parentId=null;
  if(hadSel){const tops=topSelNodes(),all=tops.flatMap(n=>[n,...(n.type==='group'?descendantsOf(n):[])]);insertAt=Math.max(...all.map(x=>scene.layers.indexOf(x)))+1;parentId=parentKey(tops[tops.length-1])}
  const roots=[];
  F.forEach(src=>{
    const fw=src.w||1280,fh=src.h||720,dx=tw/2-fw/2,dy=th/2-fh/2,layers=cloneLayerList(JSON.parse(JSON.stringify(src.layers)),null);
    const g={id:uid++,type:'group',name:src.name,x:tw/2,y:th/2,w:fw,h:fh,rot:0,scale:1,opacity:1,tracks:{},tag:'',...BASEDEF,anims:[],parent:parentId,expanded:true,mask:false};
    layers.forEach(l=>{if(l.parent==null)l.parent=g.id;if(l.type!=='group'){l.x+=dx;l.y+=dy}});
    const parts=[g];
    if(src.bgOn!==false&&src.bg)parts.push({id:uid++,type:'rect',name:src.name+' background',x:tw/2,y:th/2,w:fw,h:fh,rot:0,scale:1,opacity:1,tracks:{},tag:'',...BASEDEF,anims:[],fill:src.bg,fillOn:true,strokeW:0,parent:g.id});
    parts.push(...layers);parts.forEach(l=>{if(l.type!=='group')rebuild(l)});
    scene.layers.splice(insertAt,0,...parts);insertAt+=parts.length;roots.push(g.id);
  });
  selSet=new Set(roots);sel=roots[roots.length-1];frameSel=false;selKey=null;refresh();revealPasted();toast(`Pasted ${F.length} frame${F.length>1?'s':''} as group${F.length>1?'s':''}`);
}
// ---------- paste from Figma: plugin JSON, Copy-as-SVG, images, and our own copied layers ----------
const hex2=n=>Math.max(0,Math.min(255,Math.round(n))).toString(16).padStart(2,'0');
const figHex=c=>c?'#'+hex2((c.r||0)*255)+hex2((c.g||0)*255)+hex2((c.b||0)*255):'#cccccc';
function mkLayer(type,props){
  const l={id:uid++,name:type[0].toUpperCase()+type.slice(1),type,fill:'#cccccc',x:0,y:0,w:100,h:100,rot:0,scale:1,opacity:1,tracks:{},tag:'',...BASEDEF,anims:[],...props};
  if(type==='group'){l.expanded=true;l.mask=false}
  return l;
}
const mMul=(A,B)=>[A[0]*B[0]+A[2]*B[1],A[1]*B[0]+A[3]*B[1],A[0]*B[2]+A[2]*B[3],A[1]*B[2]+A[3]*B[3],A[0]*B[4]+A[2]*B[5]+A[4],A[1]*B[4]+A[3]*B[5]+A[5]];
const mInv=A=>{const d=A[0]*A[3]-A[1]*A[2]||1e-9;return[A[3]/d,-A[1]/d,-A[2]/d,A[0]/d,(A[2]*A[5]-A[3]*A[4])/d,(A[1]*A[4]-A[0]*A[5])/d]};
// a Figma gradient paint -> svg <defs> (user space = the node's own pixels), so vectors keep their real gradients
function svgGradDef(f,w,h,id){
  if(!f||!/GRADIENT/.test(f.type||'')||!f.gradientStops||!f.gradientStops.length)return null;
  w=Math.max(w,1);h=Math.max(h,1);const m=f.m||[1,0,0,0,1,0],M=[m[0],m[3],m[1],m[4],m[2],m[5]],Tg=mMul([w,0,0,h,0,0],mInv(M)),r=v=>+v.toFixed(5);
  const stops=f.gradientStops.map(st=>{const c=st.color||{},a=(c.a==null?1:c.a)*(f.opacity==null?1:f.opacity);return`<stop offset="${r(st.position)}" stop-color="rgb(${Math.round((c.r||0)*255)},${Math.round((c.g||0)*255)},${Math.round((c.b||0)*255)})" stop-opacity="${r(a)}"/>`}).join('');
  const gt=`gradientTransform="matrix(${Tg.map(r).join(' ')})"`;
  return f.type==='GRADIENT_LINEAR'
    ?`<linearGradient id="${id}" gradientUnits="userSpaceOnUse" x1="0" y1="0.5" x2="1" y2="0.5" ${gt}>${stops}</linearGradient>`
    :`<radialGradient id="${id}" gradientUnits="userSpaceOnUse" cx="0.5" cy="0.5" r="0.5" ${gt}>${stops}</radialGradient>`;
}
// svg path data -> list of subpaths of points (curves are flattened)
function flattenPath(d){
  const toks=String(d).match(/[a-zA-Z]|-?\d*\.?\d+(?:e[-+]?\d+)?/gi)||[];let i=0,cmd='',x=0,y=0,sx=0,sy=0,px=0,py=0,pc='';
  const subs=[];let cur=null;const num=()=>parseFloat(toks[i++]);
  const push=(a,b)=>{if(!cur){cur={pts:[],closed:false};subs.push(cur)}cur.pts.push([a,b]);x=a;y=b};
  const cub=(x1,y1,x2,y2,x3,y3)=>{const x0=x,y0=y;for(let k=1;k<=12;k++){const t=k/12,u=1-t;push(u*u*u*x0+3*u*u*t*x1+3*u*t*t*x2+t*t*t*x3,u*u*u*y0+3*u*u*t*y1+3*u*t*t*y2+t*t*t*y3)}px=x2;py=y2};
  const quad=(x1,y1,x2,y2)=>{const x0=x,y0=y;for(let k=1;k<=10;k++){const t=k/10,u=1-t;push(u*u*x0+2*u*t*x1+t*t*x2,u*u*y0+2*u*t*y1+t*t*y2)}px=x1;py=y1};
  const arc=(rx,ry,phi,fa,fs,x2,y2)=>{
    const x1=x,y1=y;if(!rx||!ry){push(x2,y2);return}rx=Math.abs(rx);ry=Math.abs(ry);const p=phi*Math.PI/180,c=Math.cos(p),s=Math.sin(p);
    const dx=(x1-x2)/2,dy=(y1-y2)/2,xp=c*dx+s*dy,yp=-s*dx+c*dy,lam=xp*xp/(rx*rx)+yp*yp/(ry*ry);if(lam>1){rx*=Math.sqrt(lam);ry*=Math.sqrt(lam)}
    const num_=rx*rx*ry*ry-rx*rx*yp*yp-ry*ry*xp*xp,den=rx*rx*yp*yp+ry*ry*xp*xp,co=(fa===fs?-1:1)*Math.sqrt(Math.max(0,num_/den)),cxp=co*rx*yp/ry,cyp=-co*ry*xp/rx;
    const cx=c*cxp-s*cyp+(x1+x2)/2,cy=s*cxp+c*cyp+(y1+y2)/2,ang=(ux,uy,vx,vy)=>Math.atan2(ux*vy-uy*vx,ux*vx+uy*vy);
    const t1=ang(1,0,(xp-cxp)/rx,(yp-cyp)/ry);let dt=ang((xp-cxp)/rx,(yp-cyp)/ry,(-xp-cxp)/rx,(-yp-cyp)/ry);
    if(!fs&&dt>0)dt-=2*Math.PI;else if(fs&&dt<0)dt+=2*Math.PI;
    const n=Math.max(4,Math.ceil(Math.abs(dt)/(Math.PI/12)));
    for(let k=1;k<=n;k++){const t=t1+dt*k/n,ex=rx*Math.cos(t),ey=ry*Math.sin(t);push(c*ex-s*ey+cx,s*ex+c*ey+cy)}
  };
  while(i<toks.length){
    if(/[a-zA-Z]/.test(toks[i]))cmd=toks[i++];
    const rel=cmd===cmd.toLowerCase(),C=cmd.toUpperCase(),ox=rel?x:0,oy=rel?y:0;
    if(C==='M'){const a=num()+ox,b=num()+oy;cur=null;push(a,b);sx=a;sy=b;cmd=rel?'l':'L';pc='M'}
    else if(C==='L'){push(num()+ox,num()+oy);pc='L'}
    else if(C==='H'){push(num()+ox,y);pc='L'}
    else if(C==='V'){push(x,num()+oy);pc='L'}
    else if(C==='C'){const a=num()+ox,b=num()+oy,c2=num()+ox,d2=num()+oy,e=num()+ox,f=num()+oy;cub(a,b,c2,d2,e,f);pc='C'}
    else if(C==='S'){const rx_=pc==='C'?2*x-px:x,ry_=pc==='C'?2*y-py:y,c2=num()+ox,d2=num()+oy,e=num()+ox,f=num()+oy;cub(rx_,ry_,c2,d2,e,f);pc='C'}
    else if(C==='Q'){const a=num()+ox,b=num()+oy,e=num()+ox,f=num()+oy;quad(a,b,e,f);pc='Q'}
    else if(C==='T'){const a=pc==='Q'?2*x-px:x,b=pc==='Q'?2*y-py:y,e=num()+ox,f=num()+oy;quad(a,b,e,f);pc='Q'}
    else if(C==='A'){const rx=num(),ry=num(),ph=num(),fa=num(),fs=num(),e=num()+ox,f=num()+oy;arc(rx,ry,ph,fa,fs,e,f);pc='A'}
    else if(C==='Z'){if(cur){cur.closed=true;x=sx;y=sy;cur=null}pc='Z'}
    else i++;
  }
  return subs.filter(s=>s.pts.length>1);
}
// a polyline layer from absolute points (same format the pen tool makes)
function pathLayer(pts,closed,props){
  let x0=1e9,y0=1e9,x1=-1e9,y1=-1e9;pts.forEach(([x,y])=>{x0=Math.min(x0,x);y0=Math.min(y0,y);x1=Math.max(x1,x);y1=Math.max(y1,y)});
  const w=Math.max(1,x1-x0),h=Math.max(1,y1-y0),cx=(x0+x1)/2,cy=(y0+y1)/2;
  return mkLayer('path',{x:cx,y:cy,w,h,pts:pts.map(([x,y])=>[(x-cx)/w,(y-cy)/h]),closed,...props});
}
// ---- SVG (what Figma gives for "Copy as SVG")
function svgToItems(text){
  const doc=new DOMParser().parseFromString(text,'image/svg+xml'),svg=doc.documentElement;
  if(!svg||svg.nodeName.toLowerCase()!=='svg'||doc.querySelector('parsererror'))return null;
