async function decodeFigmaHtml(html){
  const m=html.match(/\(figma\)([A-Za-z0-9+/_=-]+)/);if(!m)return null;
  let meta={};try{const fm=html.match(/\(figmeta\)([A-Za-z0-9+/_=-]+)/);if(fm)meta=JSON.parse(atob(fm[1].replace(/-/g,'+').replace(/_/g,'/')))}catch(e){}
  const u8=b64bytes(m[1]);
  if(String.fromCharCode(...u8.subarray(0,8))!=='fig-kiwi')throw new Error('not fig-kiwi');
  const dv=new DataView(u8.buffer,u8.byteOffset),chunks=[];let p=12;
  while(p+4<=u8.length){const n=dv.getUint32(p,true);p+=4;chunks.push(u8.subarray(p,p+n));p+=n}
  const defs=kiwiSchema(await inflateAny(chunks[0]));
  const msg=kiwiDecode(defs,await inflateAny(chunks[1]),'Message');msg._meta=meta;return msg;
}
// path blobs (commandsBlob): 0 close, 1 move, 2 line, 3 cubic, 4 quad — float32 little-endian
function blobPath(bytes){
