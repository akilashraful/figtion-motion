const SHAPES=[{id:'rect',name:'Rectangle',label:'Add a rectangle layer',shortcut:'R'},{id:'ellipse',name:'Ellipse',label:'Add an ellipse layer',shortcut:'O'},{id:'star',name:'Star',label:'Add a star layer',shortcut:'S'},{id:'polygon',name:'Polygon',label:'Add a polygon layer',shortcut:'G'},{id:'spiral',name:'Spiral',label:'Spiral — drag to draw',shortcut:''}];
const PENS=[{id:'pen',name:'Pen',label:'Pen',shortcut:'P'},{id:'pencil',name:'Pencil',label:'Pencil',shortcut:'⇧P'},{id:'join',name:'Join',label:'Join — click two open endpoints',shortcut:'⌘J'},{id:'smooth',name:'Smooth',label:'Smooth — drag along a path',shortcut:'⇧S'},{id:'direct',name:'Direct Selection',label:'Direct Selection — move anchor points',shortcut:'A'}];
