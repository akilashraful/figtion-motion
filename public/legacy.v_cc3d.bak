          if(sv){if(flip)sv=sv.replace(/(<path [^>]*\/>)/,m=>`<g transform="matrix(-1 0 0 1 ${w} 0)">${m}</g>`);o.svg=sv;o.svgNodeSpace=true;return o}}catch(e){}
