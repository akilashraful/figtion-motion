        align:{LEFT:'left',CENTER:'center',RIGHT:'right',JUSTIFIED:'left'}[n.textAlignHorizontal||sy.textAlignHorizontal]||'left',valign:{TOP:'top',CENTER:'middle',BOTTOM:'bottom'}[n.textAlignVertical||sy.textAlignVertical]||'top',
        lh:Math.round(lhv)||120,ls:+lsv.toFixed(2),tcase:{UPPER:'upper',LOWER:'lower'}[n.textCase||sy.textCase]||'none',autoResize:tar==='WIDTH_AND_HEIGHT'?'width':tar==='HEIGHT'?'height':'fixed',bh:h,fillOn:true});
