// previews play on a loop on their own — only the cards currently on screen are drawn
const visCards=new Set();let cardIO=null,loopOn=false,loopT0=0,lastDraw=0;
if('IntersectionObserver' in window)cardIO=new IntersectionObserver(es=>es.forEach(x=>{const e=thumbs[x.target.dataset.i];if(!e)return;x.isIntersecting?visCards.add(e):visCards.delete(e)}),{threshold:0});
function startPreviewLoop(){
  if(loopOn)return;loopOn=true;loopT0=performance.now();requestAnimationFrame(previewLoop);
}
function previewLoop(now){
  if(!thumbs.length||!document.body.contains(document.querySelector('#rbody .card'))){loopOn=false;visCards.clear();return}
  if(now-lastDraw>=33&&!document.hidden){
    lastDraw=now;const el=(now-loopT0)/1000;
    const list=cardIO?[...visCards]:thumbs;
    list.forEach(e=>{if(!e||!e.c||!e.d||!thumbs.includes(e))return;const cycle=e.d+0.7;thumbDraw(e,Math.min(el%cycle,e.d))});
  }
  requestAnimationFrame(previewLoop);
}
function hoverTick(now){
  if(!hov)return;const{e,t0}=hov;
  const el=(now-t0)/1000,cycle=e.d+0.7;
  thumbDraw(e,Math.min(el%cycle,e.d));
  requestAnimationFrame(hoverTick);
}
const FONTS=[['System','system-ui'],['Georgia','Georgia, serif'],['Times','"Times New Roman", serif'],['Arial','Arial, sans-serif'],['Helvetica','Helvetica, sans-serif'],['Verdana','Verdana, sans-serif'],['Trebuchet','"Trebuchet MS", sans-serif'],['Courier','"Courier New", monospace'],['Impact','Impact, sans-serif']];
// ---------- fonts: every family installed on this computer, plus uploaded font files ----------
const FONT_W=[['Thin',100],['Extra light',200],['Light',300],['Regular',400],['Medium',500],['Semi bold',600],['Bold',700],['Extra bold',800],['Black',900]];
const wLabel=(w,it)=>`${(FONT_W.find(x=>x[1]===w)||FONT_W[3])[0]}${it?' italic':''}`;   // names only: no numbers, no hyphens
function styleToVariant(st){
  const s=String(st).toLowerCase();let w=400;
  if(/thin|hairline/.test(s))w=100;else if(/extra.?light|ultra.?light/.test(s))w=200;else if(/semi.?bold|demi/.test(s))w=600;
  else if(/extra.?bold|ultra.?bold|heavy/.test(s))w=800;else if(/light/.test(s))w=300;else if(/black/.test(s))w=900;
  else if(/bold/.test(s))w=700;else if(/medium/.test(s))w=500;
  return{weight:w,italic:/italic|oblique/.test(s)};
}
const FONT_CANDIDATES='Arial,Arial Black,Arial Narrow,Arial Rounded MT Bold,Avenir,Avenir Next,Baskerville,Bodoni 72,Big Caslon,Bradley Hand,Brush Script MT,Calibri,Cambria,Candara,Century Gothic,Chalkboard,Chalkduster,Cochin,Comic Sans MS,Consolas,Constantia,Copperplate,Corbel,Courier,Courier New,Didot,Dosis,Franklin Gothic Medium,Futura,Garamond,Geneva,Georgia,Gill Sans,Helvetica,Helvetica Neue,Hoefler Text,Impact,Inter,Lato,Lucida Grande,Lucida Console,Lucida Sans Unicode,Marker Felt,Menlo,Monaco,Montserrat,Noteworthy,Open Sans,Optima,Oswald,Palatino,Palatino Linotype,Papyrus,Perpetua,Playfair Display,Poppins,Rockwell,Roboto,Segoe UI,SF Pro Display,SF Pro Text,SF Mono,Skia,Snell Roundhand,Source Sans Pro,Tahoma,Times,Times New Roman,Trebuchet MS,Verdana,Zapfino,American Typewriter,Andale Mono,Apple Chancery,Apple Color Emoji,Athelas,Charter,Damascus,Euphemia UCAS,Gurmukhi MN,Herculanum,Kailasa,Luminari,Phosphate,PT Sans,PT Serif,Rockwell,Savoye LET,Silom,Sinhala MN,Superclarendon,Tamil MN,Thonburi,Toppan Bunkyu Mincho,Trattatello,Wingdings,Yuppy SC,Ubuntu,Fira Sans,Fira Code,JetBrains Mono,Cascadia Code,Noto Sans,Noto Serif,Merriweather,Raleway,Nunito,Work Sans,DM Sans,Space Grotesk,Bebas Neue,Anton,Lobster,Pacifico,Caveat,Dancing Script'.split(',');
let localFonts=null,localFontsMsg='',fontsLoading=null;
function detectFonts(){
  const c=document.createElement('canvas').getContext('2d'),bases=['monospace','serif','sans-serif'],txt='mmmmmmmmmmlliWQ@#',w0=bases.map(b=>{c.font=`72px ${b}`;return c.measureText(txt).width});
  return[...new Set(FONT_CANDIDATES)].filter(f=>bases.some((b,i)=>{c.font=`72px "${f}",${b}`;return c.measureText(txt).width!==w0[i]})).sort((a,b)=>a.localeCompare(b)).map(family=>({family,variants:[{weight:400,italic:false},{weight:700,italic:false},{weight:400,italic:true},{weight:700,italic:true}]}));
}
function loadLocalFonts(){
  if(localFonts)return Promise.resolve(localFonts);
  if(fontsLoading)return fontsLoading;
  fontsLoading=(async()=>{
    try{
      if(window.queryLocalFonts){
        const list=await window.queryLocalFonts(),m=new Map();
        list.forEach(f=>{let e=m.get(f.family);if(!e){e={family:f.family,variants:[]};m.set(f.family,e)}const v=styleToVariant(f.style||'');if(!e.variants.some(x=>x.weight===v.weight&&x.italic===v.italic))e.variants.push(v)});
        localFonts=[...m.values()].sort((a,b)=>a.family.localeCompare(b.family));localFontsMsg='';
      }else{localFonts=detectFonts();localFontsMsg='This browser cannot list every installed font, so common ones were detected. Chrome or Edge can list all of them.'}
    }catch(e){localFonts=detectFonts();localFontsMsg='Access to local fonts was blocked — showing common installed fonts. Allow it in the site settings to see all of them.'}
    fontsLoading=null;return localFonts;
  })();
  return fontsLoading;
}
const fontName=css=>{const m=String(css||'').match(/^\s*(?:"([^"]+)"|'([^']+)'|([^,]+))/);return(m&&(m[1]||m[2]||m[3])||'system-ui').trim()};
const guessGeneric=n=>/mono|code|courier|consolas|menlo|typewriter/i.test(n)?'monospace':/serif(?!.*sans)|text|times|garamond|georgia|didot|bodoni|caslon|baskerville|palatino|playfair|merriweather|lora|fraunces|cormorant|crimson|literata|spectral|libre bask|source serif|noto serif|pt serif|ibm plex serif|dm serif|abril|cambria|minion|freight|ariata|display/i.test(n)&&!/sans|grotesk/i.test(n)?'serif':'sans-serif';
const cssFor=name=>{const f=FONTS.find(x=>x[0]===name);return f?f[1]:`"${name.replace(/"/g,'')}", ${guessGeneric(name)}`};
const variantsOf=l=>{const n=fontName(l.font),e=(localFonts||[]).find(x=>x.family===n);
  if(e)return[...e.variants].sort((a,b)=>a.weight-b.weight||a.italic-b.italic);
  const all=[];[false,true].forEach(it=>FONT_W.forEach(([,w])=>all.push({weight:w,italic:it})));return all};
// area text starts in Medium; if the font has no Medium, Regular; if it has neither, the closest weight it does have
function areaTextWeight(l){
  const all=variantsOf(l),up=all.filter(v=>!v.italic),pool=(up.length?up:all).map(v=>v.weight);
  if(pool.includes(500))return 500;if(pool.includes(400))return 400;
  return pool.length?pool.reduce((p,w)=>Math.abs(w-500)<Math.abs(p-500)?w:p):500;
}
function applyFont(l,name,keep){
  l.font=cssFor(name);
  const e=(localFonts||[]).find(x=>x.family===name);
  if(e&&e.variants.length&&!e.variants.some(v=>v.weight===l.weight&&v.italic===!!l.italic)){
    const same=e.variants.filter(v=>v.italic===!!l.italic),pool=same.length?same:e.variants;
    const b=pool.reduce((p,v)=>Math.abs(v.weight-l.weight)<Math.abs(p.weight-l.weight)?v:p);l.weight=b.weight;l.italic=b.italic;
  }
  fitText(l);if(!keep)refresh();else draw();
}
function openFontPicker(l,anchor){
  closeFontPicker();
  const pop=document.createElement('div');pop.id='fontpop';document.body.appendChild(pop);
  const orig={font:l.font,weight:l.weight,italic:l.italic};let done=false,q='',idx=-1;
  const r=anchor.getBoundingClientRect();
  const rp=$('right').getBoundingClientRect();   // sits to the left of the right sidebar so it never covers it
  pop.style.left=Math.max(8,rp.left-300-10)+'px';pop.style.top=Math.min(innerHeight-440,Math.max(8,r.top-40))+'px';
  pop.innerHTML=`<input id="fpq" placeholder="Search fonts" autocomplete="off" spellcheck="false"><div id="fplist"></div>
    <div id="fpfoot"><button id="fpup">${ic('upload',14)} Upload font</button><span id="fpmsg"></span></div>`;
  const cur=fontName(l.font),used=[...new Set(project.frames.flatMap(f=>f.layers.filter(x=>x.type==='text').map(x=>fontName(x.font))))];
  const item=(n,tag)=>`<div class="fpi ${n===cur?'on':''}" data-n="${esc(n)}" style="font-family:${esc(cssFor(n))}"><span>${esc(n)}</span>${tag?`<i>${tag}</i>`:''}</div>`;
  const list=()=>{
    const m=q.trim().toLowerCase(),ok=n=>!m||n.toLowerCase().includes(m);
    let h='';const sect=(t,arr,tag)=>{arr=arr.filter(ok);if(arr.length)h+=`<div class="fph">${t}</div>`+arr.map(n=>item(n,tag)).join('')};
    sect('Used in this file',used);
    sect('Uploaded',userFonts.map(f=>f.name),'uploaded');
    if(localFonts)sect(`Installed on this computer (${localFonts.length})`,localFonts.map(f=>f.family));
    sect('Standard',FONTS.map(f=>f[0]));
    if(!localFonts)h+=`<div class="fphint">Loading installed fonts…</div>`;
    $('fplist').innerHTML=h||'<div class="fphint">No fonts match</div>';
    $('fpmsg').textContent=localFontsMsg;
    const els=[...$('fplist').querySelectorAll('.fpi')];
    els.forEach((el,i)=>{
      el.onmouseenter=()=>{idx=i;mark();applyFont(l,el.dataset.n,true)};
      el.onclick=()=>{done=true;closeFontPicker();Object.assign(l,orig);applyFont(l,el.dataset.n)};
    });
    pop._els=els;
  };
  const mark=()=>{(pop._els||[]).forEach((e,i)=>e.classList.toggle('hot',i===idx));const e=(pop._els||[])[idx];if(e)e.scrollIntoView({block:'nearest'})};
  list();
  const sc=$('fplist');const on=sc.querySelector('.fpi.on');if(on)on.scrollIntoView({block:'center'});
  loadLocalFonts().then(()=>{if(document.body.contains(pop)){list();const o=$('fplist').querySelector('.fpi.on');if(o&&!q)o.scrollIntoView({block:'center'})}});
  const qi=$('fpq');qi.focus();
  qi.oninput=()=>{q=qi.value;idx=-1;list()};
  qi.onkeydown=e=>{
    e.stopPropagation();const n=(pop._els||[]).length;
    if(e.key==='ArrowDown'){e.preventDefault();idx=Math.min(n-1,idx+1);mark();if(pop._els[idx])applyFont(l,pop._els[idx].dataset.n,true)}
    else if(e.key==='ArrowUp'){e.preventDefault();idx=Math.max(0,idx-1);mark();if(pop._els[idx])applyFont(l,pop._els[idx].dataset.n,true)}
    else if(e.key==='Enter'&&pop._els[idx]){e.preventDefault();pop._els[idx].click()}
    else if(e.key==='Escape')closeFontPicker();
  };
  $('fplist').onmouseleave=()=>{idx=-1;mark();Object.assign(l,orig);fitText(l);draw()};
  $('fpup').onclick=()=>$('fontfile').click();
  pop._close=()=>{if(!done){Object.assign(l,orig);fitText(l);draw()}};
  setTimeout(()=>addEventListener('pointerdown',fpOutside,true),0);
}
const fpOutside=e=>{if(!e.target.closest('#fontpop'))closeFontPicker()};
function closeFontPicker(){
  const p=$('fontpop');removeEventListener('pointerdown',fpOutside,true);
  if(p){if(p._close)p._close();p.remove()}
}
// uploaded font files travel with the project file
let userFonts=[];
function registerUserFont(name,data){
  return new FontFace(name,`url(${data})`).load().then(f=>{document.fonts.add(f);if(!userFonts.some(u=>u.name===name))userFonts.push({name,data});drawAll()}).catch(()=>toast('Could not read that font file'));
}
$('fontfile').onchange=e=>{
  const f=e.target.files[0];e.target.value='';if(!f)return;
  const name=f.name.replace(/\.[^.]+$/,'').replace(/[-_]+/g,' ').trim(),r=new FileReader();
  r.onload=()=>registerUserFont(name,r.result).then(()=>{closeFontPicker();const l=cur();if(l&&l.type==='text'){applyFont(l,name);toast('Font "'+name+'" added')}});
  r.readAsDataURL(f);
};
try{if(navigator.permissions&&navigator.permissions.query)navigator.permissions.query({name:'local-fonts'}).then(p=>{if(p.state==='granted')loadLocalFonts()}).catch(()=>{})}catch(e){}
const ALIGN_P={"left":"M2.5 2v12M5.5 5h8M5.5 10.5h5","hcenter":"M8 2v12M3.5 5h9M5.5 10.5h5","right":"M13.5 2v12M2.5 5h8M5.5 10.5h5","top":"M2 2.5h12M5 5.5v8M10.5 5.5v5","vcenter":"M2 8h12M5 3.5v9M10.5 5.5v5","bottom":"M2 13.5h12M5 2.5v8M10.5 5.5v5"};
function alignSvg(a){return '<svg class="lic" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="'+ALIGN_P[a]+'"/></svg>'}
// every <select> opens the same dark menu as the blend modes instead of the native list
function openSelectMenu(sel){
  document.querySelectorAll('.bmenu').forEach(x=>x.remove());
  const m=document.createElement('div');m.className='bmenu';
  m.innerHTML=[...sel.options].map((o,i)=>`<div class="bi ${o.disabled?'dis':''}" data-i="${i}">${i===sel.selectedIndex?ic('check',13):''}${esc(o.textContent)}</div>`).join('');
  document.body.appendChild(m);
  const r=sel.getBoundingClientRect();m.style.width='max-content';m.style.minWidth=Math.max(120,Math.round(r.width))+'px';m.style.maxWidth=(innerWidth-16)+'px';m.style.whiteSpace='nowrap';
  m.style.left=Math.max(8,Math.min(innerWidth-m.offsetWidth-8,r.left))+'px';
  const below=innerHeight-r.bottom-8,top=below>=m.offsetHeight||below>=r.top?r.bottom+4:r.top-m.offsetHeight-4;
  m.style.top=Math.max(8,top)+'px';m.style.maxHeight=Math.max(120,Math.max(below,r.top-8))+'px';
  const close=()=>{m.remove();document.removeEventListener('mousedown',away,true);document.removeEventListener('keydown',esc_,true)};
  const away=e=>{if(!m.contains(e.target))close()};
  const esc_=e=>{if(e.key==='Escape'){e.stopPropagation();close()}};
  setTimeout(()=>{document.addEventListener('mousedown',away,true);document.addEventListener('keydown',esc_,true)});
  m.querySelectorAll('.bi').forEach(i=>i.onclick=()=>{sel.selectedIndex=+i.dataset.i;close();sel.dispatchEvent(new Event('input',{bubbles:true}));sel.dispatchEvent(new Event('change',{bubbles:true}));sel.focus()});
}
document.addEventListener('mousedown',e=>{const sel=e.target.closest&&e.target.closest('select');if(!sel||sel.disabled||sel.multiple)return;e.preventDefault();openSelectMenu(sel)},true);
document.addEventListener('keydown',e=>{const sel=e.target;if(!sel||sel.tagName!=='SELECT'||sel.disabled||sel.multiple)return;if(e.key==='Enter'||e.key===' '||(e.altKey&&(e.key==='ArrowDown'||e.key==='ArrowUp'))){e.preventDefault();openSelectMenu(sel)}},true);
const BLENDS=[['source-over','Normal'],0,['darken','Darken'],['multiply','Multiply'],['color-burn','Color burn'],0,['lighten','Lighten'],['screen','Screen'],['lighter','Plus lighter'],['color-dodge','Color dodge'],0,['overlay','Overlay'],['soft-light','Soft light'],['hard-light','Hard light'],0,['difference','Difference'],['exclusion','Exclusion'],0,['hue','Hue'],['saturation','Saturation'],['color','Color'],['luminosity','Luminosity']];
function openBlend(btn,l){
  document.querySelectorAll('.bmenu').forEach(x=>x.remove());
  const m=document.createElement('div');m.className='bmenu';
  const cur=l.blend||'source-over';
  m.innerHTML=BLENDS.map(b=>b?`<div class="bi" data-b="${b[0]}">${b[0]===cur?ic('check',13):''}${b[1]}</div>`:'<hr>').join('');
  document.body.appendChild(m);
  const r=btn.getBoundingClientRect();m.style.left=Math.max(8,Math.min(innerWidth-158,r.right-150))+'px';m.style.top=Math.min(r.bottom+6,innerHeight-m.offsetHeight-8)+'px';
  const close=()=>{m.remove();document.removeEventListener('mousedown',away,true)};
  const away=e=>{if(!m.contains(e.target))close()};
  setTimeout(()=>document.addEventListener('mousedown',away,true));
  m.querySelectorAll('.bi').forEach(i=>i.onclick=()=>{l.blend=i.dataset.b;close();draw();commitLater();refresh()});
}
const layerHead=l=>`<div class="lhead"><input class="nm2" data-f="name" value="${esc(l.name)}">${boolBtnHTML()}<button class="more" id="more">${ic('ellipsis',16)}</button>
  ${MENU_HTML()}</div>`;
const R=(label,inner)=>`<div class="dr"><label>${label}</label>${inner}</div>`;
const sec=(title,inner,right='')=>`<div class="ds"><div class="dh"><span>${title}</span>${right}</div>${inner||''}</div>`;
const chk=(id,on)=>`<input type="checkbox" class="cb" data-chk="${id}" ${on?'checked':''}>`;
const hexRow=(key,color)=>R('Color',`<span class="two"><input class="hex" data-hex="${key}" value="${color.slice(1).toUpperCase()}" maxlength="6"><input type="color" class="sw" data-f="${key}" value="${color}"></span>`);

function designPanel(body,l){
  if(l.type==='audio')return audioPanel(body,l);
  const s=state(l,t),bx=boxSize(l,s),isT=l.type==='text';
  const seg=(key,opts)=>`<span class="seg2">${opts.map(([v,label,title])=>`<button data-seg="${key}:${v}" title="${title}" class="${l[key]===v?'on':''}">${label}</button>`).join('')}</span>`;
  const n=(a,v,dis)=>`<input type="number" ${a} value="${v}" ${dis?'disabled':''}>`;
  const ff=(pre,a,v,dis)=>`<label class="ff"><i class="pre">${pre}</i><input type="number" ${a} value="${v}" ${dis?'disabled':''}></label>`;
  const cell=(lab,inner)=>`<div class="fcell"><div class="fl">${lab}</div>${inner}</div>`;
  const FS=(title,inner,right='')=>`<div class="fsec"><div class="fhd"><span>${title}</span><span class="fact">${right}</span></div>${inner||''}</div>`;
  const fib=(act,icon,title)=>`<button class="fib" data-act="${act}" title="${title}">${ic(icon,15)}</button>`;
  const fcol=(key,color,remove)=>{const ty=key==='fill'?fillTypeOf(l):'solid',hexUI=ty==='solid'||ty==='none',al=key==='fill'?l.fillA:key==='stroke'?l.strokeA:key==='shColor'?l.shOp:1;
    return `<div class="fcol"><button class="fsw" data-pick="${key}" title="Colour, gradient, pattern, image…" style="background:${key==='fill'?fillPreview(l):color}"></button>${hexUI?`<input class="fhex" data-hex="${key}" value="${color.slice(1).toUpperCase()}" maxlength="6">`:`<span class="fhex fname">${FILL_NAMES[ty]||''}</span>`}${remove?`<input class="fop" type="text" inputmode="numeric" min="0" max="100" data-opa="${key==='fill'?(hexUI?'fillA':'fillOp'):key==='stroke'?'strokeA':'shOp'}" value="${Math.round((key==='fill'&&!hexUI?(l.fillOp==null?1:l.fillOp):(al==null?1:al))*100)}"><span class="fpc">%</span>${fib(remove,'minus','Remove')}`:''}</div>`};
  let sizeF;
  if(!isT)sizeF=ff('W','data-p="w"',Math.round(s.w))+ff('H','data-p="h"',Math.round(s.h));
  else if(l.autoResize==='width')sizeF=ff('W','',Math.round(bx.w),1)+ff('H','',Math.round(bx.h),1);
  else if(l.autoResize==='height')sizeF=ff('W','data-p="w"',Math.round(s.w))+ff('H','',Math.round(bx.h),1);
  else sizeF=ff('W','data-p="w"',Math.round(s.w))+ff('H','data-f="bh"',Math.round(l.bh));
  const al=a=>`<button data-align="${a}" title="Align ${a}">${alignSvg(a)}</button>`;
  let h=layerHead(l);
  h+=FS('Position',
    cell('Alignment',`<div class="falign"><span class="fg">${['left','hcenter','right'].map(al).join('')}</span><span class="fg">${['top','vcenter','bottom'].map(al).join('')}</span></div>`)+
    cell('Position',`<div class="f2">${ff('X','data-pos="x"',Math.round(s.x-bx.w/2))}${ff('Y','data-pos="y"',Math.round(s.y-bx.h/2))}</div>`)+
    cell('Rotation',`<div class="f2 rotrow">${ff(ic('angle',13),'data-p="rot"',+s.rot.toFixed(1))}<button class="rb" data-act="rot90" title="Rotate 90° right">${ic('rotate-90',16)}</button><button class="rb ${l.flipX?'on':''}" data-act="flipx" title="Flip horizontal">${ic('flip-h',16)}</button><button class="rb ${l.flipY?'on':''}" data-act="flipy" title="Flip vertical">${ic('flip-v',16)}</button></div>`));
  h+=FS('Layout',isT?cell('Auto resize',seg('autoResize',[['width',ic('move-horizontal',15),'Auto width'],['height',ic('move-vertical',15),'Auto height'],['fixed',ic('scan',15),'Fixed size']])):cell('Dimensions',`<div class="f2 lock">${sizeF}<button class="fib ${ratioLock?'on':''}" id="ratio" title="Constrain proportions">${ic('scaling',15)}</button></div>`));
  if(isT)h+=`<div class="fsec"><div class="fhd"><span>Typography</span><span class="fact"></span></div>
    <button class="fontbtn tyfont" id="fontbtn" style="font-family:${esc(l.font)}"><span>${esc(fontName(l.font))}</span><i>${ic('chevron-down',14)}</i></button>
    <div class="f2 tyrow"><select class="fsel" data-weight>${variantsOf(l).map(v=>{const val=v.weight+(v.italic?'i':'');return `<option value="${val}" ${v.weight===l.weight&&v.italic===!!l.italic?'selected':''}>${wLabel(v.weight,v.italic)}</option>`}).join('')}</select><label class="ff"><input type="text" inputmode="decimal" autocomplete="off" data-tx="h" value="${Math.round(s.h*100)/100}"></label></div>
    <div class="f2"><div class="fcell"><div class="fl">Line height</div><label class="ff"><i class="pre tyg tyglh">A</i><input type="text" inputmode="decimal" autocomplete="off" data-tx="lh" data-unit="${l.lhPx!=null?'':'%'}" value="${l.lhAuto?'Auto':l.lhPx!=null?+(+l.lhPx).toFixed(2):(+Math.max(0,l.lh).toFixed(2))+'%'}"></label></div><div class="fcell"><div class="fl">Letter spacing</div><label class="ff"><i class="pre tyg">|A|</i><input type="text" inputmode="decimal" autocomplete="off" data-tx="ls" step="0.1" value="${l.ls}"></label></div></div>
    <div class="fl">Alignment</div>
    <div class="f2 tyal">${seg('align',[['left',ic('text-align-start',15),'Left'],['center',ic('text-align-center',15),'Center'],['right',ic('text-align-end',15),'Right']])}${seg('valign',[['top',ic('arrow-up-to-line',15),'Top'],['middle',ic('flip-v',15),'Middle'],['bottom',ic('arrow-down-to-line',15),'Bottom']])}<button class="fib" id="tyset" title="Type settings">${ic('sliders',15)}</button></div></div>`;
  if(l.opacity>1||l.opacity<0||l.cr<0){l.opacity=Math.max(0,Math.min(1,l.opacity));if(l.cr<0)l.cr=0;rebuild(l)}
  const cells=[cell('Opacity',`<label class="ff"><i class="pre">${ic('box',13)}</i><input type="number" data-pct="opacity" min="0" max="100" value="${Math.round(s.opacity*100)}"><span class="suf">%</span></label>`)];
  if(l.type==='rect'||l.type==='image')cells.push(cell('Corner radius',`<div class="crrow">${ff(ic('corner',13),'data-p="cr"',Math.round(s.cr),!!l.crI)}<button class="fib ${l.crI?'on':''}" data-act="crind" title="Independent corners">${ic('scan',15)}</button></div>`));
  else if(l.type==='path'||l.type==='polygon'||l.type==='star')cells.push(cell('Corner radius',ff(ic('corner',13),'data-p="cr"',Math.round(s.cr))));
  if(l.type==='polygon')cells.push(cell('Count',ff(SCRUB_SVG,'data-f="sides"',l.sides||6)));
  if(l.type==='star'){cells.push(cell('Points',ff(SCRUB_SVG,'data-f="points"',l.points||5)));cells.push(cell('Inner radius %',ff('%','data-pct="ir"',Math.round(s.ir*100))))}
  let rows='';for(let i=0;i<cells.length;i+=2)rows+=`<div class="f2">${cells[i]}${cells[i+1]||'<span></span>'}</div>`;
  if(l.crI&&(l.type==='rect'||l.type==='image')){const cf=(i,n)=>`<div class="fcell">${ff(ic(n,13),'data-crc="'+i+'"',Math.round(l.crI[i]))}</div>`;rows+=`<div class="f2">${cf(0,'cr-tl')}${cf(1,'cr-tr')}</div><div class="f2">${cf(3,'cr-bl')}${cf(2,'cr-br')}</div>`}
  h+=FS('Appearance',rows,fib('vis',l.hidden?'eye-off':'eye','Show / hide layer')+fib('blend','droplet','Blend mode').replace('class="fib"','class="fib'+((l.blend||'source-over')!=='source-over'?' on':'')+'"'));
  if(l.type==='image')h+=bgSection(l);
  if(l.video)h+=sec('Video',R('Volume',`<label class="ff"><i class="pre"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/></svg></i><input type="number" step="1" min="0" max="100" data-vp value="${Math.round((l.vol==null?1:l.vol)*100)}"><span class="suf">%</span></label>`)+R('Loop',`<input type="checkbox" class="cb" data-chk="vloopOn" ${l.vloop===false?'':'checked'}>`));
  const xrows=(l.xfills||[]).map((f,i)=>({f,i})).reverse().map(({f,i})=>`<div class="fcol xf ${f.off?'off':''}"><button class="fsw" data-xfpick="${i}" title="Colour, gradient, pattern, image…" style="background:${fillPreview(fillProxy(l,i))}"></button>${f.t==='solid'?`<input class="fhex" data-xfh="${i}" value="${f.c.slice(1).toUpperCase()}" maxlength="6">`:`<span class="fhex fname">${FILL_NAMES[fillTypeOf(fillProxy(l,i))]||''}</span>`}<input class="fop" data-xfa="${i}" type="text" inputmode="numeric" min="0" max="100" value="${Math.round((f.a==null?1:f.a)*100)}"><span class="fpc">%</span>${fib('xfeye:'+i,f.off?'eye-off':'eye','Show / hide fill')}${fib('xfdel:'+i,'minus','Remove fill')}</div>`).join('');
  if(!l.video)h+=FS('Fill',xrows+(l.fillOn!==false?fcol('fill',l.fill,'fill-'):''),fib('fill+','plus','Add fill'));   // a video has no fill
  h+=FS('Stroke',l.strokeW>0?fcol('stroke',l.stroke,'stroke-')+`<div class="f2">${cell('Position',`<select class="fsel" data-f="strokeAlign">${[['center','Center'],['inside','Inside'],['outside','Outside']].map(([v,t_])=>`<option value="${v}" ${(l.strokeAlign||'center')===v?'selected':''}>${t_}</option>`).join('')}</select>`)}${cell('Weight',`<div class="f2 lock">${ff('W','data-f="strokeW"',l.strokeW)}<button class="fib" id="stkset" title="Stroke settings">${ic('sliders',15)}</button></div>`)}</div>`:'',l.strokeW>0?'':fib('stroke+','plus','Add stroke'));
  const shOn=s.shadow>0||!!l.tracks.shadow,blOn=s.blur>0||!!l.tracks.blur,bbOn=l.bgBlur>0;
  const glOn=s.glass>0||!!l.tracks.glass,inOn=l.inShadow>0,nzOn=!!l.noise,txOn=!!l.texture;
  const fxline=(kind,title,act,icon)=>{const off=l.fxOff&&l.fxOff[kind];return `<div class="fxline ${off?'off':''}"><button class="fxchip" data-fxopen="${kind}">${ic(icon||'square',14)}<span>${title}</span></button>${fib('fxeye:'+kind,off?'eye-off':'eye','Show / hide effect')}${fib(act,'minus','Remove')}</div>`};
  let fxh='';
  if(inOn)fxh+=fxline('innerShadow','Inner shadow','inshadow-','fx-inner');
  if(shOn)fxh+=fxline('shadow','Drop shadow','shadow-','fx-drop');
  if(blOn)fxh+=fxline('blur','Layer blur','blur-','fx-blur');
  if(bbOn)fxh+=fxline('bgBlur','Background blur','bgblur-','fx-bgblur');
  if(nzOn)fxh+=fxline('noise','Noise','noise-','fx-noise');
  if(txOn)fxh+=fxline('texture','Texture','texture-','fx-texture');
  if(glOn)fxh+=fxline('glass','Glass','glass-','fx-glass');
  const FXM=[['inshadow+','Inner shadow','fx-inner',inOn],['shadow+','Drop shadow','fx-drop',shOn],['blur+','Layer blur','fx-blur',blOn],['bgblur+','Background blur','fx-bgblur',bbOn],['noise+','Noise','fx-noise',nzOn],['texture+','Texture','fx-texture',txOn],['glass+','Glass','fx-glass',glOn]];
  h+=FS('Effects',fxh+effectsHTML(l),`<button class="fib" id="fxplus" title="Add effect">${ic('plus',15)}</button><div class="menu dmenu" id="fxmenu">${FXM.map(([act,nm,icn,on])=>`<div data-fa="${act}" class="${on?'off':''}">${ic(icn,16)}<span>${nm}</span></div>`).join('')}<div data-fa="fx" class="morefx">${ic('sparkles',16)}<span>Shader effect…</span></div></div>`);
  if(selKey&&selKey.layer===l.id)h+=sec(`Keyframe @ ${selKey.keys[0].k.t.toFixed(2)}s · ${selKey.keys.length} prop${selKey.keys.length>1?'s':''}`,
    R('Easing',`<select id="ease">${Object.keys(EASE).map(e=>`<option ${e===selKey.keys[0].k.ease?'selected':''}>${e}</option>`).join('')}</select>`)+
    `<button class="pbtn" id="dk">Delete keyframe</button>`);
  body.innerHTML=h;bindDesign(body,l);
  const doAct=a=>{
    if(a==='fx'){picking='design';tab='effects';renderRight();return}   // effects added from the Design tab are fixed looks, not timeline animations
    if(a.startsWith('fxeye:')){const k=a.slice(6);l.fxOff=l.fxOff||{};l.fxOff[k]=!l.fxOff[k];draw();commitLater();refresh();return}
    if(a==='blend'){openBlend(body.querySelector('[data-act="blend"]'),l);return}
    if(a==='vis')l.hidden=!l.hidden;
    else if(a==='fill+'){if(l.fillOn===false)l.fillOn=true;else(l.xfills=l.xfills||[]).push({t:'solid',c:'#d9d9d9',a:1})}else if(a==='fill-')l.fillOn=false;
    else if(a.startsWith('xfeye:')){const f=(l.xfills||[])[+a.slice(6)];if(f)f.off=!f.off}
    else if(a.startsWith('xfdel:')){if(l.xfills){l.xfills.splice(+a.slice(6),1);if(!l.xfills.length)delete l.xfills}}
    else if(a==='stroke+'){l.strokeW=l._sw||4;l.stroke=l.stroke||'#111111'}else if(a==='stroke-'){l._sw=l.strokeW;l.strokeW=0}
    else if(a==='shadow+')l.shadow=l._sh||28;else if(a==='shadow-'){if(l.fxOff)delete l.fxOff.shadow;l._sh=state(l,t).shadow||28;l.shadow=0;delete l.tracks.shadow}
    else if(a==='blur+')l.blur=l._bl||8;else if(a==='blur-'){if(l.fxOff)delete l.fxOff.blur;l._bl=state(l,t).blur||8;l.blur=0;delete l.tracks.blur}
    else if(a==='rot90'){let r=Math.round((state(l,t).rot+90)*100)/100;if(r>180)r-=360;setProp(l,'rot',r)}
    else if(a==='flipx')l.flipX=!l.flipX;else if(a==='flipy')l.flipY=!l.flipY;
    else if(a==='crind'){if(l.crI)delete l.crI;else{const v=Math.round(state(l,t).cr||0);l.crI=[v,v,v,v]}}
    else if(a==='inshadow+'){l.inShadow=l._is||12;l.inX=l.inX||0;l.inY=l.inY==null?4:l.inY;l.inColor=l.inColor||'#000000';l.inOp=l.inOp==null?.35:l.inOp}
    else if(a==='inshadow-'){if(l.fxOff)delete l.fxOff.innerShadow;l._is=l.inShadow;l.inShadow=0}
    else if(a==='noise+')l.noise=l._noise||{amount:.3,size:1,mono:true};else if(a==='noise-'){if(l.fxOff)delete l.fxOff.noise;l._noise=l.noise;delete l.noise}
    else if(a==='texture+')l.texture=l._tex||{kind:'paper',size:100,amount:.5};else if(a==='texture-'){if(l.fxOff)delete l.fxOff.texture;l._tex=l.texture;delete l.texture}
    else if(a==='glass+')l.glass=l._gl||.6;else if(a==='glass-'){if(l.fxOff)delete l.fxOff.glass;l._gl=state(l,t).glass||.6;l.glass=0;delete l.tracks.glass}
    else if(a==='bgblur+')l.bgBlur=l._bb||16;else if(a==='bgblur-'){if(l.fxOff)delete l.fxOff.bgBlur;l._bb=l.bgBlur;l.bgBlur=0}
    rebuild(l);refresh();
  };
  body.querySelectorAll('[data-act]').forEach(b=>b.onclick=()=>doAct(b.dataset.act));
  body.querySelectorAll('[data-pick]').forEach(b=>b.onclick=e=>{e.stopPropagation();openColorPicker(l,b.dataset.pick,b)});
  body.querySelectorAll('[data-fxopen]').forEach(b=>b.onclick=e=>{e.stopPropagation();openFxPop(l,b.dataset.fxopen,b)});
  const fxp=$('fxplus'),fxm=$('fxmenu');
  if(fxp)fxp.onclick=e=>{e.stopPropagation();const open=fxm.style.display==='block';document.querySelectorAll('.menu').forEach(x=>x.style.display='none');if(open)return;
    fxm.style.display='block';fxm.style.position='fixed';fxm.style.right='auto';
    const r=fxp.getBoundingClientRect(),mw=fxm.offsetWidth,mh=fxm.offsetHeight;
    fxm.style.left=Math.max(8,Math.min(innerWidth-mw-8,r.right-mw))+'px';
    fxm.style.top=Math.max(8,(innerHeight-r.bottom-8>=mh?r.bottom+4:r.top-mh-4))+'px'};
  body.querySelectorAll('[data-xfpick]').forEach(b=>b.onclick=e=>{e.stopPropagation();openColorPicker(fillProxy(l,+b.dataset.xfpick),'xfill:'+b.dataset.xfpick,b)});
  body.querySelectorAll('[data-xfh]').forEach(i=>i.onchange=()=>{const f=(l.xfills||[])[+i.dataset.xfh];if(!f)return;if(/^[0-9a-f]{6}$/i.test(i.value)){f.c='#'+i.value.toLowerCase();const sw=body.querySelector(`[data-xfpick="${i.dataset.xfh}"]`);if(sw)sw.style.background=f.c;draw();commitLater()}else toast('Use a 6-digit hex, e.g. D9D9D9')});
  body.querySelectorAll('[data-xfa]').forEach(i=>i.onchange=()=>{const f=(l.xfills||[])[+i.dataset.xfa];if(!f)return;const v=Math.max(0,Math.min(100,parseFloat(i.value)||0));i.value=v;f.a=v/100;draw();commitLater()});
  body.querySelectorAll('.fsec').forEach(sec=>{const hd=sec.querySelector('.fhd'),pl=hd&&hd.querySelector('[data-act$="+"],#fxplus');if(pl&&!(hd.textContent.trim().startsWith('Fill')&&l.fillOn!==false)){hd.classList.add('clk');hd.onclick=e=>{if(!e.target.closest('button,.menu')){e.stopPropagation();pl.click()}}}});
  if(fxm)fxm.querySelectorAll('[data-fa]').forEach(m=>m.onclick=()=>{if(m.classList.contains('off'))return;fxm.style.display='none';doAct(m.dataset.fa)});
  const rt=$('ratio');if(rt)rt.onclick=()=>{ratioLock=!ratioLock;renderRight()};
  const ss=$('stkset');if(ss)ss.onclick=e=>{e.stopPropagation();openStrokeSettings(l)};
  const ez=$('ease');if(ez)ez.onchange=()=>{selKey.keys.forEach(o=>o.k.ease=ez.value);draw()};
  const dk=$('dk');if(dk)dk.onclick=delKey;
}
const A4=[['up',ic('arrow-up',15)],['down',ic('arrow-down',15)],['left',ic('arrow-left',15)],['right',ic('arrow-right',15)]];
const arrowsHTML=(opts,cur,attrOf)=>`<span class="arrows">${opts.map(([k,g])=>`<button ${attrOf(k)} class="${cur===k?'on':''}">${g}</button>`).join('')}</span>`;
function paramControl(q,v,attr,dirAttr){
  if(q.kind==='num')return `<input type="number" ${attr} step="${q.step||1}" ${q.min!=null?`min="${q.min}"`:''} ${q.max!=null?`max="${q.max}"`:''} value="${+(+v).toFixed(2)}">`;
  if(q.kind==='dir')return arrowsHTML(A4,v,dirAttr);
  if(q.kind==='dir5')return arrowsHTML([...A4,['circle',ic('circle',15)]],v,dirAttr);
  if(q.kind==='select')return `<select ${attr} data-s="1">${q.opts.map(([k,n])=>`<option value="${k}" ${v===k?'selected':''}>${n}</option>`).join('')}</select>`;
  if(q.kind==='color')return `<input type="color" ${attr} data-s="1" value="${v}">`;
  if(q.kind==='text')return `<input ${attr} data-s="1" value="${esc(v)}">`;
  return `<input type="checkbox" class="cb" ${attr} ${v?'checked':''}>`;
}
const readParam=i=>i.type==='checkbox'?i.checked:i.dataset.s?i.value:(parseFloat(i.value)||0);
function effectsHTML(l){
  return(l.effects||[]).map((e,i)=>{
    const d=FXLIB[e.id];if(!d)return'';
    return `<div class="fxitem"><div class="dh" style="margin-bottom:8px"><span>${d.label}</span><span><button class="icb" data-fxon="${i}" title="Turn on/off">${ic(e.on===false?'eye-off':'eye',14)}</button><button class="icb" data-fxdel="${i}" title="Remove">${ic('x',14)}</button></span></div>
      ${d.params.map(q=>R(q.label,paramControl(q,e.p[q.k],`data-ek="${q.k}" data-ei="${i}"`,k=>`data-fxdir="${i}|${q.k}|${k}"`))).join('')}</div>`;
  }).join('');
}

// ---------- easing picker (Jitter style): a button opens a tile gallery of curves, Custom opens a bezier editor ----------
const isBz=k=>typeof k==='string'&&k.startsWith('bz:');
const easeLabel=k=>isBz(k)?'Custom':((EASINGS.find(e=>e[1]===k)||[])[0]||'Smooth');
const BZ_DEFAULT='bz:0.25,0.1,0.25,1';
function easeIcon(k,sz,sw){
  const N=48,ys=[];let lo=0,hi=1;
  for(let i=0;i<=N;i++){const y=ease(k,50,i/N);ys.push(y);lo=Math.min(lo,y);hi=Math.max(hi,y)}
  const pad=sz*.2,W=sz-pad*2,d=ys.map((y,i)=>(i?'L':'M')+(pad+i/N*W).toFixed(1)+' '+(sz-pad-(y-lo)/(hi-lo)*W).toFixed(1)).join('');
  return `<svg viewBox="0 0 ${sz} ${sz}" width="${sz}" height="${sz}" fill="none" stroke="currentColor" stroke-width="${sw||1.6}" stroke-linecap="round" stroke-linejoin="round"><path d="${d}"/></svg>`;
}
const savedEases=()=>{try{return JSON.parse(localStorage.getItem('nj_eases')||'[]')}catch(e){return[]}};
const saveEases=a=>{try{localStorage.setItem('nj_eases',JSON.stringify(a))}catch(e){}};
(()=>{const st=document.createElement('style');st.textContent=`
.easebtn{display:flex;align-items:center;gap:8px;width:100%;height:34px;background:#f4f4f6;border:0;border-radius:6px;padding:0 10px;font:inherit;color:inherit;cursor:pointer;text-align:left}
.easebtn span{flex:1}.easebtn svg:last-child{opacity:.55}
#easepop{position:fixed;z-index:80;width:224px;background:#1c1c20;border-radius:12px;box-shadow:0 12px 40px #0008,0 0 0 1px #ffffff14;color:#f2f2f5;display:flex;flex-direction:column;overflow:hidden}
#easepop .ephead{display:flex;align-items:center;justify-content:space-between;padding:10px 12px 6px}
#easepop .ephead span{display:flex;gap:6px}
#easepop .ephead button{width:30px;height:30px;border:0;border-radius:8px;background:transparent;color:#c9c9d0;cursor:pointer;display:grid;place-items:center;font-size:20px;line-height:1}
#easepop .ephead button:hover{background:#2a2a30}#easepop .ephead button.on{background:#34343b;color:#fff}
#easepop .epgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px 8px;padding:6px 12px 12px;overflow:auto;max-height:480px}
#easepop .eptile{border:0;background:none;padding:0;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:8px;color:#8d8d96;font:inherit;font-size:12px}
#easepop .eptile i{width:100%;aspect-ratio:1;border-radius:8px;background:#26262b;display:grid;place-items:center;color:#fff;font-style:normal;transition:background .12s}
#easepop .eptile:hover i{background:#303037}
#easepop .eptile.on i{background:linear-gradient(180deg,#4d98ff,#82b9ff)}#easepop .eptile.on{color:#fff}
#easepop .epempty{grid-column:1/-1;color:#8d8d96;font-size:12px;text-align:center;padding:30px 8px;line-height:1.6}
.bzed{margin-top:8px}.bzed svg{width:100%;display:block;background:#f4f4f6;border-radius:8px;touch-action:none}
.bzed .bzin{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:8px}.bzed .bzin input{height:30px;padding:0 6px;text-align:center}
.bzed .bzsave{margin-top:8px;width:100%;height:30px;border:0;border-radius:6px;background:#ececf0;cursor:pointer;font:inherit}.bzed .bzsave:hover{background:#e2e2e8}`;document.head.appendChild(st)})();
function closeEasePop(){const p=$('easepop');if(p)p.remove();document.removeEventListener('pointerdown',easeOutside,true);document.removeEventListener('keydown',easeEsc,true)}
const easeOutside=e=>{const p=$('easepop');if(p&&!p.contains(e.target)&&!(e.target.closest&&e.target.closest('#aease')))closeEasePop()};
const easeEsc=e=>{if(e.key==='Escape')closeEasePop()};
function openEasePop(btn,a,upd){
  if($('easepop')){closeEasePop();return}
  const pop=document.createElement('div');pop.id='easepop';let view='tiles';
  const curve='<svg viewBox="0 0 18 18" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3 14c4 0 2-10 6-10s2 10 6 0" transform="translate(0 0)" opacity="0"/><path d="M3 14.500c5 0 3.500-11 11-11"/></svg>',grid='<svg viewBox="0 0 18 18" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="4.800" height="4.800" rx="1"/><rect x="10.200" y="3" width="4.800" height="4.800" rx="1"/><rect x="3" y="10.200" width="4.800" height="4.800" rx="1"/><rect x="10.200" y="10.200" width="4.800" height="4.800" rx="1"/></svg>';
  const render=()=>{
    const cur=LEGACY_EASE[a.ease]||a.ease,saved=savedEases();
    const items=view==='tiles'?[['Custom','custom'],...EASINGS.filter(e=>e[1]!=='linear'),['Linear','linear']]:saved.map((k,i)=>['Custom '+(i+1),k]);
    const on=k=>k==='custom'?isBz(cur):cur===k;
    pop.innerHTML=`<div class="ephead"><span><button data-v="tiles" class="${view==='tiles'?'on':''}" title="Easings">${curve}</button><button data-v="saved" class="${view==='saved'?'on':''}" title="Saved curves">${grid}</button></span><button data-add title="${isBz(cur)?'Save this curve':'New custom curve'}">+</button></div>
      <div class="epgrid">${items.length?items.map(([n,k])=>`<button class="eptile ${on(k)?'on':''}" data-k="${k}"><i>${k==='custom'?'<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>':easeIcon(k,46)}</i><span>${n}</span></button>`).join(''):'<div class="epempty">No saved curves yet.<br>Pick Custom, shape a curve, then press + to keep it here.</div>'}</div>`;
    pop.querySelectorAll('[data-v]').forEach(b=>b.onclick=()=>{view=b.dataset.v;render()});
    pop.querySelector('[data-add]').onclick=()=>{
      if(isBz(cur)){const l=savedEases();if(!l.includes(cur)){l.push(cur);saveEases(l)}view='saved';render();toast('Curve saved')}
      else{a.ease=BZ_DEFAULT;upd();render()}
    };
    pop.querySelectorAll('.eptile').forEach(b=>b.onclick=()=>{
      const k=b.dataset.k;a.ease=k==='custom'?(isBz(cur)?cur:BZ_DEFAULT):k;upd();render();
    });
  };
  document.body.appendChild(pop);render();
  const r=btn.getBoundingClientRect(),ph=pop.offsetHeight;
  pop.style.left=Math.max(8,r.left-232)+'px';pop.style.top=Math.max(8,Math.min(r.top-40,innerHeight-ph-32))+'px';   // keeps a comfortable gap above the bottom edge of the window
  setTimeout(()=>{document.addEventListener('pointerdown',easeOutside,true);document.addEventListener('keydown',easeEsc,true)},0);
}
// custom curve: a square graph with two draggable handles
const BZX0=22,BZW=132,BZY0=16,BZVMAX=1.3,BZVMIN=-.3;
const bzPx=u=>BZX0+u*BZW,bzPy=v=>BZY0+(BZVMAX-v)*BZW;
function bezEditorHTML(k){
  const v=k.slice(3).split(',').map(Number);
  return `<div class="bzed"><svg id="bzsvg" viewBox="0 0 176 ${Math.round(BZY0*2+(BZVMAX-BZVMIN)*BZW)}">
    <rect x="${BZX0}" y="${bzPy(1)}" width="${BZW}" height="${BZW}" fill="#fff" stroke="#dcdce2"/>
    <path d="M${bzPx(0)} ${bzPy(0)}L${bzPx(1)} ${bzPy(1)}" stroke="#e4e4ea" stroke-dasharray="3 3"/>
    <line id="bzl1" stroke="#9aa0ad" /><line id="bzl2" stroke="#9aa0ad"/>
    <path id="bzp" fill="none" stroke="#2b2b31" stroke-width="2.2" stroke-linecap="round"/>
    <circle id="bzh1" r="6.500" fill="#fff" stroke="#4d98ff" stroke-width="2.500" style="cursor:grab"/><circle id="bzh2" r="6.500" fill="#fff" stroke="#4d98ff" stroke-width="2.500" style="cursor:grab"/></svg>
    <div class="bzin">${v.map((x,i)=>`<input data-bz="${i}" type="number" step="0.01" value="${x}">`).join('')}</div>
    <button class="bzsave" id="bzsave">Save to library</button></div>`;
}
function bindBez(body,a,l,upd){
  const svg=body.querySelector('#bzsvg');if(!svg)return;
  const get=()=>a.ease.slice(3).split(',').map(Number);
  const paint=()=>{
    const v=get(),f=bezier(...v),pts=[];
    for(let i=0;i<=60;i++){const u=i/60;pts.push((i?'L':'M')+bzPx(u).toFixed(1)+' '+bzPy(f(u)).toFixed(1))}
    svg.querySelector('#bzp').setAttribute('d',pts.join(''));
    [[1,0,0,v[0],v[1]],[2,1,1,v[2],v[3]]].forEach(([n,,e,x,y])=>{
      const h=svg.querySelector('#bzh'+n),ln=svg.querySelector('#bzl'+n);
      h.setAttribute('cx',bzPx(x));h.setAttribute('cy',bzPy(y));
      ln.setAttribute('x1',bzPx(e));ln.setAttribute('y1',bzPy(e));ln.setAttribute('x2',bzPx(x));ln.setAttribute('y2',bzPy(y));
    });
    body.querySelectorAll('[data-bz]').forEach((inp,i)=>{if(document.activeElement!==inp)inp.value=v[i]});
  };
  const set=v=>{a.ease='bz:'+v.map(x=>+x.toFixed(2)).join(',');paint();rebuild(l);draw()};
  [1,2].forEach(n=>{
    const h=svg.querySelector('#bzh'+n);
    h.onpointerdown=e=>{e.preventDefault();h.setPointerCapture(e.pointerId);h.style.cursor='grabbing'};
    h.onpointermove=e=>{
      if(!h.hasPointerCapture(e.pointerId))return;
      const r=svg.getBoundingClientRect(),sx=(e.clientX-r.left)/r.width*176,sy=(e.clientY-r.top)/r.height*svg.viewBox.baseVal.height;
      const u=Math.max(0,Math.min(1,(sx-BZX0)/BZW)),v=Math.max(BZVMIN,Math.min(BZVMAX,BZVMAX-(sy-BZY0)/BZW)),c=get();
      if(n===1){c[0]=u;c[1]=v}else{c[2]=u;c[3]=v}set(c);
    };
    h.onpointerup=()=>{h.style.cursor='grab';upd()};
  });
  body.querySelectorAll('[data-bz]').forEach(inp=>inp.onchange=()=>{
    const c=get(),i=+inp.dataset.bz;let x=parseFloat(inp.value);if(isNaN(x))x=c[i];
    c[i]=(i%2===0)?Math.max(0,Math.min(1,x)):Math.max(-2,Math.min(3,x));set(c);upd();
  });
  const sv=body.querySelector('#bzsave');if(sv)sv.onclick=()=>{const L=savedEases();if(!L.includes(a.ease)){L.push(a.ease);saveEases(L)}toast('Curve saved')};
  paint();
}
function animatePanel(body,l){
  const list=l.anims||[];
  if(animIdx>=list.length)animIdx=list.length-1;if(animIdx<0)animIdx=0;
  let h=layerHead(l);
  if(!list.length){/* no animations yet: the Presets / Effects picker sits right here under the Animate tab */}
  else{
    const a=list[animIdx],T=ANIMS[a.type];
    h+=`<div class="ds" style="padding-top:8px"><div class="dh"><span>${ic('zap',14)} ${esc(animLabel(a.type))}</span><span style="display:flex;gap:6px;position:relative"><button class="chg" id="chg">Change</button><button class="more" id="amore">${ic('ellipsis',16)}</button>
      <div class="menu" id="amenu"><div data-am="dup">Duplicate</div><div data-am="del">Remove</div></div></span></div></div>`;
    if(T.modes)h+=`<div class="ds"><div class="dh"><span>Mode</span><span class="seg2" style="width:150px"><button data-amode="in" class="${a.mode==='in'?'on':''}">In</button><button data-amode="out" class="${a.mode==='out'?'on':''}">Out</button></span></div></div>`;
    const rows=T.params.map(q=>R(q.outLabel&&a.mode==='out'?q.outLabel:q.label,paramControl(q,a.p[q.k],`data-ap="${q.k}"`,k=>`data-adir="${k}" data-ak="${q.k}"`))).join('');
    if(T.fxop&&a.pf){   // an effect's animation: the values it starts from (the rows below are where it ends)
      const keys=[...new Set([...Object.keys(T.fxop.from||{}),...Object.keys(T.fxop.to||{})])].filter(k=>T.params.some(q=>q.k===k&&q.kind==='num'));
      if(keys.length)h+=`<div class="ds" style="padding-top:12px"><div class="dh"><span>Start</span></div>${keys.map(k=>{const q=T.params.find(x=>x.k===k);return R(q.label,paramControl(q,a.pf[k],`data-apf="${k}"`))}).join('')}</div>`;
      if(keys.length)h+=`<div class="ds" style="padding-top:12px"><div class="dh"><span>End</span></div></div>`;
    }
    if(rows)h+=`<div class="ds" style="padding-top:12px">${rows}</div>`;
    const ecur=LEGACY_EASE[a.ease]||a.ease;
    h+=`<div class="ds"><div class="dh"><span>Animation</span><span style="position:relative"><button class="more" id="smore" style="width:30px;height:30px">${ic('ellipsis',16)}</button>
      <div class="menu" id="smenu"><div data-am="reset">Reset settings</div></div></span></div>
      ${R('Start',`<input data-astart value="${+a.start.toFixed(2)}s">`)}
      ${R('Duration',`<input data-adur value="${+a.dur.toFixed(2)}s">`)}
      ${R('Easing',`<button type="button" class="easebtn" id="aease">${easeIcon(ecur,18,1.8)}<span>${esc(easeLabel(ecur))}</span>${ic('chevron-down',14)}</button>`)}
      ${isBz(ecur)?bezEditorHTML(ecur):''}
      ${ecur==='linear'||isBz(ecur)?'':R('Intensity',`<input type="number" id="aei" min="0" max="100" step="5" value="${a.ei==null?50:a.ei}">`)}</div>`;
  }
  if(list.length)h+=`<button class="newanim" id="lnew">New Animation</button>`;   // add another animation: opens the Presets / Effects picker
  body.innerHTML=h;bindDesign(body,l);
  const ln=$('lnew');if(ln)ln.onclick=()=>{replaceIdx=null;picking=true;tab='presets';renderRight()};
  if(!list.length){
    if(tab!=='presets'&&tab!=='effects')tab='presets';
    const bar=document.createElement('div');bar.className='ptabs';
    bar.innerHTML=['presets','effects'].map(n=>`<button data-tab="${n}" class="${tab===n?'on':''}">${n.toUpperCase()}</button>`).join('');
    const box=document.createElement('div');body.appendChild(bar);body.appendChild(box);
    bar.querySelectorAll('button').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;renderRight()});
    pickerPanel(box,l);
  }
  const a=list[animIdx];
  const upd=()=>{rebuild(l);refresh()};
  body.querySelectorAll('[data-ai]').forEach(b=>b.onclick=()=>{animIdx=+b.dataset.ai;barSel=true;t=l.anims[animIdx].start;refresh()});
  if(!a)return;
  $('chg').onclick=()=>{replaceIdx=animIdx;picking=true;tab='presets';renderRight()};
  const bindMenu=(btn,menu)=>{$(btn).onclick=e=>{e.stopPropagation();const m=$(menu),open=m.style.display==='block';document.querySelectorAll('.menu').forEach(x=>x.style.display='none');m.style.display=open?'none':'block'}};
  bindMenu('amore','amenu');bindMenu('smore','smenu');
  body.querySelectorAll('[data-am]').forEach(e=>e.onclick=()=>{
    const k=e.dataset.am;
    if(k==='del'){removeAnim(l,animIdx);refresh()}
    else if(k==='dup'){const n=JSON.parse(JSON.stringify(a));n.start=+Math.min(scene.duration-0.1,a.start+a.dur).toFixed(3);l.anims.push(n);animIdx=l.anims.length-1;upd()}
    else if(k==='reset'){const T=ANIMS[a.type];a.p={...defaultsOf(T.params),...(a.mode==='out'&&T.defOut||{})};a.ease=(a.mode==='out'&&T.easeOut)||T.ease;a.ei=50;a.dur=T.dur||pDur;if(T.init)T.init(l,a);upd()}
  });
  body.querySelectorAll('[data-amode]').forEach(b=>b.onclick=()=>{
    const T=ANIMS[a.type];a.mode=b.dataset.amode;   // In and Out are separate presets in Jitter, each with its own defaults
    if(T.defOut||T.easeOut){Object.assign(a.p,a.mode==='out'?T.defOut||{}:Object.fromEntries(Object.keys(T.defOut||{}).map(k=>[k,defaultsOf(T.params)[k]])));a.ease=(a.mode==='out'&&T.easeOut)||T.ease}
    upd()});
  body.querySelectorAll('[data-adir]').forEach(b=>b.onclick=()=>{a.p[b.dataset.ak]=b.dataset.adir;upd()});
  body.querySelectorAll('[data-ap]').forEach(i=>i.onchange=()=>{a.p[i.dataset.ap]=readParam(i);upd()});
  body.querySelectorAll('[data-apf]').forEach(i=>i.onchange=()=>{(a.pf=a.pf||{})[i.dataset.apf]=readParam(i);upd()});
  const tv=i=>parseFloat(String(i.value).replace(/[^0-9.\-]/g,''));
  body.querySelector('[data-adur]').onchange=e=>{a.dur=Math.max(0.1,tv(e.target)||a.dur);scene.duration=Math.max(scene.duration,Math.ceil((a.start+a.dur)*10)/10);upd()};
  body.querySelector('[data-astart]').onchange=e=>{a.start=Math.max(0,tv(e.target)||0);scene.duration=Math.max(scene.duration,Math.ceil((a.start+a.dur)*10)/10);upd()};
  $('aease').onclick=e=>{e.stopPropagation();openEasePop($('aease'),a,upd)};
  if(isBz(a.ease))bindBez(body,a,l,upd);
  if($('aei'))$('aei').onchange=e=>{a.ei=Math.max(0,Math.min(100,parseFloat(e.target.value)||0));upd()};
}
// one handler set for every field type used by the Design / Animate / Effects panels
function bindDesign(root,l){
  const fb=root.querySelector('#fontbtn');if(fb)fb.onclick=e=>{e.stopPropagation();openFontPicker(l,fb)};
  const fw=root.querySelector('[data-weight]');if(fw)fw.onchange=()=>{const v=fw.value;l.weight=parseInt(v);l.italic=v.endsWith('i');fitText(l);refresh()};
  const TEXTY=['text','font','ls','lh','kern','liga','h'];
  root.querySelectorAll('.fop').forEach(i=>{const p=i.nextElementSibling;if(p&&!p._sc){p._sc=1;p.title='Drag to change';attachScrub(p,i)}});
  root.querySelectorAll('[data-opa]').forEach(i=>i.onchange=()=>{   // opacity of the fill / stroke colour
    if(lockedDeep(l))return;const v=Math.max(0,Math.min(100,parseFloat(i.value)||0));i.value=v;
    l[i.dataset.opa]=v/100;if(i.dataset.opa==='fillA')l.fillOn=true;draw();commitLater();
    const sw=i.closest('.fcol')&&i.closest('.fcol').querySelector('.fsw');if(sw&&i.dataset.opa==='fillA')sw.style.background=fillPreview(l);
  });
  root.querySelectorAll('[data-op]').forEach(i=>i.onchange=()=>{if(lockedDeep(l))return;const v=Math.max(0,Math.min(100,parseFloat(i.value)||0));i.value=v;l[i.dataset.op==='fill'?'fillOp':'strokeOp']=v/100;draw();commitLater()});
  root.querySelectorAll('[data-crc]').forEach(i=>i.onchange=()=>{if(lockedDeep(l)||!l.crI)return;l.crI[+i.dataset.crc]=Math.max(0,parseFloat(i.value)||0);draw();commitLater()});
  root.querySelectorAll('[data-p]').forEach(i=>i.onchange=()=>{let pv=parseFloat(i.value)||0;if(i.dataset.p==='cr'||i.dataset.p==='shadow'||i.dataset.p==='blur')pv=Math.max(0,pv);setProp(l,i.dataset.p,pv);if(i.dataset.p==='h')fitText(l);refresh()});
  root.querySelectorAll('[data-pos]').forEach(i=>i.onchange=()=>{const b=boxSize(l,state(l,t));const v=parseFloat(i.value)||0;
    if(i.dataset.pos==='x')setProp(l,'x',v+b.w/2);else setProp(l,'y',v+b.h/2);refresh()});
  root.querySelectorAll('[data-pct]').forEach(i=>i.onchange=()=>{const v=(parseFloat(i.value)||0)/100;
    if(i.dataset.pct==='shOp')l.shOp=Math.max(0,Math.min(1,v));else if(i.dataset.pct==='opacity')setProp(l,'opacity',Math.max(0,Math.min(1,v)));else setProp(l,i.dataset.pct,v);refresh()});
  root.querySelectorAll('[data-vp]').forEach(i=>{   // video volume: 0–100 in the panel (0 = silent), 0–1 in the layer
    i.oninput=()=>{let v=Math.round(parseFloat(i.value));if(isNaN(v))return;v=Math.max(0,Math.min(100,v));l.vol=v/100;draw();commitLater()};
    i.onchange=()=>{const v=Math.max(0,Math.min(100,Math.round(parseFloat(i.value)||0)));i.value=v;l.vol=v/100;draw();refresh()};
  });
  root.querySelectorAll('[data-f]').forEach(i=>i.oninput=()=>{
    const f=i.dataset.f;l[f]=i.type==='number'?(parseFloat(i.value)||0):i.value;
    if(f==='lh'&&l.lh<0){l.lh=0;i.value=0}   // line height can't be negative
    if(f==='vol'&&(l.vol<0||l.vol>1)){l.vol=Math.max(0,Math.min(1,l.vol));i.value=l.vol}   // volume stays between 0 and 1
    if(TEXTY.includes(f))fitText(l);
    if(i.type==='color'){const hx=root.querySelector(`[data-hex="${f}"]`);if(hx)hx.value=i.value.slice(1).toUpperCase()}
    if(PROPS.includes(f))rebuild(l);
    draw();commitLater();if(f==='name'||f==='text'){renderLayers();renderTL()}
  });
  root.querySelectorAll('[data-hex]').forEach(i=>i.onchange=()=>{if(/^[0-9a-f]{6}$/i.test(i.value)){l[i.dataset.hex]='#'+i.value;refresh()}else toast('Use a 6-digit hex, e.g. 7A3FF2')});
  root.querySelectorAll('[data-chk]').forEach(i=>i.onchange=()=>{
    const k=i.dataset.chk,on=i.checked;
    if(k==='fillOn')l.fillOn=on;
    else if(k==='stroke'){if(on)l.strokeW=l._sw||6;else{l._sw=l.strokeW;l.strokeW=0}}
    else if(k==='shadow'){if(on){l.shadow=l._sh||28}else{l._sh=state(l,t).shadow||28;l.shadow=0;delete l.tracks.shadow}}
    else if(k==='blur'){if(on){l.blur=l._bl||8}else{l._bl=state(l,t).blur||8;l.blur=0;delete l.tracks.blur}}
    else if(k==='bgBlur'){if(on)l.bgBlur=l._bb||16;else{l._bb=l.bgBlur;l.bgBlur=0}}
    else if(k==='vloopOn')l.vloop=on;
    else{l[k]=on;fitText(l)}
    rebuild(l);refresh();
  });
  root.querySelectorAll('[data-bg]').forEach(b=>b.onclick=e=>{
    const k=b.dataset.bg;
    if(k==='cancel'){if(bgJob)bgJob.cancel=true;return}
    if(k==='remove')removeImageBg(l);
    else if(k==='restore')restoreImageBg(l);
    else if(k==='toggle'){if(!hasCutout(l)){e.preventDefault();removeVideoBg(l)}else{l.cutout=typeof b.checked==='boolean'?b.checked:!(l.cutout!==false);refresh()}}   // a button now, a checkbox before: same switch
  });
  {const tb=root.querySelector('#tyset');if(tb)tb.onclick=e=>{e.stopPropagation();openTypeSettings(l,tb)}}
  root.querySelectorAll('[data-tx]').forEach(i=>{
    const k=i.dataset.tx,cur=()=>k==='h'?state(l,t).h:k==='lh'?(l.lhAuto?naturalLH(l):l.lhPx!=null?l.lhPx:l.lh):(l.ls||0);
    i.onchange=()=>{
      if(lockedDeep(l))return refresh();
      const raw=i.value.trim();
      if(k==='lh'){   // Figma: "150%" is a percentage of the size, a plain number (or "24px") is pixels, empty / "auto" is the font's own
        if(raw===''||/^auto$/i.test(raw)){l.lhAuto=true;fitText(l);draw();commitLater();refresh();return}
        const isPct=/%\s*$/.test(raw),body=raw.replace(/(%|px)\s*$/i,'').trim(),fs=Math.max(1,state(l,t).h);
        const pctNow=l.lhAuto?naturalLH(l):l.lhPx!=null?l.lhPx/fs*100:l.lh,n=evalNum(body,isPct?pctNow:pctNow/100*fs,false);   // arithmetic like "+10" starts from the current value in the unit typed
        if(n==null){refresh();return}
        l.lhAuto=false;if(isPct){l.lhPx=null;l.lh=Math.max(0,n)}else l.lhPx=Math.max(0,n);
        fitText(l);draw();commitLater();refresh();return;
      }
      const v=evalNum(raw,cur(),k==='ls');
      if(v==null){refresh();return}   // not a number: put the old value back
      if(k==='h'){setProp(l,'h',Math.max(1,v))}else l.ls=v;
      fitText(l);draw();commitLater();refresh();
    };
    i.onkeydown=e=>e.stopPropagation();
    const pre=i.closest('.ff')&&i.closest('.ff').querySelector('.pre');
    if(pre&&!pre._sc){pre._sc=1;attachScrub(pre,i);
      const od=pre.onpointerdown;pre.onpointerdown=e=>{if(k==='lh'&&l.lhAuto)i.value=Math.round(naturalLH(l))+'%';i.dataset.unit='%';od(e)}}   // dragging from Auto starts at the font's natural value
  });
  root.querySelectorAll('[data-seg]').forEach(b=>b.onclick=()=>{
    const[k,v]=b.dataset.seg.split(':');
    if(k==='autoResize'){
      if(v==='fixed')l.bh=Math.round(textLayout(l,l.h,l.w).th);
      l.autoResize=v;fitText(l);
    }else l[k]=v;
    refresh();
  });
  root.querySelectorAll('[data-align]').forEach(b=>b.onclick=()=>{
    const s=state(l,t),bx=boxSize(l,s),hw=bx.w*s.scale/2,hh=bx.h*s.scale/2,a=b.dataset.align;
    if(a==='left')setProp(l,'x',hw);if(a==='hcenter')setProp(l,'x',W/2);if(a==='right')setProp(l,'x',W-hw);
    if(a==='top')setProp(l,'y',hh);if(a==='vcenter')setProp(l,'y',H/2);if(a==='bottom')setProp(l,'y',H-hh);
    refresh();
  });
  root.querySelectorAll('[data-ek]').forEach(i=>i.oninput=()=>{const e=(l.effects||[])[+i.dataset.ei];if(!e)return;e.p[i.dataset.ek]=readParam(i);draw();commitLater()});
  root.querySelectorAll('[data-fxdir]').forEach(b=>b.onclick=()=>{const[i,k,v]=b.dataset.fxdir.split('|');l.effects[+i].p[k]=v;refresh()});
  root.querySelectorAll('[data-fxdel]').forEach(b=>b.onclick=()=>{l.effects.splice(+b.dataset.fxdel,1);refresh()});
  root.querySelectorAll('[data-fxon]').forEach(b=>b.onclick=()=>{const e=l.effects[+b.dataset.fxon];e.on=e.on===false;refresh()});
  const addfx=root.querySelector('#addfx');if(addfx)addfx.onclick=()=>{picking=true;tab='effects';renderRight()};
  const more=root.querySelector('#more'),menu=root.querySelector('#menu');
  if(more){
    more.onclick=e=>{e.stopPropagation();menu.style.display=menu.style.display==='block'?'none':'block'};
    menu.querySelectorAll('[data-m]').forEach(m=>m.onclick=()=>{
      const a=m.dataset.m;menu.style.display='none';
      menuAction(a);
    });
  }
}
addEventListener('click',()=>document.querySelectorAll('.menu').forEach(m=>m.style.display='none'));

function pickerPanel(body,l){
  const ra=l&&replaceIdx!=null?l.anims[replaceIdx]:null;
  if(l&&picking&&tab==='looks')body.insertAdjacentHTML('afterbegin',`<div class="back" id="back">${ic('arrow-left',14)} Back</div>`);
  let h='';
  if(tab==='presets'){
    const pm=ra&&ra.mode!=='emph'?ra.mode:'in';
    const q=pQuery.trim().toLowerCase();
    const group=(title,types,mode,stat)=>{
      const list=types.filter(type=>!q||animLabel(type).toLowerCase().includes(q)||title.toLowerCase().includes(q));
      if(!list.length)return;
      h+=`<div class="sec">${title}</div><div class="grid2">`;
      list.forEach(type=>{
        const pdur=ANIMS[type].dur||1,spec=mkAnim(type,mode,0,pdur),isCur=ra&&ra.type===type&&ra.mode===spec.mode;
        h+=card(thumbs,animLabel(type),animScene([spec]),stat,pdur,()=>{
          if(ra)changeAnim(l,ra,type,mode);else addAnim(type,mode);
        },isCur?'<span class="cur">Current</span>':'');
      });
      h+='</div>';
    };
    const st=pm==='in'?1:0;
    const isTextSel=l&&selected().length&&selected().every(x=>x.type==='text');
    const tgroup=(title,items,staticT)=>{
      const list=items.filter(([label])=>!q||label.toLowerCase().includes(q)||title.toLowerCase().includes(q));
      if(!list.length)return;
      h+=`<div class="sec">${title}</div><div class="grid2">`;
      list.forEach(([label,type,params])=>{
        const spec=mkAnim(type,pm,0,1,params),sc=animScene([spec]);if(!sc.sel)sc.layers[0].text='Hello';
        const isCur=ra&&ra.type===type&&ra.mode===spec.mode&&Object.keys(params||{}).every(k=>ra.p[k]===params[k]);
        h+=card(thumbs,label,sc,staticT,1,()=>{if(ra)changeAnim(l,ra,type,pm,params);else addAnim(type,pm,params)},isCur?'<span class="cur">Current</span>':'');
      });
      h+='</div>';
    };
    if(isTextSel){
      TEXT_PRESETS.forEach(([title,items])=>tgroup(title,items,st));
    }else{
    group('Fade',['Fade','Slide'],pm,st);
    group('Scale',['Grow','Shrink','Spin','Twist','MoveScale'],pm,st);
    group('Mask',['Wipe','MaskCenter','MaskResize','MaskSlide','MaskSize'],pm,st);
    group('Blur',['Blur','BlurSlide','BlurScale'],pm,st);
    group('Effects',['Dissolve','NoiseWipe','PixelReveal','PixelWipe','LumaReveal','Blink','Glitch','BarrelT','FilmT'],pm,st);
    group('Other',['Bounce','Show'],pm,st);
    }
  }else if(tab==='custom'){
    const types=new Set(selected().map(x=>x.type)),none=!selected().length;
    const has=(...t)=>none||t.some(x=>types.has(x));
    const CUSTOM=[
      ['Transform',[['Move','Move'],['ScaleTo','Scale'],['Rotate','Rotate']]],
      ['Style',[['Opacity','Opacity'],['ColorTo','Color'],['ShadowTo','Shadow']]],
      ['Effects',[['BlurTo','Layer Blur'],['BgBlurTo','Background Blur'],['GlassTo','Glass']]],
      ['Text',has('text')&&!none?[['ChangeText','Change Text'],['LetterSpacing','Letter Spacing'],['LineHeight','Line Height'],['Counter','Counter']]:[]],
      ['Other',[['Show','Hide / Show'],['Resize','Resize'],
        ...(has('rect','image')&&!none?[['CornerRadius','Corner Radius']]:[]),
        ...(types.has('ellipse')?[['Arc','Arc']]:[]),
        ...(types.has('star')?[['StarTo','Star']]:[]),
        ['StrokeTo','Stroke']]]
    ].filter(x=>x[1].length);
    const frameHTML='';
    const listHTML=CUSTOM.map(([title,items])=>`<div class="csec"><div class="ctitle">${title}</div>`+items.map(([type,label])=>`<button class="crow ${ra&&ra.type===type?'cur':''} " data-ctype="${type}"><i>${CICON[type]||''}</i><span>${label}</span></button>`).join('')+'</div>').join('');
    h=none&&!ra?frameHTML+listHTML:listHTML+frameHTML;
  }else if(tab==='effects'){
    const pm=ra&&ra.mode!=='emph'?ra.mode:'in',onlyText=l&&selected().length&&selected().every(x=>x.type==='text');
    const fromDesign=picking==='design';
    FX_CATS.forEach(([title,ids])=>{
      h+=`<div class="sec">${title}</div><div class="grid2">`;
      ids.forEach(id=>{
        const d=FXLIB[id];if(!d)return;
        const sc=picScene(L=>{if(d.pre){const df=defaultsOf(d.params);L.fxHold=[{id,p:{...df,...d.pre.to},pf:{...df,...d.pre.from},start:0,dur:2,ease:d.pre.ease||'linear',ei:50}];L.effects=[]}else L.effects=[{id,p:defaultsOf(d.params)}]},{orbit3d:'orbit3d'}[id]||id);
        h+=card(thumbs,d.label,sc,0,2,()=>{
          const Ls=selected();if(!Ls.length)return toast('Select a layer first');
          if(picking==='design'){   // from the Design tab: a fixed effect on the layer (listed under Design → Effects)
            Ls.forEach(L=>{(L.effects=L.effects||[]).push({id,p:defaultsOf(d.params)})});if(!keepOpen){picking=false;ptab='design'}refresh();toast(d.label+' added');
          }else{addAnim('Fx:'+id,'emph',{});toast(d.label+' added')}   // from the Animate tab: an animation with its own timeline bar
        },'',true);
      });
      h+='</div>';
    });
  }else if(tab==='looks'){
    h='<div class="sec" style="margin-top:0">Style</div><div class="grid2">';
    for(const n in FX)h+=card(thumbs,n,fxScene(FX[n]),0,n==='Wiggle'?2:0,()=>{const Ls=selected();if(!Ls.length)return toast('Select a layer first');Ls.forEach(L=>{FX[n](L);rebuild(L)});picking=false;ptab='design';refresh()});
    h+='</div><div class="sec">Shader effects</div><div class="grid2">';
    for(const id in FXLIB){
      const d=FXLIB[id];if(d.kind!=='static')continue;
      h+=card(thumbs,d.label,fxLibScene(id),0,2,()=>{
        const Ls=selected();if(!Ls.length)return toast('Select a layer first');
        Ls.forEach(L=>{(L.effects=L.effects||[]).push({id,p:defaultsOf(d.params)})});
        picking=false;ptab='design';refresh();toast(d.label+' added');
      });
    }
    h+='</div>';
    if(l&&isSingleLeaf())h+=`<div class="sec">More effects</div>
      ${R('Glow',`<input type="number" data-p="glow" value="${Math.round(state(l,t).glow)}">`)}
      ${R('Reveal',`<input type="number" step="0.05" data-p="reveal" value="${+state(l,t).reveal.toFixed(2)}">`)}
      ${R('Direction',`<select data-f="revealDir">${['left','right','up','down','circle'].map(b=>`<option ${b===l.revealDir?'selected':''}>${b}</option>`).join('')}</select>`)}
      ${R('Blend',`<select data-f="blend">${['source-over','multiply','screen','overlay','difference','lighter','hard-light'].map(b=>`<option ${b===l.blend?'selected':''}>${b}</option>`).join('')}</select>`)}
      ${R('Wiggle',`<span class="two"><input type="number" min="0" data-f="wig" value="${l.wig}" title="amount"><input type="number" data-f="wigSpeed" value="${l.wigSpeed}" title="speed"></span>`)}`;
    else h+='<div class="hint" style="margin-top:14px">Select a layer to apply effects.</div>';
  }
  body.insertAdjacentHTML('beforeend',h);
  bindCards(body);
  if(l)bindDesign(body,l);
  const b=$('back');if(b)b.onclick=()=>{picking=false;replaceIdx=null;renderRight()};
  const rm=$('rmanim');if(rm)rm.onclick=()=>{removeAnim(l,replaceIdx);replaceIdx=null;picking=false;ptab='animate';refresh()};
  body.querySelectorAll('[data-pm]').forEach(b=>b.onclick=()=>{pMode=b.dataset.pm;renderRight()});
  body.querySelectorAll('[data-ctype]').forEach(b=>b.onclick=()=>{
    const type=b.dataset.ctype,mode=ANIMS[type].modes?'in':'emph';
    if(ra)changeAnim(l,ra,type,mode);else addAnim(type,mode);
  });
  const ps=$('psearch');if(ps)ps.oninput=e=>{pQuery=e.target.value;renderRight();const n=$('psearch');if(n){n.focus();n.setSelectionRange(pQuery.length,pQuery.length)}};
  const pd=$('pd');if(pd)pd.oninput=e=>{pDurSet=true;pDur=Math.max(.1,parseFloat(e.target.value)||.8)};
  const pa=$('pall');if(pa)pa.onchange=e=>pStag=e.target.checked;
  const cs=$('cs');if(cs)cs.onclick=()=>saveCustom($('cn').value.trim());
  body.querySelectorAll('[data-del]').forEach(b=>b.onclick=ev=>{ev.stopPropagation();customs.splice(+b.dataset.del,1);saveCustoms();renderRight()});
  const fb=$('fbg');if(fb)fb.oninput=e=>{scene.bg=e.target.value;drawAll();commitLater()};
}
function selBounds(ls){
  let x0=1e9,x1=-1e9,y0=1e9,y1=-1e9;
  ls.forEach(l=>{const{s,hw,hh}=layerBox(l,t);x0=Math.min(x0,s.x-hw);x1=Math.max(x1,s.x+hw);y0=Math.min(y0,s.y-hh);y1=Math.max(y1,s.y+hh)});
  return{x0,x1,y0,y1};
}
const multiHead=title=>`<div class="lhead"><span class="ti">${ic('layers',16)}</span><span class="nm2" style="font-weight:600">${esc(title)}</span>${boolBtnHTML()}<button class="more" id="more">${ic('ellipsis',16)}</button>${MENU_HTML()}</div>`;
// spacing between selected elements: the left-most / top-most one stays, the others are re-spaced so each gap equals the value
const gapNodes=()=>topSelNodes().map(n=>({n,b:selBounds(leavesOfNode(n))}));
function currentGap(axis){
  const a=gapNodes().sort((p,q)=>axis==='x'?p.b.x0-q.b.x0:p.b.y0-q.b.y0);if(a.length<2)return 0;
  let sum=0;for(let i=1;i<a.length;i++)sum+=axis==='x'?a[i].b.x0-a[i-1].b.x1:a[i].b.y0-a[i-1].b.y1;
  return Math.round(sum/(a.length-1));
}
function applyGap(axis,gap){
  const a=gapNodes().sort((p,q)=>axis==='x'?p.b.x0-q.b.x0:p.b.y0-q.b.y0);if(a.length<2)return;
  const k=axis==='x'?'x':'y',lo=axis==='x'?'x0':'y0',hi=axis==='x'?'x1':'y1';
  let edge=a[0].b[hi];
  for(let i=1;i<a.length;i++){
    const d=edge+gap-a[i].b[lo],size=a[i].b[hi]-a[i].b[lo];
    if(d)leavesOfNode(a[i].n).forEach(l=>{if(!lockedDeep(l))setProp(l,k,state(l,t)[k]+d)});
    edge=a[i].b[lo]+d+size;
  }
}
function multiPanel(body,ls){
  const avg=Math.round(ls.reduce((a,l)=>a+state(l,t).opacity,0)/ls.length*100);
  const fills=ls.filter(l=>l.type!=='image');
  let h=multiHead(selTitle(ls))+`<div class="alignrow">${['left','hcenter','right','top','vcenter','bottom'].map(a=>`<button data-malign="${a}" title="Align ${a}">${alignSvg(a)}</button>`).join('')}</div>`;
  if(topSelNodes().length>1){
    const f=(axis,label,icon)=>`<div class="fcell"><div class="fl">${label}</div><label class="ff"><i class="pre">${ic(icon,13)}</i><input type="number" data-gap="${axis}" value="${currentGap(axis)}"></label></div>`;
    h+=`<div class="fsec"><div class="fhd"><span>Spacing</span><span class="fact"></span></div><div class="f2">${f('x','Horizontal','move-horizontal')}${f('y','Vertical','move-vertical')}</div></div>`;
  }
  h+=sec('Opacity','',`<span><input type="number" data-mo="opacity" value="${avg}" style="width:64px"> %</span>`);
  // every distinct colour among the selected layers gets its own row, so each one can be changed on its own
  const groupBy=key=>{const m=new Map();ls.forEach(l=>{if(l.type==='image'||(key==='stroke'&&!(l.strokeW>0)))return;const c=String(l[key]||'#000000').toLowerCase();if(!m.has(c))m.set(c,[]);m.get(c).push(l)});return[...m.entries()]};
  const mg=body._mg={fill:groupBy('fill'),stroke:groupBy('stroke')};
  const rows=key=>mg[key].map(([c,Ls],i)=>`<div class="fcol" title="${esc(Ls.map(l=>l.name).join(', '))}"><input type="color" class="fsw" data-mg="${key}:${i}" value="${c}"><input class="fhex" data-mgh="${key}:${i}" value="${c.slice(1).toUpperCase()}" maxlength="6"><span class="fpc" style="cursor:default">${Ls.length>1?Ls.length+' layers':esc(Ls[0].name)}</span></div>`).join('');
  if(mg.fill.length)h+=`<div class="fsec"><div class="fhd"><span>Fill</span><span class="fact"></span></div>${rows('fill')}</div>`;
  if(mg.stroke.length)h+=`<div class="fsec"><div class="fhd"><span>Stroke</span><span class="fact"></span></div>${rows('stroke')}</div>`;
  h+=`<div class="hint" style="margin-top:14px;line-height:1.6">Drag on the canvas to move them together. Shift-click adds or removes a layer; drag on empty space to box-select. ⌘G groups, ⌘⇧G ungroups, arrow keys nudge.</div>`;
  body.innerHTML=h;bindMulti(body,ls);
}
function multiAnimate(body,ls){
  body.innerHTML=multiHead(selTitle(ls))+`<div class="hint" style="margin-top:4px">New animations apply to all ${ls.length} selected layers.</div>`;
  bindMulti(body,ls);
  // the Presets / Effects picker sits right under the Animate tab
  if(tab!=='presets'&&tab!=='effects')tab='presets';
  const bar=document.createElement('div');bar.className='ptabs';
  bar.innerHTML=['presets','effects'].map(n=>`<button data-tab="${n}" class="${tab===n?'on':''}">${n.toUpperCase()}</button>`).join('');
  const box=document.createElement('div');body.appendChild(bar);body.appendChild(box);
  bar.querySelectorAll('button').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;renderRight()});
  pickerPanel(box,cur()||ls[0]);
}
function bindMulti(body,ls){
  body.querySelectorAll('[data-malign]').forEach(b=>b.onclick=()=>{
    const bb=selBounds(ls),a=b.dataset.malign;
    ls.forEach(l=>{const{hw,hh}=layerBox(l,t);
      if(a==='left')setProp(l,'x',bb.x0+hw);if(a==='hcenter')setProp(l,'x',(bb.x0+bb.x1)/2);if(a==='right')setProp(l,'x',bb.x1-hw);
      if(a==='top')setProp(l,'y',bb.y0+hh);if(a==='vcenter')setProp(l,'y',(bb.y0+bb.y1)/2);if(a==='bottom')setProp(l,'y',bb.y1-hh)});
    refresh();
  });
  body.querySelectorAll('[data-gap]').forEach(i=>i.onchange=()=>{applyGap(i.dataset.gap,parseFloat(i.value)||0);refresh()});
  const setGroup=(spec,val)=>{const[key,n]=spec.split(':'),g=body._mg[key][+n];if(!g)return;g[1].forEach(l=>{l[key]=val});draw();commitLater()};
  body.querySelectorAll('[data-mg]').forEach(i=>i.oninput=()=>{setGroup(i.dataset.mg,i.value);const hx=body.querySelector(`[data-mgh="${i.dataset.mg}"]`);if(hx)hx.value=i.value.slice(1).toUpperCase()});
  body.querySelectorAll('[data-mgh]').forEach(i=>i.onchange=()=>{if(/^[0-9a-f]{6}$/i.test(i.value)){setGroup(i.dataset.mgh,'#'+i.value);const sw=body.querySelector(`[data-mg="${i.dataset.mgh}"]`);if(sw)sw.value='#'+i.value.toLowerCase()}else toast('Use a 6-digit hex, e.g. 7A3FF2')});
  body.querySelectorAll('[data-mo]').forEach(i=>{
    if(i.dataset.mo==='opacity')i.onchange=()=>{const v=(parseFloat(i.value)||0)/100;ls.forEach(l=>setProp(l,'opacity',v));refresh()};
    else i.oninput=()=>{ls.forEach(l=>{if(l.type!=='image')l.fill=i.value});draw();commitLater()};
  });
  const more=body.querySelector('#more'),menu=body.querySelector('#menu');
  if(more){
    more.onclick=e=>{e.stopPropagation();menu.style.display=menu.style.display==='block'?'none':'block'};
    menu.querySelectorAll('[data-m]').forEach(m=>m.onclick=()=>{
      const a=m.dataset.m;menu.style.display='none';
      menuAction(a);
    });
  }
}
const FRAME_PRESETS=[['Instagram story',1080,1920],['Instagram post',1080,1350],['Square',1080,1080],['YouTube · Full HD',1920,1080],['HD',1280,720],['X / Twitter',1600,900],['Desktop',1440,1024],['Tablet',820,1180],['Mobile',390,844]];
const framePos=i=>{const f=project.frames[i];if(f.px!=null)return f.px;let x=0;for(let j=0;j<i;j++)x+=(project.frames[j].w||1280)+120;return x};
function resizeFrame(f,w,h){
  f.w=Math.max(16,Math.min(8000,Math.round(w)||f.w||1280));f.h=Math.max(16,Math.min(8000,Math.round(h)||f.h||720));
  if(f===scene){W=f.w;H=f.h}
  buildFrames();refresh();
}
function framePanel(body){
  const f=scene,off=f.bgOn===false,fw=f.w||1280,fh=f.h||720,preset=FRAME_PRESETS.find(p=>p[1]===fw&&p[2]===fh);
  const layout=sec('Layout',
    R('Format',`<select id="ffmt"><option value="" ${preset?'':'selected'}>Size preset</option>${FRAME_PRESETS.map((p,k)=>`<option value="${k}" ${preset===p?'selected':''}>${p[0]} · ${p[1]}×${p[2]}</option>`).join('')}</select>`)+
    R('Position',`<span class="two"><input type="number" id="fpx" value="${Math.round(framePos(fi))}"><input type="number" id="fpy" value="${Math.round(f.py||0)}"></span>`)+
    R('Size',`<span class="two"><input type="number" id="fw" min="16" max="8000" value="${fw}"><input type="number" id="fh" min="16" max="8000" value="${fh}"></span>`));
  const dur=`<div class="ds" style="border-bottom:0"><div class="dh"><span>Duration</span><input class="durf" id="fdur" value="${+f.duration.toFixed(2)}s"></div></div>`;
  let h=`<div class="lhead"><span class="ti">${ic('frame',16)}</span><input class="nm2" id="fname" value="${esc(f.name)}"><button class="more" id="ffit" title="Fit frame in view" style="width:36px">${ic('maximize',16)}</button><button class="more" id="more" style="width:36px">${ic('ellipsis',16)}</button><div class="menu" id="menu"><div data-fm="dup">Duplicate frame</div><div data-fm="del">Delete frame</div></div></div>`;
  h+=layout;
  if(ptab==='animate')h+=dur+`<button class="newanim" id="fnew">New Animation</button>`;
  else h+=sec('Fill',`<div class="dr"><label>Color</label><div class="fcol" style="margin-bottom:0"><button class="fsw" id="fsw" data-pick="bg" title="Colour" style="background:${f.bg}"></button><input class="fhex" id="fhex" value="${f.bg.slice(1).toUpperCase()}" maxlength="6"></div></div>`)+dur;
  body.innerHTML=h;
  const fd=$('fdur');if(fd){fd.onkeydown=e=>{e.stopPropagation();if(e.key==='Enter')e.target.blur()};
    // the frame's length is set by its bars, so a new length stretches / squeezes every bar (start and length) by the same factor
    fd.onchange=e=>{
      const old=calcDuration(f),v=parseFloat(String(e.target.value).replace(/[^0-9.]/g,''));
      if(!isFinite(v)||v<=0||!(f.layers.some(l=>(l.anims||[]).length||((l.type==='audio'||l.video)&&l.outT!=null)))){e.target.value=+old.toFixed(2)+'s';return}
      let k=Math.min(MAXT,Math.max(0.5,v))/old;
      f.layers.forEach(l=>(l.anims||[]).forEach(a=>{k=Math.max(k,.1/a.dur)}));
      const r=n=>+(n*k).toFixed(3);
      f.layers.forEach(l=>{
        (l.anims||[]).forEach(a=>{a.start=r(a.start);a.dur=r(a.dur)});
        if(l.inT)l.inT=r(l.inT);if(l.outT!=null)l.outT=r(l.outT);
        rebuild(l);
      });
      t=Math.min(t*k,MAXT);refresh();
    }}
  $('fname').oninput=e=>{f.name=e.target.value;updateLabels();renderLayers();commitLater()};
  $('fname').onkeydown=e=>{e.stopPropagation();if(e.key==='Enter')e.target.blur()};
  $('ffit').onclick=()=>setZoom('fit');
  $('ffmt').onchange=e=>{if(e.target.value==='')return;const p=FRAME_PRESETS[+e.target.value];resizeFrame(f,p[1],p[2])};
  $('fw').onchange=e=>resizeFrame(f,+e.target.value,fh);
  $('fh').onchange=e=>resizeFrame(f,fw,+e.target.value);
  $('fpy').onchange=e=>{f.py=+e.target.value||0;applyZoom();commitSoon()};
  $('fpx').onchange=e=>{
    project.frames.forEach((fr,i)=>{fr.px=framePos(i)});
    f.px=+e.target.value||0;
    fi=project.frames.indexOf(f);
    buildFrames();refresh();
  };
  const more=$('more'),menu=$('menu');
  more.onclick=e=>{e.stopPropagation();menu.style.display=menu.style.display==='block'?'none':'block'};
  menu.querySelectorAll('[data-fm]').forEach(m=>m.onclick=()=>{menu.style.display='none';if(m.dataset.fm==='dup')dupFrame(fi);else delFrame(fi)});
  const on=$('fbgon');if(on)on.onchange=()=>{f.bgOn=on.checked;drawAll();commitSoon();renderRight()};
  const hx=$('fhex');if(hx)hx.onchange=()=>{hx.value=hx.value.replace(/^#/,'');if(/^[0-9a-f]{6}$/i.test(hx.value)){f.bg='#'+hx.value.toUpperCase();f.bgOn=true;drawAll();commitSoon();renderRight()}else toast('Use a 6-digit hex, e.g. FFFDF8')};
  const sw=$('fsw');if(sw)sw.onclick=e=>{e.stopPropagation();openColorPicker(f,'bg',sw)};   // the same colour picker as the layer fills
  const nw=$('fnew');if(nw)nw.onclick=()=>{
    const ids=childrenOf(scene.layers,null).map(l=>l.id);if(!ids.length)return toast('Add a layer first');
    frameSel=false;setSel(ids);ptab='animate';picking=true;tab='presets';renderRight();
  };
}
function renderRight(){renderRight0();decorateNumbers($('rbody'))}
function renderRight0(){
  const tabsEl=$('tabs'),body=$('rbody'),l=cur();thumbs.length=0;hov=null;visCards.clear();
  {const hide=!picking&&(!!l||frameSel)&&ptab==='design';   // the timeline is only needed in the Animate tab
   if(document.body.classList.contains('notl')!==hide){document.body.classList.toggle('notl',hide);setTimeout(()=>{if(typeof applyZoom==='function')applyZoom()},0)}}
  const sk=[...selSet].join(',');if(lastSel!==sk){picking=false;replaceIdx=null;lastSel=sk}
  body.innerHTML='';
  if(!l&&frameSel&&!picking){
    tabsEl.className='seg';
    tabsEl.innerHTML=['design','animate'].map(x=>`<button data-pt="${x}" class="${ptab===x?'on':''}">${x[0].toUpperCase()+x.slice(1)}</button>`).join('');
    tabsEl.querySelectorAll('button').forEach(b=>b.onclick=()=>{ptab=b.dataset.pt;renderRight()});
    framePanel(body);return;
  }
  if(l&&!picking){
    tabsEl.className='seg';
    tabsEl.innerHTML=['design','animate'].map(x=>`<button data-pt="${x}" class="${ptab===x?'on':''}">${x[0].toUpperCase()+x.slice(1)}</button>`).join('');
    tabsEl.querySelectorAll('button').forEach(b=>b.onclick=()=>{ptab=b.dataset.pt;renderRight()});
    if(isMulti()){if(ptab==='design')multiPanel(body,selected());else multiAnimate(body,selected())}
    else if(ptab==='design'||l.type==='audio')designPanel(body,l);else animatePanel(body,l);
    return;
  }
  if(l&&picking){   // changing / replacing an animation: Design | Animate on top, then Remove, then Presets | Effects
    tabsEl.className='seg';
    tabsEl.innerHTML=['design','animate'].map(x=>`<button data-pt="${x}" class="${x===(picking==='design'?'design':'animate')?'on':''}">${x[0].toUpperCase()+x.slice(1)}</button>`).join('');
    tabsEl.querySelectorAll('button').forEach(b=>b.onclick=()=>{ptab=b.dataset.pt;picking=false;replaceIdx=null;renderRight()});
    const hasRep=replaceIdx!=null&&l.anims&&l.anims[replaceIdx];
    body.innerHTML=hasRep?'<button class="pbtn" id="rmanim" style="width:100%;margin:12px 0 0">Remove</button>':'';
    if(tab!=='presets'&&tab!=='effects'&&tab!=='looks')tab='presets';
    const box=document.createElement('div');
    if(tab!=='looks'&&picking!=='design'){const bar=document.createElement('div');bar.className='ptabs';
      bar.innerHTML=['presets','effects'].map(n=>`<button data-tab="${n}" class="${tab===n?'on':''}">${n.toUpperCase()}</button>`).join('');
      bar.querySelectorAll('button').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;renderRight()});body.appendChild(bar)}
    if(!hasRep&&picking!=='design')body.insertAdjacentHTML('beforeend','<div class="hint" style="margin:8px 0 0">Shift-click a preset to add several in a row.</div>');
    body.appendChild(box);pickerPanel(box,l);return;
  }
  if(!l&&!frameSel){   // nothing selected: the same Design / Animate layout, with a prompt instead of a layer
    tabsEl.className='seg';
    tabsEl.innerHTML=['design','animate'].map(x=>`<button data-pt="${x}" class="${ptab===x?'on':''}">${x[0].toUpperCase()+x.slice(1)}</button>`).join('');
    tabsEl.querySelectorAll('button').forEach(b=>b.onclick=()=>{ptab=b.dataset.pt;renderRight()});
    body.innerHTML=`<div class="lhead"><span class="nm2" style="font-weight:600;padding:6px 0">Nothing selected</span></div><div class="hint" style="margin-top:4px;line-height:1.6">Select a layer or a frame on the canvas to edit its design or to add animations.</div>`;
    return;
  }
  tabsEl.className='';
  const names=['presets','effects'];
  if(!names.includes(tab)&&tab!=='looks')tab=names[0];
  tabsEl.innerHTML=tab==='looks'?'':names.map(n=>`<button data-tab="${n}" class="${tab===n?'on':''}">${n.toUpperCase()}</button>`).join('');
  tabsEl.querySelectorAll('button').forEach(b=>b.onclick=()=>{tab=b.dataset.tab;renderRight()});
  pickerPanel(body,l);
}

// ---------- layers panel (tree) ----------
function treeRows(q){
  const out=[];
  const match=n=>!q||n.name.toLowerCase().includes(q)||(n.type==='group'&&descendantsOf(n).some(d=>d.name.toLowerCase().includes(q)));
  const rec=(pid,depth)=>childrenOf(scene.layers,pid).slice().reverse().forEach(n=>{
    if(!match(n))return;
    out.push({n,depth});
    if(n.type==='group'&&(n.expanded!==false||q))rec(n.id,depth+1);
  });
  rec(null,0);return out;
}
let dragNodeId=null,rowDragged=false;
// press and drag a layer row: it follows the pointer, a line shows where it will land; drop on a group to put it inside
function startRowDrag(ev,el){
  if(ev.button!==0||ev.target.closest('.acts,.car,.rn'))return;
  const id=+el.dataset.id,x0=ev.clientX,y0=ev.clientY,L=$('llist'),scroller=$('layers');
  let started=false,ghost=null,target=null,zone=null;
  const rows=()=>[...L.querySelectorAll('.li.child')];
  const clear=()=>rows().forEach(x=>x.classList.remove('dz-before','dz-after','dz-inside'));
  const mv=m=>{
    if(!started){
      if(Math.hypot(m.clientX-x0,m.clientY-y0)<4)return;
      started=true;rowDragged=true;document.body.classList.add('rowdrag');
      if(!selSet.has(id)){selectOnly(id);el.classList.add('sel')}
      ghost=el.cloneNode(true);ghost.classList.add('ghost');ghost.style.width=el.offsetWidth+'px';document.body.appendChild(ghost);
    }
    ghost.style.left=(m.clientX+10)+'px';ghost.style.top=(m.clientY-12)+'px';
    const sr=scroller.getBoundingClientRect();
    if(m.clientY<sr.top+36)scroller.scrollTop-=10;else if(m.clientY>sr.bottom-36)scroller.scrollTop+=10;
    clear();target=null;zone=null;
    const list=rows();if(!list.length)return;
    const first=list[0].getBoundingClientRect(),last=list[list.length-1].getBoundingClientRect();
    let under=list.find(r=>{const b=r.getBoundingClientRect();return m.clientY>=b.top&&m.clientY<b.bottom});
    if(!under&&m.clientY<first.top)under=list[0];
    if(!under&&m.clientY>=last.bottom)under=list[list.length-1];
    if(!under)return;
    const tid=+under.dataset.id,tgt=byId(tid);
    if(tid===id||!tgt)return;
    const b=under.getBoundingClientRect(),y=Math.max(0,Math.min(1,(m.clientY-b.top)/b.height));
    zone=tgt.type==='group'?(y<.25?'before':y>.75?'after':'inside'):(y<.5?'before':'after');
    if(m.clientY<first.top)zone='before';else if(m.clientY>=last.bottom)zone='after';
    target=tid;under.classList.add('dz-'+zone);
  };
  const up=()=>{
    removeEventListener('pointermove',mv);removeEventListener('pointerup',up);removeEventListener('pointercancel',up);
    document.body.classList.remove('rowdrag');if(ghost)ghost.remove();clear();
    if(started&&target!=null&&zone)moveNode(id,target,zone);else if(started)refresh();
    setTimeout(()=>{rowDragged=false},0);
  };
  addEventListener('pointermove',mv);addEventListener('pointerup',up);addEventListener('pointercancel',up);
}
let lsMatches=[],lsIdx=-1;
function renderLayers(){
  const q=$('lsearch').value.toLowerCase().trim();let h='';lsMatches=[];
  const subSel=new Set();selNodes().forEach(n=>{if(n.type==='group')descendantsOf(n).forEach(d=>subSel.add(d.id))});
  project.frames.forEach((f,i)=>{
    // while searching, every frame is searched (names and layers), not only the open one
    let found=null;
    if(q){const sv=scene;scene=f;try{found=treeRows(q)}finally{scene=sv}
      if(f.name.toLowerCase().includes(q))lsMatches.push({fi:i,id:null});found.forEach(({n})=>{if(n.name.toLowerCase().includes(q))lsMatches.push({fi:i,id:n.id})});
      if(!f.name.toLowerCase().includes(q)&&!found.length)return}
    h+=`<div class="li frame ${i===fi&&!noFrame?'sel':''}" data-fr="${i}"><span class="ic">${ic('frame',14)}</span>${esc(f.name)}<span class="fb"><span data-fhide="${i}" class="${f.hidden?'on':''}" title="Show / hide frame">${ic(f.hidden?'eye-off':'eye',14)}</span><span data-flock="${i}" class="${f.locked?'on':''}" title="Lock / unlock frame">${ic(f.locked?'lock':'lock-open',14)}</span></span></div>`;
    if(q&&i!==fi)found.forEach(({n,depth})=>{h+=`<div class="li child xf" data-fi="${i}" data-xid="${n.id}" style="padding-left:${10+depth*16}px"><span class="car"></span><span class="ic">${n.video?ICON.video:ICON[n.type]||ic('rectangle-horizontal',14)}</span><span class="nmtxt">${esc(n.name)}</span></div>`});
    if(i===fi)treeRows(q).forEach(({n,depth})=>{
      const isG=n.type==='group',open=isG&&(n.expanded!==false||!!q),cls=['li','child'];
      if(selSet.has(n.id))cls.push('sel');else if(subSel.has(n.id))cls.push('sub');
      if(hiddenDeep(n))cls.push('dim');
      const name=renaming===n.id?`<input class="rn" data-rn="${n.id}" value="${esc(n.name)}">`:`<span class="nmtxt" data-nm="${n.id}">${esc(n.name)}</span>`;
      h+=`<div class="${cls.join(' ')}" data-id="${n.id}" style="padding-left:${10+depth*16}px"><span class="car" ${isG?`data-car="${n.id}"`:''}>${isG?ic(open?'chevron-down':'chevron-right',12):''}</span><span class="ic">${n.video?ICON.video:ICON[n.type]||ic('rectangle-horizontal',14)}</span>${name}${n.mask?`<span class="mk" title="Mask group">${ic('contrast',13)}</span>`:''}<span class="acts"><span data-hide="${n.id}" class="${n.hidden?'on':''}" title="Show / hide">${ic(n.hidden?'eye-off':'eye',14)}</span><span data-lock="${n.id}" class="${n.locked?'on':''}" title="Lock / unlock">${ic(n.locked?'lock':'lock-open',14)}</span><span class="dupbtn" data-dupl="${n.id}" title="Duplicate (⌘D / Ctrl+D)">${ic('copy',14)}</span></span></div>`;
    });
  });
  const L=$('llist');L.innerHTML=h;
  {const r=$('lres'),n=lsMatches.length;r.classList.toggle('on',!!q);$('lcount').textContent=`${n} result${n>1?'s':''}`;$('lup').disabled=$('ldn').disabled=!n}
  L.querySelectorAll('.li.child.xf').forEach(el=>el.onclick=()=>{switchFrame(+el.dataset.fi);selectOnly(+el.dataset.xid);refresh()});
  const rows=[...L.querySelectorAll('.li.child:not(.xf)')];
  rows.forEach(el=>{
    const id=+el.dataset.id;
    el.onclick=ev=>{
      if(rowDragged||ev.target.closest('.acts,.car,.rn'))return;
      if(ev.shiftKey||ev.metaKey||ev.ctrlKey)toggleSel(id);else selectOnly(id);refresh();
    };
    el.oncontextmenu=ev=>{ev.preventDefault();if(ev.shiftKey){toggleSel(id);selKey=null;refresh();return}   // Shift + right-click adds / removes this layer
      if(!selSet.has(id)){selectOnly(id);refresh()}showContext(ev.clientX,ev.clientY)};
    el.onpointerdown=ev=>startRowDrag(ev,el);
  });
  L.querySelectorAll('[data-car]').forEach(e=>e.onclick=ev=>{ev.stopPropagation();const g=byId(+e.dataset.car);g.expanded=g.expanded===false;renderLayers();renderTL()});
  L.querySelectorAll('[data-hide]').forEach(e=>e.onclick=ev=>{ev.stopPropagation();const id=+e.dataset.hide;toggleFlag(selSet.has(id)?topSelNodes():[byId(id)],'hidden')});
  L.querySelectorAll('[data-lock]').forEach(e=>e.onclick=ev=>{ev.stopPropagation();const id=+e.dataset.lock;toggleFlag(selSet.has(id)?topSelNodes():[byId(id)],'locked')});
  L.querySelectorAll('[data-nm]').forEach(e=>e.ondblclick=ev=>{ev.stopPropagation();startRename(+e.dataset.nm)});
  const rn=L.querySelector('.rn');
  if(rn){
    setTimeout(()=>{rn.focus();rn.select()},0);let done=false;
    const commit=ok=>{if(done)return;done=true;const n=byId(+rn.dataset.rn);if(ok&&n&&rn.value.trim())n.name=rn.value.trim();renaming=null;refresh()};
    rn.onkeydown=ev=>{ev.stopPropagation();if(ev.key==='Enter')commit(true);else if(ev.key==='Escape')commit(false)};
    rn.onblur=()=>commit(true);rn.onclick=ev=>ev.stopPropagation();
  }
  L.querySelectorAll('[data-fr]').forEach(e=>e.onclick=()=>{const i=+e.dataset.fr;if(i!==fi)switchFrame(i);else{selectOnly(null);refresh()}});
  L.querySelectorAll('[data-dupl]').forEach(e=>e.onclick=ev=>{ev.stopPropagation();dupById(+e.dataset.dupl)});
  L.querySelectorAll('[data-fhide]').forEach(e=>e.onclick=ev=>{ev.stopPropagation();const f=project.frames[+e.dataset.fhide];f.hidden=!f.hidden;buildFrames();refresh();commitSoon()});
  L.querySelectorAll('[data-flock]').forEach(e=>e.onclick=ev=>{ev.stopPropagation();const f=project.frames[+e.dataset.flock];f.locked=!f.locked;buildFrames();refresh();commitSoon()});
}
const lsClose=()=>{$('lsearch').value='';$('lh').classList.remove('searching');renderLayers()};
$('lsb').onclick=()=>{$('lh').classList.add('searching');$('lsearch').focus()};
$('lclr').onclick=()=>{if($('lsearch').value){$('lsearch').value='';renderLayers();$('lsearch').focus()}else lsClose()};
$('lsearch').onkeydown=e=>{e.stopPropagation();if(e.key==='Escape')lsClose()};
$('lsearch').oninput=()=>{lsIdx=-1;renderLayers()};
// step through the matches: opens the frame and selects the layer
const lsStep=d=>{const n=lsMatches.length;if(!n)return;lsIdx=(lsIdx+d+n)%n;const m=lsMatches[lsIdx];
  if(m.fi!==fi)switchFrame(m.fi);if(m.id==null){selectOnly(null);frameSel=true}else selectOnly(m.id);refresh()};
$('lup').onclick=()=>lsStep(-1);$('ldn').onclick=()=>lsStep(1);

// ---------- timeline ----------
let pxLock=null,tlZ=1;   // tlZ: timeline zoom (Ctrl/Cmd + scroll, or the − / + buttons)
const TL_MIN=20;   // the timeline always shows at least 20 seconds
const tlLen=()=>Math.max(TL_MIN,scene.duration);
const PX=()=>pxLock||Math.max(6,Math.max(40,($('tlscroll').clientWidth-240-30)/tlLen())*tlZ);
function tlZoom(factor,clientX){
  const sc=$('tlscroll'),sr=sc.getBoundingClientRect(),cx=clientX==null?sr.left+240+(sr.width-240)/2:clientX;
  const t0=(cx-sr.left+sc.scrollLeft-240)/PX();
  tlZ=Math.max(.15,Math.min(14,tlZ*factor));renderTL();
  sc.scrollLeft=Math.max(0,240+t0*PX()-(cx-sr.left));
}
$('tlscroll').addEventListener('wheel',e=>{if(!(e.ctrlKey||e.metaKey))return;e.preventDefault();tlZoom(Math.exp(-e.deltaY*0.01),e.clientX)},{passive:false});
$('tlzo').onclick=()=>tlZoom(1/1.25);$('tlzi').onclick=()=>tlZoom(1.25);
function groupKeys(l){
  const m=new Map();
  for(const pr in l.tracks)l.tracks[pr].forEach(k=>{const key=Math.round(k.t*1000);if(!m.has(key))m.set(key,[]);m.get(key).push({prop:pr,k})});
  return [...m.entries()].sort((a,b)=>a[0]-b[0]).map(([key,keys])=>({t:key/1000,keys}));
}
const ROWH=34;
function renderTL(){
  autoDuration();
  const p=PX(),w=tlLen()*p+30;
  $('tlg').style.width=(240+w)+'px';$('ruler').style.width=w+'px';
  let r='<div id="pill">0.00</div>';
  for(let i=0;i<=tlLen()*4;i++){const x=i*p/4,past=i/4>scene.duration+1e-6?' past':'';r+=i%4===0?`<span class="tick${past}" style="left:${x}px">${i/4?i/4+'s':''}</span>`:`<span class="dot${past}" style="left:${x}px"></span>`}
  $('ruler').innerHTML=r;
  let rows='';
  const isMedia=n=>n.type==='audio'||!!n.video;
  const animated=n=>n.type==='group'?descendantsOf(n).some(animated):(n.anims||[]).length>0||isMedia(n);   // audio and video always get a bar
  treeRows('').forEach(({n:l,depth})=>{
    if(!animated(l))return;   // the timeline lists only layers that have an animation
    if(l.type==='group'){
      const open=l.expanded!==false;
      rows+=`<div class="row2 ${hiddenDeep(l)?'dimrow':''}" data-lid="${l.id}"><div class="nm ${selSet.has(l.id)?'sel':''}" data-id="${l.id}" style="padding-left:${14+depth*14}px"><span class="car" data-tcar="${l.id}">${ic(open?'chevron-down':'chevron-right',12)}</span><span style="color:var(--mute)">${ic(l.mask?'contrast':'layers',14)}</span>${esc(l.name)}</div><div class="ln" style="width:${w}px"></div></div>`;
      return;
    }
    const on=selSet.has(l.id),single=on&&isSingleLeaf(),i0=inOf(l),o0=outOf(l),nl=Math.max(1,(l.anims||[]).length);   // every animation gets its own line
    rows+=`<div class="row2 ${on?'rsel':''} ${dropT===l.id?'drop':''} ${hiddenDeep(l)?'dimrow':''}" data-lid="${l.id}" style="height:${nl*ROWH}px"><div class="nm ${on?'sel':''}" data-id="${l.id}" style="padding-left:${14+depth*14}px;align-items:flex-start;padding-top:${(ROWH-18)/2}px"><span style="color:var(--mute)">${ic(l.type==='audio'?'note':l.video?'camera':'zap',14)}</span>${esc(l.name)}${l.tag?`<span class="tag">· ${esc(l.tag)}</span>`:''}<span class="dupbtn" data-dupt="${l.id}" title="Duplicate (⌘D / Ctrl+D)">${ic('copy',14)}</span></div>
      <div class="ln" style="width:${w}px"><div class="bar ${on?'sel':''} ${(l.anims||[]).length&&!isMedia(l)?'thin':''} ${l.type==='audio'?'aud':l.video?'vid':''}" data-id="${l.id}" style="left:${i0*p}px;width:${Math.max(12,(o0-i0)*p)}px"><i class="hl" data-h="l"></i>${isMedia(l)?`<span class="bl">${esc(l.name)}</span>`:''}<i class="hr" data-h="r"></i></div>`+
      (l.anims||[]).map((a,i)=>`<div class="abar ${barSet.has(l.id+':'+i)||(on&&i===animIdx&&barSel&&!barSet.size)?'sel':''}" data-l="${l.id}" data-i="${i}" style="left:${a.start*p}px;top:${5+i*ROWH}px;width:${Math.max(16,a.dur*p)}px"><i class="hl" data-h="l"></i><i class="hr" data-h="r"></i><span>${esc(animName(a))}</span></div>`).join('')+`</div></div>`;
    if(single&&KEYFRAMES)Object.keys(l.tracks).forEach(pr=>{
      rows+=`<div class="row2 sub"><div class="nm pp">${pr}</div><div class="ln" style="width:${w}px">${l.tracks[pr].map((k,i)=>`<div class="k ${selKey&&selKey.keys[0].k===k?'sel':''}" data-p="${pr}" data-i="${i}" style="left:${k.t*p}px"></div>`).join('')}</div></div>`;
    });
  });
  $('rows').innerHTML=rows;
  $('rows').querySelectorAll('.nm[data-id]').forEach(e=>e.onclick=ev=>{const id=+e.dataset.id;if(ev.shiftKey||ev.metaKey||ev.ctrlKey)toggleSel(id);else selectOnly(id);refresh()});
  $('rows').querySelectorAll('.nm[data-id]').forEach(e=>e.oncontextmenu=ev=>{if(!ev.shiftKey)return;ev.preventDefault();toggleSel(+e.dataset.id);refresh()});
  $('rows').querySelectorAll('[data-tcar]').forEach(e=>e.onclick=ev=>{ev.stopPropagation();const g=byId(+e.dataset.tcar);g.expanded=g.expanded===false;renderLayers();renderTL()});
  $('rows').querySelectorAll('[data-dupt]').forEach(e=>{e.onclick=ev=>{ev.stopPropagation();dupById(+e.dataset.dupt)};e.onpointerdown=ev=>ev.stopPropagation()});
  $('rows').querySelectorAll('.bar').forEach(b=>b.onpointerdown=ev=>barDrag(ev,scene.layers.find(x=>x.id==b.dataset.id),ev.target.dataset.h||'move'));
  $('rows').querySelectorAll('.k').forEach(e=>e.onpointerdown=ev=>keyDrag(ev,e.dataset.p,+e.dataset.i));
  $('rows').querySelectorAll('.abar').forEach(b=>{
    const key=()=>b.dataset.l+':'+b.dataset.i;
    // right-click a bar = select it (and remember it as the start); Shift + right-click another bar = select every bar between the two;
    // Shift + right-click a bar that is already selected = take it out again
    const pickBar=shift=>{
      const k=key(),all=[...$('rows').querySelectorAll('.abar')].map(x=>x.dataset.l+':'+x.dataset.i);
      if(!shift){barSet.clear();barSet.add(k);barAnchor=k}
      else{
        if(!barSet.size&&barSel&&sel!=null){barAnchor=sel+':'+animIdx;barSet.add(barAnchor)}   // the bar that was already selected counts as the start
        if(barSet.has(k)&&k!==barAnchor)barSet.delete(k);
        else if(barAnchor&&all.includes(barAnchor)&&barAnchor!==k){const a=all.indexOf(barAnchor),z=all.indexOf(k);all.slice(Math.min(a,z),Math.max(a,z)+1).forEach(x=>barSet.add(x))}
        else{barSet.has(k)?barSet.delete(k):barSet.add(k);if(!barAnchor)barAnchor=k}
      }
      barSel=barSet.size>0;renderTL();
    };
    b.onpointerdown=ev=>{if(ev.button!==0)return;
      if(ev.shiftKey){ev.preventDefault();ev.stopPropagation();pickBar(true);return}   // Shift + click works too
      animDrag(ev,scene.layers.find(x=>x.id==b.dataset.l),+b.dataset.i,ev.target.dataset.h||'move')};
    b.oncontextmenu=ev=>{ev.preventDefault();pickBar(ev.shiftKey)};
  });
  placePH();
}
// drag a layer bar: sideways = retime (keyframes move with it), up/down = reorder, ends = trim/extend
function barDrag(ev,l,mode){
  ev.preventDefault();ev.stopPropagation();
  if(ev.shiftKey||ev.metaKey||ev.ctrlKey){toggleSel(l.id);selKey=null;refresh();return}
  if(!selSet.has(l.id)){selectOnly(l.id);selKey=null;renderLayers();renderRight()}else sel=l.id;
  const p=PX(),x0=ev.clientX,n=scene.layers.length;
  const info=selected().map(o=>({l:o,i0:inOf(o),o0:outOf(o),snap:JSON.parse(JSON.stringify(o.tracks)),an0:JSON.parse(JSON.stringify(o.anims||[]))}));
  const top=$('rows').getBoundingClientRect().top;
  const sn=v=>Math.round(v/0.05)*0.05;
  const mv=m=>{
    const dt=sn((m.clientX-x0)/p);
    if(mode==='move'){
      const d=Math.max(Math.max(...info.map(o=>-o.i0)),Math.min(Math.min(...info.map(o=>scene.duration-o.o0)),dt));
      info.forEach(o=>{
        const L=o.l;L.inT=+(o.i0+d).toFixed(3);L.outT=o.o0+d>=scene.duration-1e-6?null:+(o.o0+d).toFixed(3);
        for(const pr in o.snap)L.tracks[pr]=o.snap[pr].map(k=>({...k,t:+(k.t+d).toFixed(3)}));
        (L.anims||[]).forEach((a,i)=>a.start=+(o.an0[i].start+d).toFixed(3));
      });
      if(info.length===1){   // vertical drag reorders a single layer
        const T=rowLayerAt(m.clientY);
        if(T&&T!==l){const ti=scene.layers.indexOf(T);scene.layers.splice(scene.layers.indexOf(l),1);scene.layers.splice(ti,0,l)}
      }
    }else if(mode==='l'){
      info.forEach(o=>o.l.inT=+Math.max(0,Math.min(o.o0-0.1,o.i0+dt)).toFixed(3));
    }else{
      info.forEach(o=>{const v=Math.max(o.i0+0.1,Math.min(scene.duration,o.o0+dt));o.l.outT=v>=scene.duration-1e-6?null:+v.toFixed(3)});
    }
    draw();renderTL();
  };
  const up=()=>{removeEventListener('pointermove',mv);removeEventListener('pointerup',up);info.forEach(o=>rebuild(o.l));refresh()};
  addEventListener('pointermove',mv);addEventListener('pointerup',up);
}
// drag a keyframe diamond sideways (all properties keyed at that moment move together)
function keyDrag(ev,pr,idx){
  ev.preventDefault();ev.stopPropagation();
  const l=cur(),k0=l.tracks[pr]&&l.tracks[pr][idx];if(!k0)return;
  const g={t:k0.t,keys:[{prop:pr,k:k0}]};
  selKey={layer:l.id,keys:g.keys};t=g.t;ptab='design';picking=false;
  const x0=ev.clientX,p=PX(),orig=g.keys.map(o=>o.k.t);let drop=null;
  refresh();
  const mv=m=>{
    const dt=(m.clientX-x0)/p;
    g.keys.forEach((o,i)=>o.k.t=+Math.max(0,Math.min(scene.duration,orig[i]+dt)).toFixed(2));
    t=g.keys[0].k.t;
    const T=rowLayerAt(m.clientY);drop=T&&T!==l?T.id:null;dropT=drop;
    draw();renderTL();
  };
  const up=()=>{
    removeEventListener('pointermove',mv);removeEventListener('pointerup',up);
    Object.values(l.tracks).forEach(ks=>ks.sort((a,b)=>a.t-b.t));
    const dst=drop!=null&&scene.layers.find(x=>x.id===drop);
    dropT=null;
    if(dst)transferKeys(l,g.keys,dst);
    refresh();
  };
  addEventListener('pointermove',mv);addEventListener('pointerup',up);
}
// which layer's row is under this screen Y (a layer's sub-rows count as part of it)
function rowLayerAt(y){
  const rows=[...$('rows').querySelectorAll('.row2[data-lid]')];
  for(let i=0;i<rows.length;i++){
    const top=rows[i].getBoundingClientRect().top,bot=i+1<rows.length?rows[i+1].getBoundingClientRect().top:Infinity;
    if(y>=top&&y<bot){const L=scene.layers.find(l=>l.id==rows[i].dataset.lid)||null;return L&&L.type!=='group'?L:null}
  }
  return null;
}
const posDelta=(src,dst,time)=>{const a=state(src,time),b=state(dst,time);return{x:b.x-a.x,y:b.y-a.y}};
function transferKeys(src,keys,dst){
  const dl=posDelta(src,dst,keys[0].k.t);
  keys.forEach(({prop,k})=>{
    const ks=src.tracks[prop];ks.splice(ks.indexOf(k),1);if(!ks.length)delete src.tracks[prop];
    if(!dst.tracks[prop]&&k.t>0.001)dst.tracks[prop]=[{t:0,v:dst[prop],ease:'easeInOut'}];
    const arr=dst.tracks[prop]||(dst.tracks[prop]=[]),v=(prop==='x'||prop==='y')?k.v+dl[prop]:k.v;
    const ex=arr.find(q=>Math.abs(q.t-k.t)<0.02);
    if(ex){ex.v=v;ex.ease=k.ease}else arr.push({...k,v});
    arr.sort((a,b)=>a.t-b.t);
  });
  selectOnly(dst.id);selKey=null;toast('Moved keyframe to '+dst.name);
}
function transferAnim(src,ai,dst){
  const a=src.anims.splice(ai,1)[0];(dst.anims=dst.anims||[]).push(a);
  rebuild(src);rebuild(dst);selectOnly(dst.id);animIdx=dst.anims.length-1;
  toast('Moved "'+animName(a)+'" to '+dst.name);
}
// drag an animation pill: sideways = retime, ends = change its length, onto another layer's row = move it there
function animDrag(ev,l,ai,mode){
  ev.preventDefault();ev.stopPropagation();
  const a=l.anims[ai];if(!a)return;
  // several bars selected (Shift + right-click) or several layers selected: every one of them is re-timed together, keeping their proportions
  const mykey=l.id+':'+ai,grp=selected();
  let tg=null;
  if(barSet.size>1&&barSet.has(mykey))tg=[...barSet].map(k=>{const[lid,idx]=k.split(':'),L=scene.layers.find(x=>x.id==lid),A=L&&L.anims&&L.anims[+idx];return A?{L,A,s0:A.start,e0:A.start+A.dur}:null}).filter(Boolean);
  else if(grp.length>1&&grp.some(x=>x.id===l.id))tg=grp.flatMap(L=>(L.anims||[]).map(A=>({L,A,s0:A.start,e0:A.start+A.dur})));
  const multi=!!tg&&tg.length>1;
  if(!multi){if(sel!==l.id){selectOnly(l.id);selKey=null;renderLayers()}barSet.clear()}
  animIdx=ai;barSel=true;ptab='animate';picking=false;renderRight();
  const p=PX(),x0=ev.clientX,s0=a.start,e0=s0+a.dur;pxLock=p;
  const sn=v=>Math.round(v/0.05)*0.05;let moved=false,drop=null,vy=0;
  const mv=m=>{
    moved=true;const dt=sn((m.clientX-x0)/p);
    if(multi){
      if(mode==='move'){const d=Math.max(-Math.min(...tg.map(o=>o.s0)),Math.min(MAXT-Math.max(...tg.map(o=>o.e0)),dt));tg.forEach(o=>{o.A.start=+(o.s0+d).toFixed(3)})}
      else{
        // the group stretches about the bar that STARTS FIRST (earliest start): that start stays put (right-edge drag), and every other selected bar scales around it; a left-edge drag keeps the latest end instead
        const right=mode!=='l',dur0=e0-s0,A0=Math.min(...tg.map(o=>o.s0)),E0=Math.max(...tg.map(o=>o.e0));
        let f=Math.max(.02,(dur0+(right?dt:-dt))/dur0);
        tg.forEach(o=>{f=Math.max(f,.1/(o.e0-o.s0));
          if(right){if(o.s0<A0)f=Math.min(f,A0/(A0-o.s0));if(o.e0>A0)f=Math.min(f,(MAXT-A0)/(o.e0-A0))}
          else{if(o.s0<E0)f=Math.min(f,E0/(E0-o.s0));if(o.e0>E0)f=Math.min(f,(MAXT-E0)/(o.e0-E0))}});
        tg.forEach(o=>{const d=(o.e0-o.s0)*f;o.A.dur=+d.toFixed(3);
          o.A.start=right?+Math.max(0,A0+(o.s0-A0)*f).toFixed(3):+Math.max(0,E0-(E0-o.e0)*f-d).toFixed(3)});
      }
      new Set(tg.map(o=>o.L)).forEach(rebuild);draw();renderTL();return;
    }
    if(mode==='move'){
      const d=Math.max(-s0,Math.min(MAXT-e0,dt));a.start=+(s0+d).toFixed(3);
      const T=rowLayerAt(m.clientY);drop=T&&T!==l?T.id:null;dropT=drop;t=a.start;vy=m.clientY-ev.clientY;
    }else if(mode==='l'){
      const ns=Math.max(0,Math.min(e0-0.1,s0+dt));a.start=+ns.toFixed(3);a.dur=+(e0-ns).toFixed(3);t=a.start;
    }else{
      const ne=Math.max(s0+0.1,Math.min(MAXT,e0+dt));a.dur=+(ne-s0).toFixed(3);t=a.start+a.dur;
    }
    rebuild(l);draw();renderTL();
    if(vy){const el=$('rows').querySelector(`.abar[data-l="${l.id}"][data-i="${ai}"]`);if(el){el.style.transform=`translateY(${vy}px)`;el.style.zIndex=20;el.style.pointerEvents='none';el.style.boxShadow='0 4px 12px rgba(0,0,0,.25)'}}   // the bar follows the pointer up / down until it is dropped on another row
  };
  const up=()=>{
    removeEventListener('pointermove',mv);removeEventListener('pointerup',up);pxLock=null;
    const dst=!multi&&drop!=null&&scene.layers.find(x=>x.id===drop);dropT=null;
    if(dst)transferAnim(l,ai,dst);else if(!moved&&!multi)t=a.start;
    refresh();
  };
  addEventListener('pointermove',mv);addEventListener('pointerup',up);
}
function placePH(){
  const p=PX(),pl=$('pill');pl.textContent=t.toFixed(2);pl.style.left=Math.max(t*p,pl.offsetWidth/2+2)+'px';   // never slides under the layer names
  $('phline').style.left=(240+t*p)+'px';
}
const scrub=ev=>{const rc=$('ruler').getBoundingClientRect();t=Math.max(0,Math.min(scene.duration,(ev.clientX-rc.left)/PX()));draw();placePH();if(cur()&&ptab==='design'&&!picking)renderRight()};
$('ruler').onpointerdown=ev=>{scrub(ev);const up=()=>{removeEventListener('pointermove',scrub);removeEventListener('pointerup',up)};addEventListener('pointermove',scrub);addEventListener('pointerup',up)};

// ---------- stage / zoom ----------
// the zoom button in the top bar opens a small menu (zoom in / out, 50 / 100 / 200 %, fit)
function paintZoomBtn(open){
  const z=$('zoom');if(!z)return;
  if(open!==undefined)z.classList.toggle('open',open);
  z.innerHTML=`<span>${Math.round(curZoom()*100)}%</span>${ic(z.classList.contains('open')?'chevron-up':'chevron-down',14)}`;
}
function closeZoomMenu(){const m=$('zmenu');if(m)m.remove();paintZoomBtn(false)}
function setupZoom(){
  const z=$('zoom');z.title='Zoom  (⌘ + / ⌘ − / ⌘ 0 to fit · Ctrl+scroll)';paintZoomBtn(false);
  const IT=[['Zoom in','+',()=>zoomStep(1)],['Zoom out','-',()=>zoomStep(-1)],null,['Zoom to 50%','',()=>setZoom(.5,true)],['Zoom to 100%',isMac?'⇧0':'Shift+0',()=>setZoom(1,true)],['Zoom to 200%','',()=>setZoom(2,true)],null,['Zoom to fit',isMac?'⇧1':'Shift+1',()=>setZoom('fit',true)]];
  z.onclick=e=>{
    e.stopPropagation();
    if($('zmenu')){closeZoomMenu();return}
    document.querySelectorAll('.menu').forEach(x=>x.style.display='none');
    const m=document.createElement('div');m.id='zmenu';
    m.innerHTML=IT.map((it,i)=>it?`<div data-zi="${i}"><span>${it[0]}</span><kbd>${it[1]}</kbd></div>`:'<hr>').join('');
    document.body.appendChild(m);
    const r=z.getBoundingClientRect();m.style.left=Math.min(r.left,innerWidth-m.offsetWidth-8)+'px';m.style.top=r.bottom+'px';
    m.querySelectorAll('[data-zi]').forEach(el=>el.onclick=ev=>{ev.stopPropagation();const it=IT[+el.dataset.zi];if(it[0]==='Zoom in'||it[0]==='Zoom out'){it[2]();paintZoomBtn(true)}else{it[2]();closeZoomMenu()}});
    paintZoomBtn(true);
  };
  addEventListener('click',e=>{if($('zmenu')&&!e.target.closest('#zmenu'))closeZoomMenu()});
  addEventListener('keydown',e=>{if(e.key==='Escape'&&$('zmenu'))closeZoomMenu()});
}
let padX=0,padY=0;
function applyZoom(){
  const fit=fitZoom(),z=zoom==='fit'?fit:zoom,st0=$('stage'),fr0=$('frames');
  // the canvas has no hard edge: there is always about one screen of empty room around the frames
  const ex=Math.round(st0.clientWidth*.9),ey=Math.round(st0.clientHeight*.9);
  if(ex!==padX||ey!==padY){const pb=$('pb');pb.style.setProperty('--ex',ex+'px');pb.style.setProperty('--ey',ey+'px');st0.scrollLeft+=ex-padX;st0.scrollTop+=ey-padY;padX=ex;padY=ey}
  // keep whatever is in the middle of the view in the middle while zooming
  const pz=viewZ||z,cx=(st0.scrollLeft+st0.clientWidth/2-fr0.offsetLeft)/pz,cy=(st0.scrollTop+st0.clientHeight/2-fr0.offsetTop-FRAME_LABEL_H)/pz;
  viewZ=z;
  canvases.forEach((c,i)=>{const f=project.frames[i]||{};c.style.width=(f.w||1280)*z+'px';c.style.height=(f.h||720)*z+'px'});
  {const b=frameBox(),box=$('frames');
    box.style.width=Math.ceil(b.w*z)+'px';box.style.height=Math.ceil(b.h*z+FRAME_LABEL_H)+'px';
    document.querySelectorAll('#frames .fr').forEach((el,i)=>{const p=b.P[i];if(!p)return;el.style.left=Math.round((p.x-b.x0)*z)+'px';el.style.top=Math.round((p.y-b.y0)*z)+'px'})}
  if(zoom!=='fit'&&z!==pz){st0.scrollLeft=fr0.offsetLeft+cx*z-st0.clientWidth/2;st0.scrollTop=fr0.offsetTop+FRAME_LABEL_H+cy*z-st0.clientHeight/2}
  if(typeof renderPins==='function'&&canvases.length)setTimeout(renderPins,0);
  paintZoomBtn();
  if(canvases.length)drawAll();   // handle size depends on zoom
  if(zoom==='fit'){const st=$('stage');st.scrollTop=Math.max(0,(st.scrollHeight-st.clientHeight)/2);st.scrollLeft=Math.max(0,(st.scrollWidth-st.clientWidth)/2)}   // keep the frames centred when fitted
}
addEventListener('resize',()=>{applyZoom();renderTL()});

// the browser tab reads "<file name> · Figtion" (the editor sits in an iframe, so the host page's title is set too)
function pageTitle(){
  const t=((project&&project.title)||'').trim()||'Untitled',full=t+' · Figtion';
  if(document.title!==full)document.title=full;
  try{if(parent!==window&&parent.document.title!==full)parent.document.title=full}catch(e){}
}
function refresh(light){
  pageTitle();syncSel();autoDuration();
  if(selSet.size)frameSel=false;
  if(pe&&!(selSet.size===1&&selSet.has(pe.id)))pe=null;
  if(cropEdit&&!selSet.has(cropEdit.id))cropEdit=null;
  if(selSet.size||frameSel)noFrame=false;
  document.querySelectorAll('#frames .fr').forEach((el,i)=>{el.classList.toggle('fsel',frameSel&&i===fi);el.classList.toggle('act',i===fi&&!noFrame);const lb=el.querySelector('.flabel');if(lb)lb.classList.toggle('on',i===fi&&!noFrame)});
  syncPlayIcons();
  if(light){draw();placePH();return}
  drawAll();updateLabels();commitSoon();
  renderLayers();renderRight();renderTL();
}

// ---------- playback ----------
// one place that makes every play / pause icon match the real state (the top-bar button and each frame's label)
function syncPlayIcons(){
  const b=$('play');if(b)b.innerHTML=ic(playing?'pause':'play',16,1);
  document.querySelectorAll('#frames .fr').forEach((el,i)=>{const e=el.querySelector('.fplay');if(e)e.innerHTML=ic(i===fi&&playing?'pause':'play',11,1)});
}
let last=0;
function tick(now){
  if(!playing)return;
  t+=(now-last)/1000;last=now;
  if(loopRange&&t>=loopRange.e)t=loopRange.s;
  else if(t>=scene.duration){if(loop)t=0;else{t=scene.duration;togglePlay()}}
  syncAudio(t,playing);draw();placePH();if(playing)requestAnimationFrame(tick);
}
function togglePlay(){
  playing=!playing;syncPlayIcons();
  if(!playing){syncAudio(t,false);pauseAllVideos()}   // pausing stops the videos too, not just the timeline
  loopRange=null;
  if(playing){   // a selected animation bar loops on its own; a single selected layer loops over all of its animations
    const L=cur(),list=(L&&!isMulti()&&L.anims)||[],a=barSel&&list[animIdx];
    const r=a?[a.start,a.start+a.dur]:list.length?[Math.min(...list.map(x=>x.start)),Math.max(...list.map(x=>x.start+x.dur))]:null;
    if(r&&r[1]-r[0]>.04){loopRange={s:r[0],e:r[1]};if(t<loopRange.s||t>=loopRange.e)t=loopRange.s}}
  if(playing){last=performance.now();requestAnimationFrame(tick)}else if(cur()&&ptab==='design'&&!picking)renderRight();
}
$('play').onclick=togglePlay;
$('loop').onclick=()=>{loop=!loop;$('loop').classList.toggle('on',loop)};

// ---------- export (MP4 video · GIF) & share (project JSON) ----------
// the Export button opens a menu: video at a set height or at a multiple of the frame size, GIF, (Lottie not built yet)
const exBusy=()=>document.body.classList.contains('exporting');
// MP4: frames are rendered one by one (not in real time), encoded to H.264 with WebCodecs and packed into an .mp4 — frame-exact, no dropped frames.
// Sound (audio layers and video soundtracks) is mixed offline and added as AAC; if that can't be encoded here the scene is recorded live instead, which also writes .mp4.
// mix every audio layer and every video's soundtrack into one buffer, offline
async function renderMix(){
  const srcs=scene.layers.filter(l=>!l.muted&&(l.type==='audio'||l.video)&&(l.src||srcStore[l.id]));if(!srcs.length)return null;
  const sr=48000,off=new OfflineAudioContext(2,Math.max(1,Math.ceil(scene.duration*sr)),sr);let used=0;
  for(const l of srcs){
    try{
      const buf=await off.decodeAudioData(await(await fetch(l.src||srcStore[l.id])).arrayBuffer());
      const n=off.createBufferSource(),g=off.createGain();n.buffer=buf;g.gain.value=Math.max(0,Math.min(1,l.vol==null?1:l.vol));
      if(l.video&&l.vloop!==false)n.loop=true;
      n.connect(g);g.connect(off.destination);n.start(inOf(l));n.stop(Math.min(scene.duration,outOf(l)));used++;
    }catch(e){/* no sound track in this file */}
  }
  return used?await off.startRendering():null;
}
async function exportMp4(W,H,label){
  if(!window.VideoEncoder||!window.VideoFrame)return false;
  try{if(!window.Mp4Muxer)await new Promise((ok,no)=>{const s=document.createElement('script');s.src='https://cdn.jsdelivr.net/npm/mp4-muxer@5.1.3/build/mp4-muxer.js';s.onload=ok;s.onerror=()=>no();document.head.appendChild(s)})}catch(e){return false}
  W&=~1;H&=~1;const fps=30,bitrate=Math.min(40e6,Math.max(6e6,W*H*8));let codec=null;
  for(const c of ['avc1.640034','avc1.4d0034','avc1.42E034']){try{const r=await VideoEncoder.isConfigSupported({codec:c,width:W,height:H,bitrate,framerate:fps});if(r.supported){codec=c;break}}catch(e){}}
  if(!codec)return false;
  if(playing)togglePlay();
  const o2=document.createElement('canvas');o2.width=W;o2.height=H;const c2=o2.getContext('2d');c2.imageSmoothingQuality='high';
  const ex=$('export'),old=ex.innerHTML,t0=t;document.body.classList.add('exporting');exporting=true;
  let err=null;
  try{
    const mix=await renderMix();let acodec=null;
    if(mix&&window.AudioEncoder&&window.AudioData){
      for(const [c,m] of [['mp4a.40.2','aac'],['opus','opus']]){try{const r=await AudioEncoder.isConfigSupported({codec:c,sampleRate:48000,numberOfChannels:2,bitrate:160000});if(r.supported){acodec=[c,m];break}}catch(e){}}
    }
    if(mix&&!acodec){exporting=false;t=t0;document.body.classList.remove('exporting');ex.innerHTML=old;return false}   // can't encode sound here: record live instead (it keeps the sound)
    const muxer=new Mp4Muxer.Muxer({target:new Mp4Muxer.ArrayBufferTarget(),video:{codec:'avc',width:W,height:H},...(acodec?{audio:{codec:acodec[1],numberOfChannels:2,sampleRate:48000}}:{}),fastStart:'in-memory'});
    if(acodec){
      const aenc=new AudioEncoder({output:(c,m)=>muxer.addAudioChunk(c,m),error:e=>{err=e}});
      aenc.configure({codec:acodec[0],sampleRate:48000,numberOfChannels:2,bitrate:160000});
      const L0=mix.getChannelData(0),L1=mix.getChannelData(mix.numberOfChannels>1?1:0),CH=4800;
      for(let i=0;i<mix.length;i+=CH){
        const n=Math.min(CH,mix.length-i),data=new Float32Array(n*2);data.set(L0.subarray(i,i+n),0);data.set(L1.subarray(i,i+n),n);
        aenc.encode(new AudioData({format:'f32-planar',sampleRate:48000,numberOfFrames:n,numberOfChannels:2,timestamp:Math.round(i/48000*1e6),data}));
        if((i/CH)%40===39)await new Promise(r=>setTimeout(r));
      }
      await aenc.flush();
    }
    const enc=new VideoEncoder({output:(c,m)=>muxer.addVideoChunk(c,m),error:e=>{err=e}});
    enc.configure({codec,width:W,height:H,bitrate,framerate:fps});
    const n=Math.max(1,Math.round(scene.duration*fps))+1;
    for(let f=0;f<n;f++){
      if(err)throw err;
      t=Math.min(scene.duration,f/fps);await seekVideos(t);draw();
      c2.fillStyle='#fff';c2.fillRect(0,0,W,H);c2.drawImage(cv,0,0,W,H);
      const fr=new VideoFrame(o2,{timestamp:Math.round(f*1e6/fps),duration:Math.round(1e6/fps)});enc.encode(fr,{keyFrame:f%60===0});fr.close();
      ex.textContent='Exporting '+Math.round((f+1)/n*100)+'%';
      while(enc.encodeQueueSize>6)await new Promise(r=>setTimeout(r,4));
      if(f%4===3)await new Promise(r=>setTimeout(r));
    }
    await enc.flush();muxer.finalize();
    const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([muxer.target.buffer],{type:'video/mp4'}));a.download=(project.title||'motion-lab')+' - '+label+'.mp4';a.click();
  }catch(e){toast('Video export failed')}
  exporting=false;t=t0;document.body.classList.remove('exporting');ex.innerHTML=old;refresh(true);
  return true;
}
async function exportVideo(W,H,label){
  if(await exportMp4(W,H,label))return;
  recordVideo(W,H,label);
}
function recordVideo(W,H,label){
  if(!window.MediaRecorder)return toast('MediaRecorder not supported');
  if(playing)togglePlay();
  const resize=W!==cv.width||H!==cv.height,o2=resize?document.createElement('canvas'):null;
  if(o2){o2.width=W;o2.height=H}
  const copy=()=>{if(o2){const c2=o2.getContext('2d');c2.imageSmoothingQuality='high';c2.drawImage(cv,0,0,W,H)}};
  const mime=['video/mp4;codecs=avc1.640028,mp4a.40.2','video/mp4;codecs=avc1','video/mp4','video/webm;codecs=vp9','video/webm'].find(m=>MediaRecorder.isTypeSupported(m)),ext=mime.startsWith('video/mp4')?'mp4':'webm';
  const vs=(o2||cv).captureStream(60),as=audioStreamFor(scene),ms=as?new MediaStream([...vs.getVideoTracks(),...as.getAudioTracks()]):vs;
  const rec=new MediaRecorder(ms,{mimeType:mime,videoBitsPerSecond:Math.min(40e6,Math.max(6e6,W*H*8))});
  const chunks=[];rec.ondataavailable=e=>chunks.push(e.data);
  const ex=$('export'),old=ex.innerHTML;document.body.classList.add('exporting');
  rec.onstop=()=>{
    exporting=false;exportLive=false;syncAudio(0,false);document.body.classList.remove('exporting');
    const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(chunks,{type:'video/'+ext}));
    a.download=(project.title||'motion-lab')+' - '+label+'.'+ext;a.click();ex.innerHTML=old;refresh(true);
  };
  exporting=true;exportLive=true;const t0=performance.now();rec.start();
  (function step(now){
    t=(now-t0)/1000;
    if(t>=scene.duration){t=scene.duration;draw();copy();setTimeout(()=>rec.stop(),100);return}
    syncAudio(t,true);draw();copy();placePH();ex.textContent='Exporting '+Math.round(t/scene.duration*100)+'%';requestAnimationFrame(step);
  })(t0);
}
// ---- GIF: frames are rendered one by one (not in real time), reduced to a fixed 216-colour palette and LZW-packed
function lzwGif(idx){
  const out=[],MIN=8,CLEAR=1<<MIN,EOI=CLEAR+1;let size=MIN+1,next=EOI+1,dict=new Map(),cur=0,bits=0,buf=[];
  const put=code=>{cur|=code<<bits;bits+=size;while(bits>=8){buf.push(cur&255);cur>>=8;bits-=8;if(buf.length===255){out.push(255,...buf);buf=[]}}};
  put(CLEAR);let p=idx[0];
  for(let i=1;i<idx.length;i++){
    const c=idx[i],key=p*256+c,hit=dict.get(key);
    if(hit!==undefined){p=hit;continue}
    put(p);
    if(next<4096){dict.set(key,next++);if(next>(1<<size)&&size<12)size++}
    else{put(CLEAR);dict=new Map();size=MIN+1;next=EOI+1}
    p=c;
  }
  put(p);put(EOI);if(bits>0){buf.push(cur&255)}
  if(buf.length)out.push(buf.length,...buf);
  out.push(0);return out;
}
async function exportGif(scale,label){
  if(playing)togglePlay();
  const W=Math.max(2,Math.round(cv.width*scale)),H=Math.max(2,Math.round(cv.height*scale)),fps=12.5,delay=8,n=Math.max(1,Math.ceil(scene.duration*fps));
  const o2=document.createElement('canvas');o2.width=W;o2.height=H;const c2=o2.getContext('2d',{willReadFrequently:true});
  const ex=$('export'),old=ex.innerHTML,t0=t;document.body.classList.add('exporting');exporting=true;
  const bytes=[71,73,70,56,57,97,W&255,W>>8,H&255,H>>8,0xF7,0,0];   // GIF89a, 256-colour global table
  for(let i=0;i<256;i++){if(i<216)bytes.push(Math.floor(i/36)*51,Math.floor(i/6)%6*51,i%6*51);else bytes.push(0,0,0)}
  bytes.push(0x21,0xFF,11,...'NETSCAPE2.0'.split('').map(c=>c.charCodeAt(0)),3,1,0,0,0);   // loop forever
  try{
    for(let f=0;f<n;f++){
      t=Math.min(scene.duration,f/fps);await seekVideos(t);draw();
      c2.fillStyle='#fff';c2.fillRect(0,0,W,H);c2.drawImage(cv,0,0,W,H);
      const d=c2.getImageData(0,0,W,H).data,idx=new Uint8Array(W*H);
      for(let p=0,q=0;p<d.length;p+=4,q++){const a=d[p+3]/255,r=d[p]*a+255*(1-a),g=d[p+1]*a+255*(1-a),b=d[p+2]*a+255*(1-a);idx[q]=Math.round(r/51)*36+Math.round(g/51)*6+Math.round(b/51)}
      bytes.push(0x21,0xF9,4,0,delay&255,0,0,0,0x2C,0,0,0,0,W&255,W>>8,H&255,H>>8,0,8,...lzwGif(idx));
      ex.textContent='GIF '+Math.round((f+1)/n*100)+'%';
      if(f%3===2)await new Promise(r=>setTimeout(r));
    }
    bytes.push(0x3B);
    const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([new Uint8Array(bytes)],{type:'image/gif'}));a.download=(project.title||'motion-lab')+' - '+label+'.gif';a.click();
  }catch(e){toast('GIF export failed')}
  exporting=false;t=t0;document.body.classList.remove('exporting');ex.innerHTML=old;refresh(true);
}
const EXPORT_ITEMS=[
  [['Video · 480p',()=>exportVideo(even(480*cv.width/cv.height),480,'480p')],['Video · 720p',()=>exportVideo(even(720*cv.width/cv.height),720,'720p')],['Video · 1080p',()=>exportVideo(even(1080*cv.width/cv.height),1080,'1080p')],['Video · 4K',()=>exportVideo(even(2160*cv.width/cv.height),2160,'4K')]],
  [['Video · 0.5x',()=>exportVideo(even(cv.width*.5),even(cv.height*.5),'0.5x')],['Video · 1x',()=>exportVideo(cv.width,cv.height,'1x')],['Video · 2x',()=>exportVideo(even(cv.width*2),even(cv.height*2),'2x')],['Video · 3x',()=>exportVideo(even(cv.width*3),even(cv.height*3),'3x')]],
  [['GIF · 0.5x',()=>exportGif(.5,'0.5x')],['GIF · 1x',()=>exportGif(1,'1x')],['GIF · 2x',null,'Too large to render in the browser'],['GIF · 3x',null,'Too large to render in the browser']],
  [['Lottie',null,'Not available yet']]
];
const even=v=>Math.max(2,Math.round(v/2)*2);
let exMenu=null;
const exOutside=e=>{if(exMenu&&!exMenu.contains(e.target)&&!e.target.closest('#export'))closeExMenu()};
function closeExMenu(){if(exMenu){exMenu.remove();exMenu=null;removeEventListener('pointerdown',exOutside,true)}}
addEventListener('keydown',e=>{if(e.key==='Escape'&&exMenu)closeExMenu()},true);
$('export').onclick=()=>{
  if(exBusy())return;
  if(exMenu){closeExMenu();return}
  const m=exMenu=document.createElement('div');m.id='exmenu';
  m.innerHTML=EXPORT_ITEMS.map(g=>g.map(([label,fn,why],k)=>`<div class="exi ${fn?'':'off'}" data-i="${label}" ${why?`title="${why}"`:''}>${label}</div>`).join('')).join('<hr>');
  document.body.appendChild(m);
  const r=$('export').getBoundingClientRect();m.style.left=Math.max(8,Math.min(innerWidth-m.offsetWidth-8,r.right-m.offsetWidth))+'px';m.style.top=r.bottom+'px';
  m.querySelectorAll('.exi:not(.off)').forEach(el=>el.onclick=()=>{const it=EXPORT_ITEMS.flat().find(x=>x[0]===el.dataset.i);closeExMenu();if(it&&it[1])it[1]()});
  setTimeout(()=>addEventListener('pointerdown',exOutside,true));
};
function hydrateFillSrc(){project.frames.forEach(f=>f.layers.forEach(l=>(l.fills||[]).forEach(x=>{if(x.t==='img'&&!x.src&&srcStore[x.key])x.src=srcStore[x.key]})))}
function withBgData(fn){   // the saved file carries the original picture and the video mattes; the live layers don't
  const ls=project.frames.flatMap(f=>f.layers);
  ls.forEach(l=>{if(origStore[l.id])l.srcOrig=origStore[l.id];const m=matteStore[l.id];if(m)l.matte={fps:m.fps,frames:m.frames.map(c=>c.toDataURL('image/png'))}});
  try{return fn()}finally{ls.forEach(l=>{delete l.srcOrig;delete l.matte})}
}
function downloadJSON(){hydrateFillSrc();
  const a=document.createElement('a');
  a.href=URL.createObjectURL(new Blob([withBgData(()=>JSON.stringify({version:2,...project,userFonts},null,1))],{type:'application/json'}));
  a.download=(project.title||'motion-lab')+'.json';a.click();toast('Project saved as .json');
}
// ---------- share: a popover with a link that opens a copy of this file in the editor ----------
const b64u=u8=>{let t='';u8.forEach(b=>t+=String.fromCharCode(b));return btoa(t).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')};
const unb64u=str=>{const b=atob(str.replace(/-/g,'+').replace(/_/g,'/')),u=new Uint8Array(b.length);for(let i=0;i<b.length;i++)u[i]=b.charCodeAt(i);return u};
async function gzip(data,mode){const cs=new(mode==='c'?CompressionStream:DecompressionStream)('gzip'),w=cs.writable.getWriter();w.write(typeof data==='string'?new TextEncoder().encode(data):data);w.close();return new Uint8Array(await new Response(cs.readable).arrayBuffer())}
async function shareLink(){hydrateFillSrc();const data=b64u(await gzip(JSON.stringify({version:2,...project,userFonts}),'c'));return{data,url:location.origin+location.pathname+'#p='+data}}
let sharePop=null;
const shareOutside=e=>{if(sharePop&&!sharePop.contains(e.target)&&!e.target.closest('#share'))closeShare()};
function closeShare(){if(sharePop){sharePop.remove();sharePop=null;removeEventListener('pointerdown',shareOutside,true)}}
addEventListener('keydown',e=>{if(e.key==='Escape'&&sharePop)closeShare()},true);
async function openShare(){
  if(sharePop){closeShare();return}
  const pop=sharePop=document.createElement('div');pop.id='sharepop';document.body.appendChild(pop);
  const ini=cmInitials(cmMe());
  pop.innerHTML=`<div class="shg"><svg viewBox="0 0 24 24" width="96" height="96" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">${LI.globe}</svg><span class="shav a">${esc(ini)}</span><span class="shav b">${esc(ini)}</span></div>
    <h3>Share your file</h3><h4>${esc(project.title||'Untitled')}</h4>
    <div class="shlink"><span id="shurl">Preparing link…</span><button id="shcp" title="Copy link">${ic('copy',16)}</button></div>
    <p id="shnote">Anyone with the link can open a copy of this file in the editor.</p>
    <button class="shbtn" id="shcopy">${ic('link',16)}<span>Copy link</span></button>`;
  const r=$('share').getBoundingClientRect();pop.style.left=Math.max(8,Math.min(innerWidth-pop.offsetWidth-8,r.right-pop.offsetWidth+70))+'px';pop.style.top=(r.bottom+6)+'px';
  setTimeout(()=>addEventListener('pointerdown',shareOutside,true));
  let link='';
  try{const x=await shareLink();link=x.url;
    if(x.data.length>120000){$('shurl').textContent='File too large for a link';$('shnote').textContent='This file has large images or fonts, so it can\'t fit in a link.';return}
    $('shurl').textContent=location.host+location.pathname+'#p='+x.data.slice(0,8)+'…'}
  catch(e){$('shurl').textContent='Link unavailable';$('shnote').textContent='This browser can\'t build a link.';return}
  const copy=async()=>{try{await navigator.clipboard.writeText(link)}catch(e){const ta=document.createElement('textarea');ta.value=link;document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove()}
    const lab=$('shcopy')&&$('shcopy').querySelector('span');if(lab){lab.textContent='Link copied';setTimeout(()=>{const l2=$('shcopy')&&$('shcopy').querySelector('span');if(l2)l2.textContent='Copy link'},1600)}};
  $('shcopy').onclick=copy;$('shcp').onclick=copy;
}
$('share').onclick=openShare;
// opening a shared link: the file is in the address (#p=…) and loads as a copy
(async()=>{const m=location.hash.match(/^#p=(.+)$/);if(!m)return;try{loadProject(JSON.parse(new TextDecoder().decode(await gzip(unb64u(m[1]),'d'))));history.replaceState(null,'',location.pathname)}catch(e){toast('That share link could not be opened')}})();
$('ttl').oninput=e=>{project.title=e.target.value;pageTitle();commitLater()};

// ---------- hard reset: wipe the whole file back to a single empty frame ----------
function hardReset(){
  if(playing)togglePlay();
  closeThread(false);if(bs.status!=='inactive')bsClose();
  hist.length=0;hidx=-1;clip=[];frameClip=null;pasteN=0;
  Object.keys(imgs).forEach(k=>delete imgs[k]);Object.keys(srcStore).forEach(k=>delete srcStore[k]);
  tlZ=1;zoom='fit';setTool('select');demo();commit();
  toast('Reset to a new empty file');
}
// ---------- start: one empty frame (no sample layers) ----------
function demo(){
  uid=1;scene={id:1,name:'Frame 1',duration:4,bg:'#ffffff',layers:[]};
  project={title:'New file',frames:[scene]};fi=0;sel=null;selKey=null;t=0;frameSel=false;noFrame=true;ptab='design';picking=false;$('ttl').value=project.title;buildFrames();refresh();
}
// ---------- brainstorm: one animated version of the frame per chosen style ----------
const BS_STYLES=[['bold','Bold'],['playful','Playful'],['cinematic','Cinematic'],['elegant','Elegant'],['soft','Soft'],['creative','Creative'],['custom','Custom']];
const bsLabel=k=>(BS_STYLES.find(x=>x[0]===k)||[0,k])[1];
// recipes are [animation type, parameters]; dir:'auto' means "enter from the nearest edge"
const BSPEC={
  bold:{dur:.62,gap:.07,eases:['overshoot','impulse','slowDown'],
    bg:[['Fade']],
    hero:[['MoveScale',{by:150,from:35,dir:'auto'}],['Grow',{from:30}],['Bounce',{by:280}]],
    shape:[['Slide',{by:260,dir:'auto'}],['MoveScale',{by:170,from:45,dir:'auto'}],['Spin',{angle:110}],['Grow',{from:20}]],
    text:[['TextSlide',{dist:90,dir:'up',split:'chars',offset:26}],['TextScale',{scale:0,split:'words',offset:80}]],
    emph:[['Pulse',{amount:12}],['Shake',{amount:12}]]},
  playful:{dur:.8,gap:.12,eases:['elastic','overshoot','bounceP'],
    bg:[['Fade']],
    hero:[['Bounce',{by:320}],['Spin',{angle:200}],['Twist',{angle:60,anchor:'bottom left'}]],
    shape:[['Bounce',{by:240}],['Spin',{angle:160}],['Grow',{from:0}],['Twist',{angle:80,anchor:'bottom right'}]],
    text:[['TextScale',{scale:0,split:'chars',order:'random',offset:45}],['TextSlide',{dist:60,dir:'up',split:'chars',order:'random',offset:40}]],
    emph:[['Wobble',{angle:8}],['Float',{by:18}],['Heartbeat',{amount:16}]]},
  cinematic:{dur:1.4,gap:.28,eases:['smooth','natural','slowDown'],
    bg:[['Shrink',{from:125}],['Blur',{amount:36}]],
    hero:[['Wipe',{dir:'auto',zoom:true}],['Shrink',{from:135}],['MaskCenter',{angle:0,zoom:true}]],
    shape:[['BlurSlide',{amount:26,by:70,dir:'auto'}],['Blur',{amount:30}],['Wipe',{dir:'auto'}]],
    text:[['TextBlur',{radius:16,split:'words',offset:130}],['TextMask',{split:'lines',offset:160}]],
    emph:[]},
  elegant:{dur:1.0,gap:.18,eases:['natural','slowDown'],
    bg:[['Fade']],
    hero:[['MaskCenter',{angle:0,zoom:true}],['Wipe',{dir:'up',zoom:true}]],
    shape:[['Slide',{by:44,dir:'up'}],['Wipe',{dir:'auto'}],['MaskResize',{anchor:'bottom'}]],
    text:[['TextMask',{split:'lines',offset:150}],['TextFade',{split:'words',offset:100}]],
    emph:[]},
  soft:{dur:1.05,gap:.15,eases:['smooth','natural'],
    bg:[['Fade']],
    hero:[['Grow',{from:88}],['BlurScale',{amount:18,from:92}]],
    shape:[['BlurSlide',{amount:14,by:32,dir:'auto'}],['Grow',{from:85}],['Fade']],
    text:[['TextFade',{split:'words',offset:95}],['TextBlur',{radius:8,split:'words',offset:110}]],
    emph:[['Float',{by:10}]]},
  creative:{dur:.85,gap:.12,eases:['smooth','natural','slowDown','elastic','overshoot','swing','impulse','bounceP'],
    bg:[['Fade'],['Dissolve'],['LumaReveal'],['Blur',{amount:30}]],
    hero:[['Glitch'],['PixelWipe',{dir:'auto'}],['CardFlip'],['Orbit'],['Twist',{angle:90}],['Bounce',{by:300}],['NoiseWipe',{dir:'auto'}],['MoveScale',{by:180,from:40,dir:'auto'}],['Spin',{angle:270}]],
    shape:[['Dissolve'],['Glitch'],['TrailT',{dist:240,dir:'auto'}],['BarrelT'],['FluidT'],['EchoT'],['Slide',{by:200,dir:'auto'}],['Grow',{from:0}],['Twist',{angle:120,anchor:'top right'}]],
    text:[['TextScale',{scale:0,split:'chars',order:'center',offset:40}],['TextSlide',{dist:70,dir:'up',split:'words',offset:90}],['TextBlurSlide',{radius:12,dist:40,dir:'up',split:'words',offset:100}],['TextMask',{split:'lines',offset:140}],['TextAppear',{split:'chars',offset:55}]],
    emph:[['Pulse',{amount:14}],['Wobble',{angle:9}],['Flash',{count:2}],['Heartbeat',{amount:20}]]}
};
// a free-form direction ("fast, bouncy, from the left") nudges the creative pool
function customSpec(txt){
  const q=String(txt||'').toLowerCase(),sp=JSON.parse(JSON.stringify(BSPEC.creative)),has=(...w)=>w.some(x=>q.includes(x));
  if(has('fast','quick','snappy','punch','energetic')){sp.dur=.5;sp.gap=.06}
  if(has('slow','long','dramatic','epic','calm','relax')){sp.dur=1.5;sp.gap=.26}
  if(has('together','simultaneous','all at once','same time'))sp.gap=0;
  if(has('stagger','one by one','sequence'))sp.gap=Math.max(sp.gap,.25);
  const dirs={'from left':'right','from the left':'right','from right':'left','from the right':'left','from top':'down','from the top':'down','from bottom':'up','from the bottom':'up'};
  let fixed=null;for(const k in dirs)if(q.includes(k))fixed=dirs[k];
  const D=fixed||'auto',fam=[];
  const add=(...r)=>fam.push(...r);
  if(has('glitch','digital','cyber'))add(['Glitch']);
  if(has('dissolve'))add(['Dissolve'],['NoiseDissolve']);
  if(has('pixel'))add(['PixelWipe',{dir:D}],['PixelReveal']);
  if(has('flip','card'))add(['CardFlip']);
  if(has('3d','orbit'))add(['Orbit']);
  if(has('bounce','spring','bouncy','playful')){add(['Bounce',{by:280}]);sp.eases=['bounceP','elastic','overshoot']}
  if(has('spin','rotate','twirl','twist'))add(['Spin',{angle:240}],['Twist',{angle:100}]);
  if(has('zoom','scale','grow','pop','punch'))add(['Grow',{from:20}],['Shrink',{from:150}]);
  if(has('blur','soft','dream'))add(['Blur',{amount:30}],['BlurSlide',{amount:22,by:60,dir:D}]);
  if(has('mask','reveal','wipe','curtain'))add(['Wipe',{dir:D,zoom:true}],['MaskCenter',{angle:0}]);
  if(has('slide','move','fly','swipe'))add(['Slide',{by:240,dir:D}]);
  if(has('fade','subtle','minimal','clean','simple'))add(['Fade'],['Slide',{by:36,dir:'up'}]);
  if(fam.length){sp.hero=fam;sp.shape=fam;sp.bg=has('fade','subtle','minimal','clean','simple')?[['Fade']]:sp.bg}
  if(has('typewriter','typing','type out'))sp.text=[['TextAppear',{split:'chars',offset:60}]];
  else if(has('word by word','per word','words'))sp.text=[['TextSlide',{dist:60,dir:'up',split:'words',offset:110}],['TextFade',{split:'words',offset:110}]];
  else if(has('letter','character','chars'))sp.text=[['TextScale',{scale:0,split:'chars',offset:40}],['TextSlide',{dist:60,dir:'up',split:'chars',offset:35}]];
  sp.label='Custom';return sp;
}
function mulberry32(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
const hashStr=s=>{let h=2166136261;for(let i=0;i<s.length;i++){h^=s.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0};
function frameHidden(f,l){for(let n=l;n;n=n.parent!=null?f.layers.find(x=>x.id===n.parent):null)if(n.hidden)return true;return false}
function autoDir(o,rng){
  const x=o.s.x,y=o.s.y;
  if(x<W*.3)return'right';if(x>W*.7)return'left';
  if(y<H*.4)return'down';if(y>H*.6)return'up';
  return rng()<.5?'up':'down';
}
// writes a complete intro into `frame` (its layers get fresh animations)
function generateVersion(frame,style,rng,customText,pace=1){
  const spec=style==='custom'?customSpec(customText):BSPEC[style];
  frame.layers.forEach(l=>{l.anims=[];if(l.type!=='group')rebuild(l)});
  const leaves=frame.layers.filter(l=>l.type!=='group'&&!frameHidden(frame,l));
  if(!leaves.length)throw new Error('There are no layers to animate in this frame.');
  const info=leaves.map(l=>{const s=state(l,0),b=boxSize(l,s),w=b.w*s.scale,h=b.h*s.scale;return{l,s,area:w*h,top:s.y-h/2,left:s.x-w/2}});
  const bgI=info.filter(o=>o.l.type!=='text'&&o.area>=W*H*.5).sort((a,b)=>b.area-a.area)[0]||null;
  const rest=info.filter(o=>o!==bgI);
  const heroI=rest.filter(o=>o.l.type!=='text').sort((a,b)=>b.area-a.area)[0]||null;
  const ordered=[...rest].sort((a,b)=>Math.round(a.top/90)-Math.round(b.top/90)||a.left-b.left);
  if(heroI){ordered.splice(ordered.indexOf(heroI),1);ordered.unshift(heroI)}
  const pick=arr=>arr[Math.floor(rng()*arr.length)];
  let end=0;
  const add=(o,recipe,start,isBg)=>{
    const p={...(recipe[1]||{})};if(p.dir==='auto')p.dir=autoDir(o,rng);
    const dur=+(spec.dur*pace*(.85+rng()*.3)*(isBg?.9:1)).toFixed(2);
    const a=mkAnim(recipe[0],'in',+start.toFixed(2),dur,p,pick(spec.eases));
    o.l.anims.push(a);end=Math.max(end,a.start+a.dur);
  };
  if(bgI)add(bgI,pick(spec.bg),0,true);
  ordered.forEach((o,i)=>add(o,pick(o.l.type==='text'?spec.text:o===heroI?spec.hero:spec.shape),.08+i*spec.gap*pace+rng()*.04,false));
  if(heroI&&spec.emph.length&&rng()<.9){const r=pick(spec.emph);heroI.l.anims.push(mkAnim(r[0],'emph',+(end+.15).toFixed(2),1,r[1]||{},'smooth'))}
  leaves.forEach(l=>rebuild(l));
  return frame;
}
function cloneFrameAfter(src,afterIndex,name){
  const f=JSON.parse(JSON.stringify(src));f.id=Date.now()+Math.floor(Math.random()*1e6);f.name=name;
  const idm=new Map();f.layers.forEach(l=>{const o=l.id;l.id=uid++;idm.set(o,l.id);if(imgs[o])imgs[l.id]=imgs[o];if(srcStore[o])srcStore[l.id]=srcStore[o]});
  f.layers.forEach(l=>{if(l.parent!=null)l.parent=idm.has(l.parent)?idm.get(l.parent):null;if(l.clipId!=null)l.clipId=idm.get(l.clipId)});
  project.frames.splice(afterIndex+1,0,f);return f;
}
function removeFrameById(id){
  const i=project.frames.findIndex(f=>f.id===id);if(i<0||project.frames.length<2)return;
  const keep=scene;project.frames.splice(i,1);
  if(project.frames.includes(keep))fi=project.frames.indexOf(keep);
  else{fi=Math.min(i,project.frames.length-1);scene=project.frames[fi];selectOnly(null);selKey=null;t=0}
  buildFrames();refresh();
}

// ---------- the brainstorm flow: setup → loading → completed → playing → played → scored ----------
let bs={status:'inactive'},bsSel=new Set(),bsCustom='',bsPace=1,bsModeOpen=false,bsRun=0,bsCancelled=false;
const BS_MODES=[[.75,'Snappy','Quick and light — fast, minimal motion for simple edits.'],[1,'Smart','Most capable and likely to get it right on first try.'],[1.4,'Dramatic','Slower and more expressive — bigger moves and longer timing.']];
const bsModeIdx=()=>Math.max(0,BS_MODES.findIndex(m=>m[0]===bsPace));
const bsWait=ms=>new Promise(r=>setTimeout(r,ms));
function bsSet(next){bs=next;renderBrainstorm()}
function bsOpen(){
  if(bs.status==='loading'||bs.status==='playing')return toast('A brainstorm is already running');
  bsSet({status:'setup',srcId:scene.id,name:scene.name});
}
const bsClose=()=>bsSet({status:'inactive'});
function bsCancel(){bsCancelled=true;if(bs.status==='setup'||bs.status==='failed'||bs.status==='completed'||bs.status==='played')bsClose()}
async function bsGo(){
  const styles=[...bsSel].filter(k=>k!=='custom');if(bsCustom.trim())styles.push('custom');
  if(!styles.length)return toast('Pick at least one style');
  const summary=styles.map(k=>k==='custom'?`“${bsCustom.trim()}”`:bsLabel(k)).join(', ');
  const src=project.frames.find(f=>f.id===bs.srcId)||scene;
  bsCancelled=false;
  const steps=['Reading your layers…','Picking a motion direction…','Choreographing the entrances…','Timing and easing…','Polishing the details…'];
  bsSet({status:'loading',srcId:src.id,name:src.name,summary,step:0,total:steps.length,title:steps[0]});toast('Brainstorm started');
  const created=[];
  try{
    for(let i=0;i<steps.length;i++){
      if(bsCancelled)throw 'cancel';
      bsSet({...bs,step:i,title:steps[i]});
      if(i===2){
        const base=project.frames.indexOf(src);
        styles.forEach((st,k)=>{
          const f=cloneFrameAfter(src,base+k,`${src.name} · ${bsLabel(st)}`);created.push({style:st,frame:f});
          generateVersion(f,st,mulberry32(hashStr(st+':'+(++bsRun)+':'+Date.now())),bsCustom,bsPace);
        });
        buildFrames();refresh();
      }
      await bsWait(360+Math.random()*300);
    }
    if(bsCancelled)throw 'cancel';
    bsSet({status:'completed',srcId:src.id,name:src.name,summary,versions:created.map(c=>({style:c.style,frameId:c.frame.id,label:c.frame.name}))});toast('Brainstorm completed');
  }catch(e){
    created.forEach(c=>{const i=project.frames.indexOf(c.frame);if(i>=0)project.frames.splice(i,1)});
    fi=Math.max(0,project.frames.indexOf(src));scene=project.frames[fi];buildFrames();refresh();
    if(e==='cancel'){bsSet({status:'inactive'});toast('Brainstorm cancelled')}
    else{bsSet({status:'failed',srcId:src.id,name:src.name,error:(e&&e.message)||'Unknown error'});toast('Brainstorm failed')}
  }
}
// plays every version in turn (or just one), refocusing the canvas on each frame
async function bsPlay(onlyId){
  const list=bs.versions.filter(v=>!onlyId||v.frameId===onlyId);
  if(!list.length)return;
  const keep={srcId:bs.srcId,name:bs.name,summary:bs.summary,versions:bs.versions},prevLoop=loop;loop=false;bsCancelled=false;
  bsSet({...keep,status:'playing',current:0,total:list.length,label:list[0].label,onlyId});
  for(let i=0;i<list.length&&!bsCancelled;i++){
    const idx=project.frames.findIndex(f=>f.id===list[i].frameId);if(idx<0)continue;
    bsSet({...keep,status:'playing',current:i,total:list.length,label:list[i].label,onlyId});
    switchFrame(idx);const c=canvases[fi];if(c&&c.scrollIntoView)c.scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'});
    await bsWait(450);t=0;if(!playing)togglePlay();
    while(playing&&!bsCancelled)await bsWait(80);
    if(playing)togglePlay();
    await bsWait(500);
  }
  loop=prevLoop;
  const si=project.frames.findIndex(f=>f.id===keep.srcId);if(si>=0)switchFrame(si);
  bsSet({...keep,status:bsCancelled||onlyId?'completed':'played'});
}
function bsScore(r){
  try{const a=JSON.parse(localStorage.getItem('ml_brainstorm')||'[]');a.push({rating:r,styles:(bs.versions||[]).map(v=>v.style),at:Date.now()});localStorage.setItem('ml_brainstorm',JSON.stringify(a.slice(-100)))}catch(e){}
  bsSet({...bs,status:'scored',rating:r});
  setTimeout(()=>{if(bs.status==='scored')bsClose()},1700);
}
function bsKeep(frameId){
  const keep=bs.versions.find(v=>v.frameId===frameId);
  bs.versions.forEach(v=>{if(v.frameId!==frameId)removeFrameById(v.frameId)});
  bsClose();toast(`Kept “${keep?keep.label:'version'}”, removed the others`);
}
function bsDiscard(){bs.versions.forEach(v=>removeFrameById(v.frameId));bsClose();toast('Brainstorm discarded')}
addEventListener('beforeunload',e=>{if(bs.status==='loading'){e.preventDefault();e.returnValue='A brainstorm is currently running. Are you sure you want to leave?'}});

function markBs(){document.querySelectorAll('#frames .fbs').forEach((e,i)=>e.classList.toggle('on',bs.status!=='inactive'&&!!project.frames[i]&&project.frames[i].id===bs.srcId))}
function renderBrainstorm(){
  markBs();
  const el=$('bs');
  if(bs.status==='inactive'){el.hidden=true;el.innerHTML='';return}
  el.hidden=false;
  const nm=esc(bs.name||scene.name);
  const av='<span class="bsx-av">'+ic('sparkles',12)+'</span>',ctx=`<div class="bsx-ctx"><span>${ic('square-play',16)}</span><b>${nm}</b></div>`;
  const msg=inner=>`<div class="bsx-msg">${av}<div class="bsx-bub">${inner}</div></div>`;
  const me=t=>`<div class="bsx-msg me"><div class="bsx-bub me">${esc(t)}</div></div>`;
  let h='';
  if(bs.status==='setup'){
    const opts=BS_STYLES.filter(x=>x[0]!=='custom'&&x[0]!=='creative').map(([k,l])=>`<button class="bsx-opt ${bsSel.has(k)?'on':''}" data-bss="${k}"><i class="bsx-cb">${bsSel.has(k)?ic('check',12):''}</i>${l}</button>`).join('');
    const ready=[...bsSel].some(k=>k!=='custom')||bsCustom.trim();
    h=`${msg("Let's animate your selection. Pick one or more motion tones below, or describe the mood, pace, and style you want. I'll create a separate version for each direction.")}
      ${ctx}
      <div class="bsx-card">
        <div class="bsx-ch"><b>Choose one or more</b><button id="bsclear" title="Clear">${ic('x',14)}</button></div>
        <div class="bsx-grid">${opts}</div>
        <div class="bsx-else"><span>${ic('pencil',14)}</span><input id="bscustom" placeholder="Something else…" value="${esc(bsCustom)}" autocomplete="off"></div>
        <div class="bsx-foot">
          <button class="bsx-modebtn" id="bspace" title="Mode">${ic('circle',14)}<span id="bsmodel">${BS_MODES[bsModeIdx()][1]}</span>${ic('chevron-down',12)}</button>
          <span style="flex:1"></span>
          <button class="bsx-go" id="bsgo" ${ready?'':'disabled'}>Continue</button>
          ${bsModeOpen?`<div class="bsx-mode"><div class="bsx-mh">Mode <b id="bsmoden">${BS_MODES[bsModeIdx()][1]}</b></div><p id="bsmodep">${BS_MODES[bsModeIdx()][2]}</p><input type="range" class="bsx-rng" id="bsrange" min="0" max="100" step="0.1" value="${bsModeIdx()*50}" style="--p:calc(12px + (100% - 24px) * ${bsModeIdx()/2})"></div>`:''}
        </div>
      </div>`;
  }else if(bs.status==='loading'){
    h=`${me(bs.summary||'')}${ctx}
      ${msg(`Brainstorming on <b>${nm}</b>…<div class="bsx-s">${esc(bs.title||'')}</div><div class="bsx-bar"><i style="width:${Math.round(((bs.step||0)+1)/(bs.total||5)*100)}%"></i></div>`)}
      <div class="bsx-actions"><button class="bsx-btn" id="bscancel" title="Cancel the current brainstorm">Cancel the current brainstorm</button></div>`;
  }else if(bs.status==='completed'){
    h=`${me(bs.summary||'')}
      ${msg(`<b>Your brainstorm is ready!</b><div class="bsx-s">${bs.versions.length} version${bs.versions.length>1?'s':''} added next to ${nm}.</div>`)}
      <div class="bsx-card"><div class="bsx-list">${bs.versions.map(v=>`<div class="bsx-ver"><span>${esc(v.label)}</span><button data-bsp="${v.frameId}" title="Play this version">${ic('play',12,1)}</button><button data-bsk="${v.frameId}" title="Keep this one and remove the others">Keep</button></div>`).join('')}</div></div>
      <div class="bsx-actions"><button class="bsx-btn" id="bsdiscard">Discard all</button><button class="bsx-btn" id="bsclose">Close</button><button class="bsx-btn go" id="bsplay">Play all</button></div>`;
  }else if(bs.status==='playing'){
    h=`${me(bs.summary||'')}
      ${msg(`<b>Playing your brainstorm</b><div class="bsx-s">${esc(bs.label||'')}</div><div class="bsx-dots">${Array.from({length:bs.total},(_,i)=>`<i class="${i<=bs.current?'on':''}"></i>`).join('')}</div>`)}
      <div class="bsx-actions"><button class="bsx-btn" id="bsstop">Stop</button></div>`;
  }else if(bs.status==='played'){
    h=`${me(bs.summary||'')}
      ${msg(`<b>Feeling inspired?</b><div class="bsx-s">Tell us how these turned out.</div>`)}
      <div class="bsx-rate"><button data-bsr="up" title="Loved them">${ic('thumbs-up',26)}</button><button data-bsr="down" title="Not quite">${ic('thumbs-down',26)}</button></div>
      <div class="bsx-actions"><button class="bsx-btn" id="bsdiscard">Discard all</button><button class="bsx-btn" id="bsclose">Keep them all</button></div>`;
  }else if(bs.status==='scored'){
    h=msg(`<b>Thank you!</b><div class="bsx-s">Your versions are in the frame list — pick the one you like.</div>`);
  }else if(bs.status==='failed'){
    h=`${ctx}${msg(`<b>Something went wrong…</b><div class="bsx-s">${esc(bs.error||'')}</div>`)}
      <div class="bsx-actions"><button class="bsx-btn" id="bsclose">Close</button><button class="bsx-btn go" id="bsagain">Try again</button></div>`;
  }
  el.innerHTML=`<div class="bsx-panel"><div class="bsx-head"><button id="bsback" title="Back">${ic('chevron-left',16)}</button><span>New chat</span><button id="bsx" title="Close">${ic('x',16)}</button></div><div class="bsx-body">${h}</div></div>`;
  const on=(id,fn)=>{const b=$(id);if(b)b.onclick=fn};
  const shut=()=>{if(bs.status==='loading'||bs.status==='playing')bsCancelled=true;else bsClose()};
  on('bsback',shut);on('bsx',shut);
  el.querySelectorAll('[data-bss]').forEach(b=>b.onclick=()=>{const k=b.dataset.bss;bsSel.has(k)?bsSel.delete(k):bsSel.add(k);renderBrainstorm()});
  const ci=$('bscustom');if(ci){ci.oninput=()=>{bsCustom=ci.value;const g=$('bsgo');if(g)g.disabled=!([...bsSel].some(k=>k!=='custom')||bsCustom.trim())};ci.onkeydown=e=>{e.stopPropagation();if(e.key==='Enter'&&!$('bsgo').disabled)bsGo()}}
  on('bsclear',()=>{bsSel=new Set();bsCustom='';renderBrainstorm()});
  on('bspace',()=>{bsModeOpen=!bsModeOpen;renderBrainstorm()});
  const rg=$('bsrange');if(rg){
    const fill=v=>rg.style.setProperty('--p',`calc(12px + (100% - 24px) * ${v/100})`);
    const label=i=>{const m=BS_MODES[i];bsPace=m[0];$('bsmoden').textContent=m[1];$('bsmodep').textContent=m[2];$('bsmodel').textContent=m[1]};
    let raf=0;
    rg.oninput=()=>{cancelAnimationFrame(raf);const v=+rg.value;fill(v);label(Math.round(v/50))};
    // on release the thumb glides to the nearest mode instead of jumping
    rg.onchange=()=>{const from=+rg.value,to=Math.round(from/50)*50,t0=performance.now();cancelAnimationFrame(raf);
      const step=now=>{const k=Math.min(1,(now-t0)/180),e=1-Math.pow(1-k,3),v=from+(to-from)*e;rg.value=v;fill(v);if(k<1)raf=requestAnimationFrame(step)};raf=requestAnimationFrame(step)};
  }
  on('bscancel',bsCancel);on('bsgo',bsGo);on('bsclose',bsClose);on('bsplay',()=>bsPlay());on('bsstop',()=>{bsCancelled=true});
  on('bsdiscard',bsDiscard);on('bsagain',()=>bsSet({status:'setup',srcId:bs.srcId,name:bs.name}));
  el.querySelectorAll('[data-bsp]').forEach(b=>b.onclick=()=>bsPlay(+b.dataset.bsp));
  el.querySelectorAll('[data-bsk]').forEach(b=>b.onclick=()=>bsKeep(+b.dataset.bsk));
  el.querySelectorAll('[data-bsr]').forEach(b=>b.onclick=()=>bsScore(b.dataset.bsr));
  const body=el.querySelector('.bsx-body');if(body)body.scrollTop=body.scrollHeight;
}

const inApp=()=>{try{return window.parent!==window&&!!window.parent.location.origin}catch(e){return false}};
const goApp=path=>{try{window.parent.location.assign(path)}catch(e){}};
setupZoom();demo();$('tavt').textContent=cmInitials(cmMe());buildToolbar();toolbarReady=true;syncToolbar();
// a template (or file) handed over by the React shell
try{const j=sessionStorage.getItem('figtion:load');if(j){sessionStorage.removeItem('figtion:load');loadProject(JSON.parse(j))}}catch(e){}
</script>
</body>
</html>
