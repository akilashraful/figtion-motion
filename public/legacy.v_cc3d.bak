const fontInstalled=name=>{
  const c=document.createElement('canvas').getContext('2d'),t='mmmmmmmmmmlliWQ@#';
  return['monospace','serif','sans-serif'].some(b=>{c.font=`72px ${b}`;const w0=c.measureText(t).width;c.font=`72px "${name}",${b}`;return c.measureText(t).width!==w0});
};
const webFonts=new Set(),fontJobs=new Map();
// fonts that are not installed here are fetched from Google Fonts, pinned to the exact weight and axes Figma used, so text keeps its real look and width
async function ensureWebFonts(layers){
  const missing=new Set(),groups=new Map();
  layers.forEach(l=>{
    if(l.type!=='text')return;
    const fam=fontName(l.font),vr=l.fvar||[],wv=vr.find(v=>v.tag==='wght'||v.name==='Weight');
    if(wv)l.weight=Math.round(wv.value);
    if(FONTS.some(f=>f[0]===fam)||(localFonts||[]).some(f=>f.family===fam)||fontInstalled(fam)){delete l.fvar;return}
    const ax=vr.filter(v=>!(v.tag==='wght'||v.name==='Weight')&&v.tag&&v.tag.length===4).sort((a,b)=>(a.tag===a.tag.toLowerCase()?0:1)-(b.tag===b.tag.toLowerCase()?0:1)||a.tag.localeCompare(b.tag));
    const key=[fam,l.italic?1:0,l.weight||400,ax.map(a=>a.tag+a.value).join(',')].join('|');
    (groups.get(key)||groups.set(key,{fam,ax,italic:!!l.italic,weight:l.weight||400,layers:[]}).get(key)).layers.push(l);
  });
  await Promise.all([...groups].map(([key,g])=>{
    if(!fontJobs.has(key))fontJobs.set(key,loadGoogleFont(g));
    return fontJobs.get(key).then(alias=>{
      g.layers.forEach(l=>{
        if(alias===false)missing.add(g.fam);
        else{if(alias!==g.fam)l.font=`"${alias}", ${guessGeneric(g.fam)}`;l.weight=g.weight}
        delete l.fvar;
      });
    });
  }));
  layers.forEach(l=>{if(l.type==='text')refitText(l)});
  drawAll();commitSoon();
  if(missing.size)toast(`Font not found: ${[...missing].slice(0,3).join(', ')} — using a similar one. Install it or add the file from the font picker.`);
}
async function loadGoogleFont({fam,ax,italic,weight}){
  const enc=encodeURIComponent(fam).replace(/%20/g,'+');
  const url=(axes)=>{
    const names=[...(italic?['ital']:[]),'wght',...axes.map(a=>a.tag)],vals=[...(italic?[1]:[]),weight,...axes.map(a=>a.value)];
    return `https://fonts.googleapis.com/css2?family=${enc}:${names.join(',')}@${vals.join(',')}&display=swap`;
  };
  for(const axes of ax.length?[ax,[]]:[[]]){
    try{
      const r=await fetch(url(axes));if(!r.ok)continue;
      let css=await r.text();
      const alias=axes.length?`${fam} (${axes.map(a=>a.tag+' '+a.value).join(', ')})`:fam;
      if(alias!==fam)css=css.replace(/font-family:\s*['"][^'"]+['"]/g,`font-family: '${alias}'`);
      const st=document.createElement('style');st.textContent=css;document.head.appendChild(st);
      await Promise.race([document.fonts.load(`${italic?'italic ':''}${weight} 16px "${alias}"`),new Promise(res=>setTimeout(res,8000))]);
      webFonts.add(alias);return alias;
    }catch(e){}
  }
  return false;
}
function placeLayers(layers,b,{fitWhole,noScale}={}){
  if(!layers.length)return[];
  const S=noScale?1:fitWhole?Math.min(W/b.w,H/b.h,fitWhole===true?1:fitWhole):Math.min(1,W/b.w,H/b.h);
  const dx=W/2-(b.x+b.w/2)*S,dy=H/2-(b.y+b.h/2)*S,roots=[];
