  while(i<u.length){const c=u[i++];
    if(c===0)d+='Z';else if(c===1)d+=`M${f()} ${f()}`;else if(c===2)d+=`L${f()} ${f()}`;else if(c===3)d+=`C${f()} ${f()} ${f()} ${f()} ${f()} ${f()}`;else if(c===4)d+=`Q${f()} ${f()} ${f()} ${f()}`;else break}
  return d;
}
// a vector network blob (vertices, bezier segments, fill regions) -> svg path data
